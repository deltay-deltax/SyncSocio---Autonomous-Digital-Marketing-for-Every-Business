            "mimeType": "application/json",
            "text": "[{\"result\":{\"data\":{\"id\":\"2792c764-a258-4356-b9f3-e314fad07819\",\"title\":\"Elena, The Mindful Host\",\"payload\":{\"cohort_id\":\"AUD_03_SOBER_CURIOUS_SOCIALITE\",\"cohort_name\":\"The Clean-Label Social Drinker\",\"persona_tagged_name\":\"Elena, The Mindful Host\",\"demographic_anchor\":\"22-38, city dweller, values socializing, fitness, clean ingredients, often sober-curious or limiting alcohol\",\"core_motivation\":\"I want a sophisticated, delicious, fizzy drink to hold and sip at parties or while winding down at night that isn't loaded with alcohol or simple syrup.\",\"use_case\":\"Pouring a chilled grape prebiotic soda into a wine glass with a splash of lime as an evening wind-down ritual or party mocktail.\",\"triggering_event\":\"Attending a social gathering or hosting friends and realizing the only non-alcoholic options are boring flat tap water or ultra-sugary kid juices.\",\"jobs_to_be_done\":{\"functional\":\"Provide a complex, sweet-tart sparkling drink that acts as a premium, low-sugar alternative to alcohol or heavy mocktails.\",\"emotional\":\"Feel relaxed, included, and celebratory during social hours without compromising physical health or morning clarity.\",\"social_identity\":\"A trendy, health-conscious tastemaker who curates clean, beautiful experiences for themselves and their friends.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Product Aware\",\"awareness_description\":\"They know OLIPOP but haven't thought of the Classic Grape flavor as a premium, tart, sophisticated mocktail base.\",\"market_sophistication\":\"Level 3\",\"sophistication_description\":\"They've bought sparkling waters and standard mocktail cans but find them either completely unsweetened or ridiculously high in calories.\",\"required_unique_mechanism\":\"A rich, complex profile from real concord grape, quince, and lime juice concentrates combined with functional gut benefits, elevating it beyond empty-calorie mixers.\"},\"resistance_and_friction\":{\"internal_objection\":\"Grape flavor feels a bit childish; is this actually going to feel elegant or just taste like a kid's juice box?\",\"external_objection\":\"Can a gut-health soda really replace the complex botanical experience of a high-end non-alcoholic spirit?\",\"partner_objection\":\"Why are we stocking the bar with prebiotic sodas instead of standard mixers everyone knows?\",\"switching_cost\":\"Ditching standard alcoholic or high-sugar sodas/mixers for a healthier, functional alternative at social gatherings.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"concord grape\",\"mocktail\",\"kissed with lime\",\"sophisticated fizz\",\"evening ritual\",\"clean swap\"],\"taboo_words\":[\"health supplement\",\"medicinal\",\"kids drink\",\"diet pop\",\"detox\"]},\"audience_size\":{\"reach_tier\":\"focused\",\"audience_share\":25,\"sizing_rationale\":\"The sober-curious and mindful drinking movement is massive among young urban professionals seeking stylish, low-sugar alternatives.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-17T07:51:20.778Z\",\"updatedAt\":\"2026-08-17T07:51:49.713Z\"}}}]"
          },
