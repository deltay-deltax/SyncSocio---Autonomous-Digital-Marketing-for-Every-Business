ev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044959-75d02dc6-ee4a-4327-9a07-2a07af4ac4f7.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044988-c90d0c25-e013-4033-b7c5-c3edffdaa39e.png\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044871-a5a86616-92ae-4852-bad3-177faba13db5.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044884-4c2f0ce1-057a-4724-915f-95d54302022d.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044976-bb2130ff-2b33-41e7-b49f-b09615e45f61.png\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953045062-bbfc62a4-c529-4fd2-b8ad-f2c0fe483477.jpg\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953045003-56a3e828-5361-4af0-8f80-68bc471a5168.png\"],\"sugars\":\"5g\",\"calories\":50,\"fiberLine\":\"9g Fiber Line\",\"description\":\"Sweet-tart concord grape juice, kissed with lime. Our original refrigerated formula, with higher fiber per can to get more out of every sip.\",\"hasNSFWRisk\":false,\"ingredients\":[\"Carbonated Water\",\"OLISMART (Cassava Root Fiber, Chicory Root Inulin, Jerusalem Artichoke Inulin, Nopal Cactus, Marshmallow Root, Calendula Flower, Kudzu Root)\",\"Concord Grape Juice Concentrate\",\"Cassava Root Syrup\",\"Apple Juice Concentrate\",\"Tartaric Acid (From Grapes)\",\"Quince Juice Concentrate\",\"Lime Juice Concentrate\",\"Stevia Leaf\",\"Himalayan Pink Salt\",\"Natural Flavors\"],\"taxonomyTag\":\"product:beverage:soda\",\"juiceContent\":\"10% Juice\",\"dietaryClaims\":[\"Less Sugar\",\"Digestive Health Support\",\"Vegan\",\"Gluten Free\",\"Non-GMO\"],\"variantSummary\":{\"count\":2,\"attributes\":{\"packSize\":[\"12 Pack\"],\"purchaseType\":[\"One-Time\",\"Subscription\"]}},\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Upgrade / Optimization\",\"reason\":\"OLIPOP acts as a functional, better-for-you upgrade to traditional high-sugar soda, letting consumers enjoy a nostalgic grape flavor with significantly optimized health benefits like 9g of prebiotic fiber and only 5g of sugar.\"},\"secondaryArchetypes\":[{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily beverage choice, this product is designed to easily slot into a consumer's recurring grocery routine or subscription model to replace unhealthy daily soda habits.\"},{\"name\":\"Problem Solver\",\"reason\":\"It addresses the specific issue of low dietary fiber and digestive discomfort while also solving the consumer craving for a sweet, fizzy drink without a subsequent sugar crash.\"},{\"name\":\"Values / Belief\",\"reason\":\"The product appeals to health-conscious buyers who actively prioritize gut health, clean ingredients, and dietary choices such as vegan, gluten-free, and non-GMO lifestyles.\"}]},\"storageInstructions\":\"Keep refrigerated\",\"nutritionalHighlights\":10},\"normalizedSummary\":{\"summary\":\"A nostalgic grape soda made with real concord grape juice and a hint of lime, featuring 9g of prebiotic fiber to support digestive health.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-17T07:50:17.983Z\",\"updatedAt\":\"2026-08-17T07:51:40.459Z\",\"variantCount\":2,\"creativeCount\":0,\"generatedCreativeCount\":0,\"hasGeneratedCreatives\":false},{\"id\":\"ddfde795-8c45-44bd-8f63-1853a51a88a1\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Glow Korean Marine Collagen Peptides\",\"slug\":\"untitled-product-11\",\"sourceUrl\":\"https://wellbeingnutrition.com/products/glow-collagen-valencia-orange-flavour?variant=41372595257424\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0kiva4aj1jnggv9ugqs0i01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0kj7mjgp99ja95m0nkn0101\",\"visualDescriptionImageFingerprint\":\"18nb9jj\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"form\":\"Powder\",\"brand\":\"Wellbeing Nutrition\",\"flavor\":\"Valencia Orange\",\"images\":[\"https://localads.t3.storage.dev/product-images/ddfde795-8c45-44bd-8f63-1853a51a88a1/1786879180666-be4d5f6f-0b1d-4b27-a853-2e5dcc2b3b9e.jpg\",\"https://localads.t3.storage.dev/product-images/ddfde795-8c45-44bd-8f63-1853a51a88a1/1786879180555-192efbe6-d2aa-4f1a-8c3e-f58af1c640e8.png\",\"https://localads.t3.storage.dev/product-images/ddfde795-8c45-44bd-8f63-1853a51a88a1/1786879180680-826f806c-3e3a-4d7c-a2f1-0b71b4e1f33c.jpg\",\"https://localads.t3.storage.dev/product-images/ddfde795-8c45-44bd-8f63-1853a51a88a1/1786879180532-03e95cfb-6435-4874-8436-e42986e19410.jpg\",\"https://localads.t3.storage.dev/product-images/ddfde795-8c45-44bd-8f63-1853a51a88a1/1786879180694-baf59b50-d684-4da8-84f1-076da6918a5f.jpg\"],\"weight\":\"250g\",\"benefits\":[\"Supports collagen production\",\"Helps promote even skin tone\",\"Helps reduce fine lines & wrinkles\",\"Helps improve skin radiance\",\"Helps reduce dark spots\",\"Helps repair skin barrier\"],\"shelfLife\":\"24 Months\",\"hasNSFWRisk\":false,\"taxonomyTag\":\"product:wellness:collagen\",\"allergenInfo\":\"Non-Veg (sourced from deep-sea fish/salmon)\",\"certifications\":[\"Mercury Free\",\"Heavy Metal Tested\",\"Non-GMO\",\"No Artificial Colour or Flavour\",\"Clinically Validated\",\"Dermatologist Recommended\"],\"keyIngredients\":[\"Hydrolyzed Marine Collagen Peptide\",\"Liposomal L-Glutathione\",\"Vitamin C (L-Ascorbic Acid)\",\"Resveratrol\",\"DigeZyme (Alpha Amylase, Protease, Lipase, Cellulase, Lactase)\",\"Goji Berry Fruit Extract\"],\"variantSummary\":{\"count\":4,\"attributes\":{\"form\":[\"Powder\"],\"brand\":[\"Wellbeing Nutrition\"],\"flavor\":[\"Valencia Orange\"],\"weight\":[\"250g\"],\"shelfLife\":[\"24 Months\"],\"variantKey\":[\"Pack of 1\",\"Pack of 2\",\"Pack of 3\",\"Pack of 4\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:wellness:collagen\"],\"allergenInfo\":[\"Non-Veg (sourced from deep-sea fish/salmon)\"],\"variantLabel\":[\"Pack of 1\",\"Pack of 2\",\"Pack of 3\",\"Pack of 4\"],\"countryOfOrigin\":[\"India\"],\"usageDirections\":[\"Mix one level scoop (10g) in a 250ml glass of water, smoothie, juice, or breakfast bowl. Consume once daily for 12 weeks for best results.\"]}},\"countryOfOrigin\":\"India\",\"usageDirections\":\"Mix one level scoop (10g) in a 250ml glass of water, smoothie, juice, or breakfast bowl. Consume once daily for 12 weeks for best results.\",\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Desire / Identity\",\"reason\":\"The product primarily appeals to the customer's desire to achieve radiant, glowing skin and maintain a youthful, vibrant appearance associated with premium beauty standards.\"},\"secondaryArchetypes\":[{\"name\":\"Problem Solver\",\"reason\":\"It targets specific skincare pain points like fine lines, wrinkles, dark spots, uneven skin tone, and a damaged skin barrier.\"},{\"name\":\"Routine / Replenishment\",\"reason\":\"Designed for a daily ritual to be consumed once daily for at least 12 weeks, making it a perfect fit for a recurring wellness habit and multi-pack stocking.\"},{\"name\":\"Upgrade / Optimization\",\"reason\":\"It appeals to existing collagen users seeking a superior, premium formula enhanced with advanced ingredients like Liposomal Glutathione and clinical validation.\"}]},\"visual_description\":\"This product is a dietary supplement packaged in a wide, cylindrical, matte white opaque plastic jar with a matching flat-topped, screw-on white cap featuring rounded upper edges. The jar features a wrap-around label with a smooth vertical color gradient transitioning from clean white at the top to a rich golden-yellow and warm orange at the bottom. Centered near the top is the \\\"Wellbeing Nutrition\\\" logo, consisting of a black stylized letter \\\"W\\\" with a tiny green leaf accent on its right peak, framed by arched black sans-serif text reading \\\"WELLBEING\\\" above and \\\"NUTRITION\\\" below. The central visual element is a large rectangular box with a golden-yellow background (which is a metallic bronze-gold on an alternate \\\"Piña Colada\\\" version) containing the lowercase, white serif typography \\\"glow collagen\\\" above the black Korean characters \\\"글로우 콜라겐\\\". Below this, descriptive black text lists \\\"Korean Marine Collagen Peptides with Liposomal Glutathione, Vitamin C, Resveratrol and DigeZyme®\\\" (the Piña Colada version instead lists \\\"SkinAx2™, Glutathione\\\"), accented by a bolded \\\"Type I & III\\\" label and a distinct white horizontal banner displaying \\\"Valencia Orange Flavour\\\" (or \\\"Piña Colada Flavor\\\" on the older variant). To the right of this central box sits a circular gold emblem displaying a white, multi-faceted geometric sphere grid, bordered on the right by the curved black text \\\"Wild Caught • Mercury Free\\\", positioned below a small gold \\\"Clinically Approved\\\" cross badge and adjacent to bold black text reading \\\"8g Collagen per serving\\\". The bottom margin of the label features five simple black line-art icons representing \\\"Brightening\\\", \\\"Hydration\\\", \\\"Elasticity\\\", \\\"Anti-ageing\\\", and \\\"Protection\\\", flanked by weight specifications of \\\"Net Wt.: 250 g\\\" on the left and classification text on the right. When the fine, light-colored inner powder is mixed with water, it dissolves into a translucent, vibrant golden-orange liquid.\"},\"normalizedSummary\":{\"summary\":\"A premium marine collagen powder formulated with Liposomal Glutathione and Vitamin C in Valencia Orange flavor to boost skin radiance, hydration, and elasticity.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-16T11:19:01.534Z\",\"updatedAt\":\"2026-08-16T11:20:27.972Z\",\"variantCount\":4,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true},{\"id\":\"fa4f28c5-dd6a-4c25-be14-c3a0589d3718\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Wellbeing Nutrition Liposomal Iron Complex\",\"slug\":\"untitled-product-10\",\"sourceUrl\":\"https://wellbeingnutrition.com/products/liposomal-iron-complex-pack-of-60-capsules?variant=42680855920720\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0kfcq89e6ujgnl1t8j2kg01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0kfpa8vq1vb6o7p329jrn01\",\"visualDescriptionImageFingerprint\":\"zjhlf7\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"Wellbeing Nutrition\",\"images\":[\"https://localads.t3.storage.dev/product-images/fa4f28c5-dd6a-4c25-be14-c3a0589d3718/1786878248627-a50155d2-9f64-4ee2-bd51-a0d8ce4ac638.jpg\"],\"benefits\":[\"Supports formation of red blood cells\",\"Helps enhance energy levels and reduces fatigue\",\"Helps replenish iron reserves\",\"Supports immune function\",\"Aids better focus and mental clarity\",\"Helps improve hair, skin, and nail health\"],\"cofactors\":[\"Vitamin C (as Sodium Ascorbate)\",\"Bioactive Folate (as Quatrefolic®)\",\"Activated Vitamin B6 (as Pyridoxal-5-Phosphate)\",\"Vitamin B5 (as Calcium D Pantothenate)\",\"Methylated Vitamin B12 (as Methylcobalamin)\",\"Zinc (as Zinc Bisglycinate)\"],\"shelfLife\":\"18 Months\",\"hasNSFWRisk\":false,\"ironSources\":[\"Ferrous Bisglycinate\",\"Ferrous Fumarate\"],\"taxonomyTag\":\"product:supplements:iron\",\"elementalIron\":\"29 mg (100% RDA)\",\"variantSummary\":{\"count\":2,\"attributes\":{\"brand\":[\"Wellbeing Nutrition\"],\"shelfLife\":[\"18 Months\"],\"variantKey\":[\"Pack of 1\",\"Pack of 2\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:supplements:iron\"],\"variantLabel\":[\"Pack of 1\",\"Pack of 2\"],\"elementalIron\":[\"29 mg (100% RDA)\"],\"capsulesPerPack\":[\"60\"],\"usageInstructions\":[\"Consume 1 capsule daily before any meal, preferably in the morning. Separate from calcium and magnesium supplements by 2-3 hours.\"],\"formulationQuality\":[\"Non-GMO, oxide-free, filler-free, and free from added sugar, preservatives, and artificial colors or flavors\"],\"absorptionTechnology\":[\"Advanced Liposomal Technology (1.6x higher bioavailability)\"]}},\"capsulesPerPack\":60,\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Problem Solver\",\"reason\":\"Customers primarily buy this product to resolve clear physical symptoms associated with iron deficiency, such as constant fatigue, low energy levels, and poor concentration.\"},\"secondaryArchetypes\":[{\"name\":\"Upgrade / Optimization\",\"reason\":\"The product features advanced liposomal technology for 1.6x higher absorption, appealing to existing iron supplement users who want a higher-quality formulation that avoids typical digestive discomfort.\"},{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily supplement packaged in 60-capsule quantities, it is designed to become a consistent part of the customer's morning routine requiring recurring replenishment.\"}]},\"usageInstructions\":\"Consume 1 capsule daily before any meal, preferably in the morning. Separate from calcium and magnesium supplements by 2-3 hours.\",\"formulationQuality\":\"Non-GMO, oxide-free, filler-free, and free from added sugar, preservatives, and artificial colors or flavors\",\"visual_description\":\"The product consists of a tall, matte-finished cylindrical canister and an accompanying dietary supplement capsule. The canister features a two-tone color-blocked design, with the top third in a vibrant coral-red and the bottom two-thirds in a deep burgundy-maroon. At the top of the coral-red section is a white circular logo reading \\\"WELLBEING NUTRITION\\\" wrapped around a stylized central \\\"W\\\", with a small green-and-white vegetarian symbol to its right. Spanning the color transition is the word \\\"slow\\\" in a large, lowercase, white sans-serif typeface, situated above the stacked white capital text \\\"LIPOSOMAL\\\" and \\\"IRON COMPLEX\\\". Below the text, the maroon section displays an angled graphic of a clear capsule filled with pink micro-pellets, decorated with a small circular \\\"2 SALTS\\\" badge, followed by explanatory white text detailing the ingredients and health benefits. Near the bottom, a physical horizontal seam defines the canister's base, which features two white icons for \\\"SUSTAINED RELEASE\\\" and \\\"2in1 NUTRI-SCIENCE\\\", the quantity \\\"60 N CAPSULES\\\" inside a pill-shaped border, and \\\"HEALTH SUPPLEMENT FOR ADULTS\\\" at the bottom edge. Beside the canister stands a physical, three-dimensional capsule with a completely transparent, glossy outer shell, revealing an interior packed tightly with hundreds of uniform, tiny, spherical micro-pellets in a soft, dusty-pink hue.\",\"absorptionTechnology\":\"Advanced Liposomal Technology (1.6x higher bioavailability)\"},\"normalizedSummary\":{\"summary\":\"An advanced liposomal iron supplement containing 29 mg of Elemental Iron and five synergistic cofactors to support energy, immunity, and red blood cell formation.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-16T11:03:23.895Z\",\"updatedAt\":\"2026-08-16T11:05:23.187Z\",\"variantCount\":2,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true},{\"id\":\"e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Himalayan Sea Buckthorn Juice with Curcumin Extract\",\"slug\":\"untitled-pr