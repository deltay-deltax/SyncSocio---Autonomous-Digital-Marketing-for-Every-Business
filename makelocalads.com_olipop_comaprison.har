",\"Amino acids\"],\"shelfLife\":\"12 Months\",\"hasNSFWRisk\":false,\"taxonomyTag\":\"product:supplement:juice\",\"keyIngredients\":[\"Sea Buckthorn (Hippophae rhamnoides) Pulp\",\"Curcumin Extract (Curcuma longa)\"],\"variantSummary\":{\"count\":1,\"attributes\":{}},\"fullIngredients\":[\"Sea Buckthorn Pulp\",\"Curcumin Extract\",\"Potassium Sorbate\",\"Sodium Benzoate\",\"Demineralized water\"],\"storageInstructions\":\"Store in a cool, dry, and dark place. Once opened, refrigerate and consume within 60 days.\"},\"normalizedSummary\":{\"summary\":\"A 99% pure cold-pressed, unfiltered liquid pulp concentrate wild-harvested from the Himalayas to support daily energy, immunity, skin health, and digestive wellness.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-16T11:01:01.020Z\",\"updatedAt\":\"2026-08-16T11:02:05.807Z\",\"variantCount\":1,\"creativeCount\":0,\"generatedCreativeCount\":0,\"hasGeneratedCreatives\":false},{\"id\":\"627c6737-700d-4a82-9631-44ba1269f85b\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Wellbeing Nutrition 4x Strength Omega 3 Fish Oil\",\"slug\":\"untitled-product-8\",\"sourceUrl\":\"https://wellbeingnutrition.com/products/high-strength-omega-3-fish-oil?variant=41127872069712\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0k4utm5rfi9781cnhsojl01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0k56b97le86acpe633hl801\",\"visualDescriptionImageFingerprint\":\"1y6mys6\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"Wellbeing Nutrition\",\"images\":[\"https://localads.t3.storage.dev/product-images/627c6737-700d-4a82-9631-44ba1269f85b/1786875513424-05e46a2b-396c-457f-b015-3659043b1d39.jpg\",\"https://localads.t3.storage.dev/product-images/627c6737-700d-4a82-9631-44ba1269f85b/1786875513366-e2a1f970-6524-432f-9851-1ffdebe28e34.jpg\",\"https://localads.t3.storage.dev/product-images/627c6737-700d-4a82-9631-44ba1269f85b/1786875513503-66f57f00-0d50-44c8-a08c-dac1f33783af.jpg\",\"https://localads.t3.storage.dev/product-images/627c6737-700d-4a82-9631-44ba1269f85b/1786875513530-57e7423b-9f6d-4999-896f-e474aaa43fda.jpg\",\"https://localads.t3.storage.dev/product-images/627c6737-700d-4a82-9631-44ba1269f85b/1786875513537-6cebe75d-4b68-4e6e-bcb6-bd832b0c1cea.jpg\",\"https://localads.t3.storage.dev/product-images/627c6737-700d-4a82-9631-44ba1269f85b/1786875513464-352d96ad-527e-4f2a-9463-fbe7c46ee71c.jpg\",\"https://localads.t3.storage.dev/product-images/627c6737-700d-4a82-9631-44ba1269f85b/1786875513561-036c6d36-6a6e-4e6b-89a2-7f9dadfd31cc.png\"],\"potency\":\"1850mg Fish Oil per serving\",\"netWeight\":\"92.7g\",\"shelfLife\":\"18 months\",\"epaDhaRatio\":\"763mg EPA & 508mg DHA\",\"flavorNotes\":\"Lemon & mint essence (no fishy burps or aftertaste)\",\"hasNSFWRisk\":false,\"keyBenefits\":[\"Supports cardiovascular health and healthy cholesterol levels\",\"Enhances brain function, focus, and memory\",\"Reduces inflammation, joint pain, and stiffness\",\"Improves skin hydration and elasticity\",\"Aids digestion and reduces bloating via peppermint oil\"],\"taxonomyTag\":\"product:supplement:omega-3\",\"officialName\":\"Slow High Strength Omega 3 Fish Oil 4X\",\"variantSummary\":{\"count\":2,\"attributes\":{\"brand\":[\"Wellbeing Nutrition\"],\"potency\":[\"1850mg Fish Oil per serving\"],\"netWeight\":[\"92.7g\"],\"shelfLife\":[\"18 months\"],\"variantKey\":[\"Pack of 1\",\"Pack of 2\"],\"epaDhaRatio\":[\"763mg EPA & 508mg DHA\"],\"flavorNotes\":[\"Lemon & mint essence (no fishy burps or aftertaste)\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:supplement:omega-3\"],\"officialName\":[\"Slow High Strength Omega 3 Fish Oil 4X\"],\"variantLabel\":[\"Pack of 1\",\"Pack of 2\"],\"capsulesPerPack\":[\"60\"],\"countryOfOrigin\":[\"India\"],\"formulationType\":[\"Natural Triglyceride (74% pure omega-3, 1.7x more bioavailable than ethyl ester form)\"],\"usageDirections\":[\"Take two softgels daily after any meal, or as suggested by a healthcare professional. For best results, consume daily for 4-8 weeks.\"],\"capsuleShellType\":[\"Premium bovine gelatin\"],\"fssaiLicenseNumber\":[\"10019022009134\"]}},\"capsulesPerPack\":60,\"countryOfOrigin\":\"India\",\"formulationType\":\"Natural Triglyceride (74% pure omega-3, 1.7x more bioavailable than ethyl ester form)\",\"usageDirections\":\"Take two softgels daily after any meal, or as suggested by a healthcare professional. For best results, consume daily for 4-8 weeks.\",\"capsuleShellType\":\"Premium bovine gelatin\",\"activeIngredients\":[\"Marine Lipid Concentrate (Fish Oil)\",\"EPA (Eicosapentaenoic Acid Triglyceride)\",\"DHA (Docosahexaenoic Acid Triglyceride)\",\"Curcumin Extract (95% curcuminoids)\",\"Peppermint Oil\"],\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Upgrade / Optimization\",\"reason\":\"This product is positioned as a highly bioavailable, ultra-potent 4x strength alternative to standard fish oil, directly targeting wellness-conscious consumers who want the most premium and effective version of their daily supplement.\"},\"secondaryArchetypes\":[{\"name\":\"Problem Solver\",\"reason\":\"It addresses specific physical discomforts like joint stiffness, cognitive fatigue, and digestive bloating by incorporating targeted active ingredients like curcumin and peppermint oil.\"},{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily dietary supplement requiring 4 to 8 weeks of consistent usage for optimal results, it is designed to become a recurring staple in a customer's daily health routine.\"},{\"name\":\"Risk / Prevention\",\"reason\":\"The supplement appeals to individuals looking to proactively manage long-term health markers, such as maintaining healthy cholesterol, heart health, and cognitive longevity.\"}]},\"fssaiLicenseNumber\":\"10019022009134\",\"visual_description\":\"This dietary supplement product consists of a matte-finished cylindrical canister and unique, dual-phase softgel capsules. The canister features a bold color-blocked design divided horizontally, with a vibrant red top section occupying roughly the upper quarter and a royal blue section covering the lower three-quarters. On the red portion, a white circular logo reads \\\"WELLBEING NUTRITION\\\" surrounding a stylized central \\\"W\\\", flanked by a small brown non-vegetarian triangle-in-square symbol. The blue section prominently displays the brand name \\\"slow\\\" in a large, lowercase, white sans-serif font, followed by the text \\\"HIGH STRENGTH OMEGA-3 FISH OIL\\\" in a smaller white sans-serif typeface. The center of the canister displays a graphic of a diagonal, transparent yellow softgel capsule paired with a blue circular seal containing the text \\\"MOLECULARLY DISTILLED 4x STRENGTH DEEP SEA FISH OIL\\\". Below this graphic, small white text specifies \\\"1850 MG FISH OIL WITH EPA 763 MG & DHA 508 MG IN RE-ESTERIFIED TRIGLYCERIDE FORM FOR JOINT, HEART & BRAIN HEALTH,\\\" while the base of the canister features minimalist white icons for \\\"MERCURY FREE,\\\" \\\"NUTRI-SCIENCE,\\\" and \\\"60N SOFTGELS.\\\" The physical softgel capsules are elongated, highly glossy, transparent oblongs with a visible longitudinal seam. They showcase a distinct two-layer interior: a clear, bright golden-yellow liquid filling the upper majority of the capsule, and a denser, semi-opaque, deep orange-amber liquid phase settled entirely at one rounded end.\",\"certificationsAndTesting\":[\"Mercury-Free\",\"Heavy Metal Tested\",\"Molecularly Distilled\",\"Non-GMO\",\"Gluten & Allergen-Free\",\"US FDA Registered Manufacturing Facility\"]},\"normalizedSummary\":{\"summary\":\"A high-strength, molecularly distilled Omega-3 fish oil supplement in triglyceride form, formulated with curcumin and peppermint oil to support heart, brain, joint, bone, and skin health.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-16T10:17:48.258Z\",\"updatedAt\":\"2026-08-16T10:19:04.222Z\",\"variantCount\":2,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true},{\"id\":\"1f01ff08-2a8e-4682-b1ec-0e6f86abae97\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Wellbeing Nutrition Restful Sleep Melts (10mg)\",\"slug\":\"untitled-product-7\",\"sourceUrl\":\"https://wellbeingnutrition.com/products/restful-sleep-10mg-melts?variant=40904058634320\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0jp0vmhupk94vrlhdcchu01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0jp8746pgar1l09jkheaq01\",\"visualDescriptionImageFingerprint\":\"m7vnkf\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"Wellbeing Nutrition\",\"claims\":[\"Plant Based\",\"No Added Sugar\",\"No Added Preservatives\",\"GMP Certified\",\"FDA Registered Facility\"],\"dosage\":\"10 mg Melatonin\",\"flavor\":\"Lemon honey\",\"format\":\"Oral Thin Strips\",\"images\":[\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376888-e87e6e1e-6c79-4061-b93d-c265425372ce.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376966-252b01fb-1499-4326-a728-9daa4490b000.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377080-e02244da-7c85-4dc2-915b-83161fd67597.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376988-9e4dee17-9b97-40b1-8e6f-10e6023f69aa.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377051-a19c3471-af94-480a-8284-ea7a43969e60.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377062-22c9b7bf-a210-4965-ba45-c4bee588a7be.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377068-5e979424-e2f5-4909-9306-1290ac13c030.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377073-4bf2a4e0-3791-4c9c-a327-53d05c1eea5a.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376997-2645b52a-e4cf-43d8-96e3-399739e2e9cf.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377057-1f840576-f687-43ee-93f1-21effdaea046.jpg\"],\"benefits\":[\"Improves Sleep Quality\",\"Reduces Night Time Awakening\",\"Helps Fall Asleep Faster\",\"Encourages Uninterrupted Sleep\",\"No Next-Day Grogginess\",\"Supports Sleep-Wake Balance\"],\"shelfLife\":\"24 months\",\"description\":\"Fast-acting sleep support designed to help you fall asleep faster, stay asleep longer, and wake up refreshed without next-day grogginess.\",\"hasNSFWRisk\":false,\"taxonomyTag\":\"product:supplement:sleep-aid\",\"stripsPerPack\":30,\"variantSummary\":{\"count\":2,\"attributes\":{\"brand\":[\"Wellbeing Nutrition\"],\"dosage\":[\"10 mg Melatonin\"],\"flavor\":[\"Lemon honey\"],\"format\":[\"Oral Thin Strips\"],\"shelfLife\":[\"24 months\"],\"variantKey\":[\"Pack of 1\",\"Pack of 2\"],\"description\":[\"Fast-acting sleep support designed to help you fall asleep faster, stay asleep longer, and wake up refreshed without next-day grogginess.\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:supplement:sleep-aid\"],\"variantLabel\":[\"Pack of 1\",\"Pack of 2\"],\"stripsPerPack\":[\"30\"],\"countryOfOrigin\":[\"India\"]}},\"countryOfOrigin\":\"India\",\"activeIngredients\":[\"Suntheanine L-Theanine\",\"Valerian Root Extract\",\"Melatonin\",\"Ashwagandha\",\"L-Tryptophan\",\"Chamomile Extract\",\"Passion Flower Extract\",\"Vitamin B6\"],\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Problem Solver\",\"reason\":\"The product is designed to solve the immediate and frustrating issues of insomnia, difficulty falling asleep, and low-quality, interrupted rest.\"},\"secondaryArchetypes\":[{\"name\":\"Upgrade / Optimization\",\"reason\":\"The fast-acting, oral thin-strip format provides a more advanced, convenient, and premium delivery system compared to traditional hard-to-swallow pills or sugary gummies.\"},{\"name\":\"Routine / Replenishment\",\"reason\":\"A 30-strip pack naturally fits into a consumer's nightly wind-down ritual, encouraging repeat purchases for consistent sleep hygiene.\"},{\"name\":\"Values / Belief\",\"reason\":\"The plant-based, sugar-free, and non-habit-forming claims appeal directly to consumers looking for clean-label, natural wellness supplements.\"}]},\"visual_description\":\"This product consists of a pocket-sized, vertically oriented rectangular container with highly rounded corners containing individual, ultra-thin oral dissolving strips. The flat-fronted container features a dual-toned color scheme where the upper half is a solid medium blue and the lower half is solid white, divided by a soft, wavy light-blue gradient band. In the upper-left corner of the container's front is a white circular logo featuring the text \\\"WELLBEING NUTRITION\\\" wrapped around a stylized central \\\"W,\\\" while the top right displays the text \\\"30 Oral Thin Strips\\\" next to a small, white peeled-strip icon. Centered in the blue upper section is a graphic of a white crescent moon partially behind a dark blue cloud, accented by small white stars. Below this, the product name \\\"melts® into a restful sleep\\\" is printed in white, with the words \\\"restful\\\" and \\\"sleep\\\" encased in two separate, dark-blue rectangular blocks. The lower white section displays the blue text \\\"Melatonin - 10mg\\\" above a short black-text product description, followed by \\\"Lemon Honey Flavour\\\" next to a small yellow and blue lemon icon, \\\"NUTRACEUTICAL FOR ADULTS\\\" in small black capitals at the bottom left, and a small green square vegetarian symbol at the bottom right. A circular silver \\\"Advanced Molecular Science\\\" seal with a stylized atom graphic sits along the right edge of the container, bridging the blue-and-white color transition. The corresponding oral thin strip is a flexible, semi-translucent, rectangular film with a uniform caramel-brown hue, slightly rounded corners, and a matte texture.\"},\"normalizedSummary\":{\"summary\":\"A fast-acting, non-habit-forming sleep supplement in oral thin strip format powered by 10mg melatonin and calming botanicals to promote relaxation and deeper sleep.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-16T09:25:39.433Z\",\"updatedAt\":\"2026-08-16T09:26:55.366Z\",\"variantCount\":2,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true},{\"id\":\"a283cc61-8138-4e74-8189-32554920ab0b\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Wellbeing Nutrition Raw Whey Protein Isolate (Unflavoured)\",\"slug\":\"untitled-product-6\",\"sourceUrl\":\"https://wellbeingnutrition.com/products/raw-whey-protein-isolate-unflavored?variant=40976639230032\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0ji1rq2tvt3c7a1pci58501\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0ji8gg3ro984tps9qg1pn01\",\"visualDescriptionImageFingerprint\":\"5j645v\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"eaas\":\"15.4g\",\"bcaas\":\"7.1g\",\"brand\":\"Wellbeing Nutrition\",\"flavor\":\"Unflavoured\",\"images\":[\"https://localads.t3.storage.dev/product-images/a283cc61-8138-4e74-8189-32554920ab0b/1786870549944-a985ed83-af31-4505-9597-2040e34b2d43.jpg\",\"https://localads.t3.storage.dev/product-images/a283cc61-8138-4e74-8189-32554920ab0b/1786870549958-a5cf5ca2-30b7-4a27-a29f-4498803081c8.jpg\",\"https://localads.t3.storage.dev/product-images/a283cc61-8138-4e74-8189-32554920ab0b/1786870550234-77fd6628-1c8d-4097-a145-b5f729a36ee3.jpg\",\"https://localads.t3.storage.dev/product-images/a283cc61-8138-4e74-8189-32554920ab0b/1786870550216-ed6397c1-1360-44e7-bed7-7085cf446c29.jpg\",\"https://localads.t3.storage.dev/product-images/a283cc61-8138-4e74-8189-32554920ab0b/1786870550132-e41f278e-f03b-4d5b-b170-b921956b9bbf.jpg\",\"https://localads.t3.storage.dev/product-images/a283cc61-8138-4e74-8189-32554920ab0b/1786870550228-b706de84-894f-4131-978c-3669d2bd1dac.jpg\",\"https://localads.t3.storage.dev/product-images/a283cc61-8138-4e74-8189-32554920ab0b/1786870550222-cfd2f331-82c6-4ca8-977d-709d240c4f77.jpg\",\"https://localads.t3.storage.dev/product-images/a283cc61-8138-4e74-8189-32554920ab0b/1786870550248-0842f294-45c3-4b48-bc8c-4ba02a112c36.jpg\"],\"benefits\":[\"Increases muscle endurance\",\"Builds lean muscle mass\",\"Decreases muscle soreness\",\"Easy on digestion with no bloating\"],\"features\":[\"Sourced directly from milk (not a cheese by-product)\",\"Cold-processed and microfiltered at low temperatures\",\"99% lactose-free\",\"No artificial sweeteners, gums, or thickeners\",\"Instantized with sunflower lecithin for smooth texture\"],\"shelfLife\":\"18 months\",\"directions\":\"Add 1 scoop to 200-250ml of water in a shaker. Shake for 30 seconds. Can also be blended into smoothies or milkshakes.\",\"probiotics\":\"4 Billion CFU (Lactobacillus acidophilus & Bifidobacterium longum)\",\"hasNSFWRisk\":false,\"taxonomyTag\":\"product:nutrition:protein-powder\",\"certifications\":[\"GMP Certified\",\"FDA Registered\",\"Tested for Protein Concentration\",\"Amino Spiking Tested\",\"Clean Label Project Award Winner\"],\"variantSummary\":{\"count\":2,\"attributes\":{\"eaas\":[\"15.4g\"],\"bcaas\":[\"7.1g\"],\"brand\":[\"Wellbeing Nutrition\"],\"flavor\":[\"Unflavoured\"],\"shelfLife\":[\"18 months\"],\"directions\":[\"Add 1 scoop to 200-250ml of water in a shaker. Shake for 30 seconds. Can also be blended into smoothies or milkshakes.\"],\"probiotics\":[\"4 Billion CFU (Lactobacillus acidophilus & Bifidobacterium longum)\"],\"variantKey\":[\"Pack of 1KG\",\"Pack of 2KG\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:nutrition:protein-powder\"],\"variantLabel\":[\"Pack of 1KG\",\"Pack of 2KG\"],\"countryOfOrigin\":[\"India\"],\"digestiveEnzymes\":[\"Bromelain (from pineapple) & Papain (from papaya)\"],\"proteinPerServing\":[\"31g\"]}},\"countryOfOrigin\":\"India\",\"digestiveEnzymes\":\"Bromelain (from pineapple) & Papain (from papaya)\",\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Upgrade / Optimization\",\"reason\":\"Fitness consumers already using standard whey will buy this raw, native isolate to upgrade to a cleaner, higher-potency protein source that is cold-processed directly from milk with no artificial additives.\"},\"secondaryArchetypes\":[{\"name\":\"Problem Solver\",\"reason\":\"It directly solves the common consumer pain point of bloating and digestive discomfort associated with protein powders by including specific digestive enzymes and probiotics.\"},{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily dietary supplement for muscle recovery, this product fits into a highly repeatable fitness routine requiring regular restock purchases.\"}]},\"proteinPerServing\":\"31g\",\"visual_description\":\"This stand-up, gusseted resealable pouch is constructed from a flexible, semi-matte metallic silver-gray laminate foil with tear notches and a visible press-to-close zipper line near the heat-sealed top edge. The left side gusset features a vertical, high-contrast marbled pattern of fluid black, gray, and white swirls that wraps slightly onto the front face, while the upper-right corner is detailed with a solid matte white vertical strip displaying a bold black \\\"31g PROTEIN\\\" callout. Centered near the top is the cursive script \\\"Progress Series\\\" in black, positioned above a circular black logo for \\\"WELLBEING NUTRITION\\\" that encloses a stylized \\\"W\\\" with a small green leaf on its right tip. The front center displays \\\"WHEY PROTEIN\\\" (or \\\"100% WHEY PROTEIN^\\\" on some size variants) and the word \\\"ISOLATE\\\" in giant, clean, sans-serif black lettering, underscored by \\\"ULTRA PURE • FAST ABSORBING\\\". Below this, a white pill-shaped capsule badge reads \\\"UNFLAVOURED\\\" in black, followed by a black-bordered horizontal nutritional grid divided into five columns detailing \\\"31g PROTEIN\\\", \\\"15.4g EAA\\\", \\\"7.1g BCAA\\\", either \\\"1.4g CARBS\\\" or \\\"<1g CARBS\\\" depending on the packaging size, and \\\"4B CFU PROBIOTICS\\\", with a lower sub-bar reading \\\"Whey Protein Isolate with Natural Digestive Enzymes & Probiotics.\\\" A circular \\\"HORMONE FREE\\\" seal with a line-art cow head sits to the right of this grid, while the very bottom edge features a green vegetarian dot symbol, the word \\\"NUTRACEUTICAL\\\" (or \\\"NUTRACEUTICAL FOR ADULTS\\\"), and the net weight (labeled as either \\\"1 kg (2.2 lb)\\\" or \\\"2KG (4.4LB)\\\"). The dry product inside is a finely milled, loose, off-white to pale cream-colored powder.\"},\"normalizedSummary\":{\"summary\":\"India's first raw native whey protein isolate delivering 31g protein, probiotics, and digestive enzymes per scoop for enhanced muscle recovery and easy digestion.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-16T08:55:11.678Z\",\"updatedAt\":\"2026-08-16T08:58:05.513Z\",\"variantCount\":2,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true},{\"id\":\"32259477-b7f2-4895-aedd-cde326d7b380\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Wellbeing Nutrition Glow Korean Marine Collagen Peptides\",\"slug\":\"untitled-product-5\",\"sourceUrl\":\"https://wellbeingnutrition.com/products/glow-collagen-powder-for-skin?variant=39712644005968\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0ja0lsqpf86jdu4sqguu201\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0jaid89mecdcolmp0nkbm01\",\"visualDescriptionImageFingerprint\":\"2fagq5\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"Wellbeing Nutrition\",\"flavor\":\"Tropical Bliss\",\"images\":[\"https://localads.t3.storage.dev/product-images/32259477-b7f2-4895-aedd-cde326d7b380/1786868441847-2adc2ea9-c0cc-4150-be9b-5faab757b46b.jpg\",\"https://localads.t3.storage.dev/product-images/32259477-b7f2-4895-aedd-cde326d7b380/1786868441997-2f98838e-1f9f-46de-becc-4cf2189a9988.png\",\"https://localads.t3.storage.dev/product-images/32259477-b7f2-4895-aedd-cde326d7b380/1786868441988-f3064aac-97c7-4610-938a-4cc960c8d09d.jpg\",\"https://localads.t3.storage.dev/product-images/32259477-b7f2-4895-aedd-cde326d7b380/1786868441892-f77f483a-80cb-4e77-a4e0-583c4fb73f17.jpg\",\"https://localads.t3.storage.dev/product-images/32259477-b7f2-4895-aedd-cde326d7b380/1786868441979-cc3277bf-0eaf-4846-8054-94872784d522.jpg\",\"https://localads.t3.storage.dev/product-images/32259477-b7f2-4895-aedd-cde326d7b380/1786868442111-d3753e29-ce4e-4bbe-a2af-4b1f27d39377.jpg\",\"https://localads.t3.storage.dev/product-images/32259477-b7f2-4895-aedd-cde326d7b380/1786868442102-a5665d79-76f9-4bed-8f13-c26899366d70.jpg\"],\"howToUse\":\"Mix one level scoop (10g) in a 250ml glass of water, smoothie, juice, or breakfast bowl. Consume daily for 12 weeks for best results.\",\"quantity\":\"250g\",\"shelfLife\":\"24 Months\",\"hasNSFWRisk\":false,\"keyBenefits\":[\"Supports Collagen Production\",\"Helps Promote Even Skin Tone\",\"Helps Reduce Fine Lines & Wrinkles\",\"Helps Improve Skin Radiance\",\"Helps Reduce Dark Spots\",\"Helps Repair Skin Barrier\"],\"taxonomyTag\":\"product:supplements:collagen-powder\",\"keyIngredients\":[\"Hydrolyzed Marine Collagen Peptide (Type I & III, sourced from wild-caught Korean salmon)\",\"Liposomal L-Glutathione\",\"Vitamin C (L-Ascorbic Acid)\",\"Resveratrol\",\"DigeZyme® (Alpha Amylase, Protease, Lipase, Cellulase & Lactase)\",\"Goji Berry Fruit Extract\"],\"variantSummary\":{\"count\":4,\"attributes\":{\"brand\":[\"Wellbeing Nutrition\"],\"flavor\":[\"Tropical Bliss\"],\"howToUse\":[\"Mix one level scoop (10g) in a 250ml glass of water, smoothie, juice, or breakfast bowl. Consume daily for 12 weeks for best results.\"],\"quantity\":[\"250g\"],\"shelfLife\":[\"24 Months\"],\"variantKey\":[\"Pack of 1\",\"Pack of 2\",\"Pack of 3\",\"Pack of 4\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:supplements:collagen-powder\"],\"variantLabel\":[\"Pack of 1\",\"Pack of 2\",\"Pack of 3\",\"Pack of 4\"],\"countryOfOrigin\":[\"India\"]}},\"countryOfOrigin\":\"India\",\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Desire / Identity\",\"reason\":\"The product primarily appeals to the consumer's aspiration for radiant, glowing, and youthful-looking skin, which is deeply connected to personal aesthetic goals and self-confidence.\"},\"secondaryArchetypes\":[{\"name\":\"Problem Solver\",\"reason\":\"It targets and clinical addresses specific dermatological pain points such as fine lines, wrinkles, dark spots, and an uneven skin tone.\"},{\"name\":\"Upgrade / Optimization\",\"reason\":\"It is positioned as a highly premium, dermatologically tested option featuring superior ingredients like wild-caught Korean marine collagen and liposomal glutathione for better absorption than standard collagens.\"},{\"name\":\"Routine / Replenishment\",\"reason\":\"The supplement requires structured daily consumption over at least 12 weeks to see optimal results, making it a natural fit for a recurring daily beauty and wellness habit.\"}]},\"visual_description\":\"This dietary supplement product is packaged in a wide, cylindrical, matte-finish white plastic tub with a matching flat-topped, flush-fitting white screw cap. The wrap-around label features a smooth vertical color gradient, transitioning from solid white at the top to a warm, saturated coral-red at the bottom. Centered on the upper white section is a black circular logo containing the arched text \\\"WELLBEING NUTRITION\\\" surrounding a stylized central letter \\\"W\\\" with a single tiny green leaf on its top-right tip. Below the logo is a large, rectangular framed section in a deeper coral shade that houses the product name \\\"glow\\\" stacked above \\\"collagen^\\\" in a prominent, elegant white serif lowercase font, directly followed by black Korean characters \\\"글로우 콜라겐\\\" and black descriptive text specifying \\\"Korean Marine Collagen Peptides with Liposomal Glutathione, Vitamin C, Resveratrol and DigeZyme®,\\\" alongside \\\"Type I & III\\\" and a white horizontal banner highlighting \\\"Tropical Bliss Flavour.\\\" To the right of this frame sits a circular graphic featuring a pink-and-white geodesic, triangular grid pattern bordered by the curved text \\\"Wild Caught • Mercury Free,\\\" with a small red \\\"Clinically Approved\\\" cross seal above it. The bottom edge of the label displays five small black line-art skin-benefit icons lined up horizontally above text indicating a net weight of 250g. When the dry powder product inside is mixed with water as directed, it dissolves to form a vibrant, translucent coral-pink beverage.\",\"certificationsAndFeatures\":[\"No.1 Dermatologist Recommended\",\"Mercury Free\",\"Heavy Metal Tested\",\"Non-GMO\",\"No Artificial Colour or Flavour\",\"Clinically Validated Ingredients\",\"Sourced from US FDA Registered Manufacturing Facility\",\"Dairy-free\",\"Keto-friendly\"]},\"normalizedSummary\":{\"summary\":\"A premium dermatologically-tested skin supplement made with wild-caught Korean marine collagen, liposomal glutathione, and vitamin C to promote radiant, youthful skin.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-16T08:20:04.870Z\",\"updatedAt\":\"2026-08-16T08:22:46.366Z\",\"variantCount\":4,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true},{\"id\":\"9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Pure Korean Marine Collagen Peptides\",\"slug\":\"untitled-product-4\",\"sourceUrl\":\"https://wellbeingnutrition.com/products/korean-marine-collagen-peptides?variant=40790287614032\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0d9deaqvboevdgircgu1h01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0d9ji889jtfkf6u3n1ngf01\",\"visualDescriptionImageFingerprint\":\"qm98ua\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"Wellbeing Nutrition\",\"flavor\":\"Unflavored\",\"images\":[\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949166-35373943-22c4-47c8-96fa-7ed78d6f2238.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949264-7c225ca7-927f-4ecb-8942-822ddb1a3ee8.png\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949365-64cd17f2-5072-4b7e-87d8-9f9dbe7ed6eb.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949358-27f358d8-f3b1-47fa-9f0d-b08c660466ad.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949374-ab9f5785-b8e0-4849-8fa2-ae07e279452d.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949453-ce143e12-4c16-4a29-b20f-541f81ae035a.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949381-c227ae82-5fb6-427d-ab69-4c262b3854b5.jpg\"],\"source\":\"Sustainably sourced from wild-caught Korean deep-sea fish\",\"weight\":\"200 g\",\"benefits\":[\"Reduces signs of aging\",\"Enhances skin firmness & elasticity\",\"Improves skin hydration\",\"Smooths and refines skin texture\",\"Supports collagen density\",\"Enhances joint health\",\"Reduces nail brittleness\"],\"hasNSFWRisk\":false,\"ingredients\":[\"100% Pure Korean Marine Collagen Peptides\"],\"taxonomyTag\":\"product:supplement:collagen\",\"collagenTypes\":[\"Type I\",\"Type III\"],\"certifications\":[\"Clinically Proven\",\"Mercury Free\",\"Heavy Metal Tested\",\"No Added Sugar\",\"No Preservatives\",\"Non GMO\",\"Gluten Free\",\"Dairy Free\",\"Keto Friendly\"],\"variantSummary\":{\"count\":4,\"attributes\":{\"brand\":[\"Wellbeing Nutrition\"],\"flavor\":[\"Unflavored\"],\"source\":[\"Sustainably sourced from wild-caught Korean deep-sea fish\"],\"weight\":[\"200 g\"],\"variantKey\":[\"Pack of 1\",\"Pack of 2\",\"Pack of 3\",\"Pack of 4\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:supplement:collagen\"],\"variantLabel\":[\"Pack of 1\",\"Pack of 2\",\"Pack of 3\",\"Pack of 4\"],\"molecularWeight\":[\"< 1000 daltons\"],\"dosageInstructions\":[\"Mix one scoop of Korean Marine Collagen with 250 ml water or other beverages daily for best results.\"]}},\"molecularWeight\":\"< 1000 daltons\",\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Desire / Identity\",\"reason\":\"The product is primarily driven by the customer's desire to maintain a youthful, vibrant appearance by actively combating visible signs of aging and improving skin, hair, and nail aesthetics.\"},\"secondaryArchetypes\":[{\"name\":\"Upgrade / Optimization\",\"reason\":\"It targets consumers who already use collagen but want to upgrade to a superior, highly bioavailable version featuring premium Korean marine peptides with an ultra-low molecular weight of under 1000 daltons.\"},{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily dietary supplement that requires consistent, long-term use to maintain results, it naturally fits into a recurring health and wellness habit.\"},{\"name\":\"Values / Belief\",\"reason\":\"The product appeals to ethically and health-conscious buyers through its sustainable wild-caught sourcing, non-GMO status, clean certifications, and allergen-free formulation.\"}]},\"dosageInstructions\":\"Mix one scoop of Korean Marine Collagen with 250 ml water or other beverages daily for best results.\",\"visual_description\":\"This product is a dietary supplement packaged in a stout, wide-mouth cylindrical plastic jar with a matching matte white, flat-topped screw-on lid. The container features a full-wrap adhesive label with a vertical color gradient transitioning from clean white at the top to a vibrant cyan-teal at the bottom. The upper white section displays the \\\"WELLBEING NUTRITION\\\" logo in black arching text around a stylized capital \\\"W\\\" that incorporates a small green leaf on its right arm, alongside a small red-bordered square containing a red triangle on the upper right. The center of the label is dominated by a rectangular teal-blue panel containing the product name \\\"marine collagen\\\" in a large, bold, lowercase white serif typeface, followed below by the Korean translation \\\"해양 콜라겐\\\" and \\\"Korean Collagen Peptides\\\" in black serif text, \\\"Type I & III\\\" in bold, and the word \\\"Unflavored\\\" in black inside a small white rectangular badge. To the right of this text, still within the teal panel, is a circular graphic of a glowing light-blue geodesic sphere bordered by the text \\\"Wild Caught • Mercury Free,\\\" a small circular blue-and-white \\\"CLINICALLY APPROVED\\\" cross badge, and a prominent black \\\"8g Collagen per serving\\\" callout. Below the central panel, on the solid cyan background, a row of five black circular line-art icons represent \\\"Skin\\\", \\\"Hair\\\", \\\"Nails\\\", \\\"Bones\\\", and \\\"Joints,\\\" with \\\"25 servings / Net Wt: 200 gms\\\" printed on the bottom-left and \\\"NUTRACEUTICAL\\\" on the bottom-right; the back and side panels of the label are not visible.\"},\"normalizedSummary\":{\"summary\":\"Sustainably sourced from deep-sea fish, this premium unflavored Marine Collagen powder is formulated to combat signs of aging by improving skin firmness, elasticity, and hydration while supporting joint, bone, hair, and nail health.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T18:18:35.894Z\",\"updatedAt\":\"2026-08-15T18:19:56.879Z\",\"variantCount\":4,\"creativeCount\":1,\"generatedCreativeCount\":1,\"hasGeneratedCreatives\":true},{\"id\":\"6ff58a5f-f626-4006-94f2-50ef9146b4c1\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"SNIQUE Bakuchi Matte Hydrator Moisturizer\",\"slug\":\"untitled-product-3\",\"sourceUrl\":\"https://snique.in/products/bakuchi-matte-hydrator-moisturizer\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0d66c6le15s0aecim2p4h01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0d6mdaqnd2jc8vsu319am01\",\"visualDescriptionImageFingerprint\":\"1mih5ml\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"SNIQUE\",\"price\":\"Rs. 299.00\",\"images\":[\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107038-d935f726-a8cf-41f6-a859-ab4a7cb93726.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817106979-65b221af-02a0-44a3-9c5d-20a042a8be8b.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107028-79453fe4-9e1b-4fb0-9f73-badb5f69ca8d.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107296-786ccf2e-53bb-4db0-8678-42041a57ce9e.png\"],\"caution\":\"For external use only. Avoid contact with the eyes. Patch test recommended. Discontinue if irritation occurs. Keep out of children’s reach.\",\"storage\":\"Store in a cool & dry place. Keep away from direct sunlight.\",\"howToUse\":\"Apply evenly on cleansed face & neck. Use morning and night. For daytime, follow with sunscreen.\",\"description\":\"Snique Matt Moisturizer is a lightweight, oil-free hydrating gel-cream designed for oily, combination, and acne-prone skin. Powered by Ceramide Complex + Hyaluronic Acid, it restores the skin barrier and locks in moisture without shine. The botanical blend of Cica, Ginseng, Ice Apple, Butterfly Pea Extract & Berry Complex soothes, repairs, and brightens the skin. Bakuchiol, a gentle retinol alternative, helps refine texture and improve clarity, while SEPIMAT™ H10 FW provides a soft-focus matte effect for all-day freshness.\",\"hasNSFWRisk\":false,\"ingredients\":[\"Aqua (Water)\",\"Ceramide Complex (Ceramide NP, Ceramide AP, Ceramide EOP)\",\"Xylitol\",\"Betaine\",\"Sodium Hyaluronate\",\"Caprylic/Capric Triglyceride\",\"Aloe Barbadensis Leaf Extract\",\"Centella Asiatica Extract\",\"Panax Ginseng Root Extract\",\"Ammonium Acryloyldimethyltaurate/Beheneth-25 Methacrylate Crosspolymer (Aristoflex® Silk)\",\"Methyl Methacrylate Crosspolymer (SEPIMAT™ H10 FW)\",\"Phenoxyethanol\",\"Ethylhexylglycerin\",\"Menthyl Lactate\",\"Ice Apple Extract (Borassus Flabellifer)\",\"Inositol\",\"Bakuchiol\",\"Clitoria Ternatea (Butterfly Pea) Flower Extract\",\"Vaccinium spp. Berry Extract Complex\",\"Rosa Canina (Rosehip) Oil\"],\"keyBenefits\":[\"Long-lasting matte finish\",\"Controls excess oil & shine\",\"Deep hydration without greasiness\",\"Strengthens skin barrier with ceramides\",\"Soothes redness and irritation\",\"Refines texture & supports anti-aging\",\"Non-comedogenic gel-cream formula\"],\"taxonomyTag\":\"product:skincare:moisturizer\",\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Problem Solver\",\"reason\":\"This moisturizer specifically targets frustrating skin concerns like excess oil, greasy shine, and acne-prone breakouts with a lightweight, non-comedogenic formula that provides a long-lasting matte finish.\"},\"secondaryArchetypes\":[{\"name\":\"Routine / Replenishment\",\"reason\":\"Designed for essential daily use both morning and night, this product fits naturally into a consumer's recurring skincare habit.\"},{\"name\":\"Upgrade / Optimization\",\"reason\":\"The inclusion of advanced ingredients like a Ceramide Complex and a gentle retinol alternative (Bakuchiol) appeals to users looking to optimize their basic moisturizer for better barrier repair and texture refinement.\"}]},\"visual_description\":\"This skin care product set consists of a 50-gram moisturizer in a cylindrical jar and its corresponding square paperboard carton. The jar features a thick-walled, frosted, semi-translucent pale-blue body—likely made of glass or heavy plastic—topped with a flush-fitting, opaque, matte white cylindrical screw cap. A white adhesive label on the front of the jar displays the text \\\"Bakuchi Matte\\\" over \\\"Hydrator Moisturizer\\\" in a bold, dark gray sans-serif font, underlined by a thin light-blue line, with a left-aligned list of six product benefits and \\\"NET QTY.: 50 gm\\\" at the bottom right. The brand name \\\"sniQue\\\" is printed vertically along the label's right edge in a light-blue stylized typeface. The matching matte-finish outer carton is primarily white with a contrasting solid light-blue band wrapping around the bottom fifth of the box. The front of the carton replicates the jar's typography and vertical brand logo, but adds a horizontal, rounded light-blue capsule printed with \\\"Ceramides + Hyaluronic Acid + Bakuchiol\\\" positioned within the bottom band. The carton's side panels present lists of ingredients, directions, and warnings in dark gray text under light-blue headers, maintaining the clean, two-tone layout.\"},\"normalizedSummary\":{\"summary\":\"A lightweight, oil-free hydrating gel-cream designed for oily, combination, and acne-prone skin, providing a long-lasting matte finish and restoring the skin barrier.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T18:04:31.192Z\",\"updatedAt\":\"2026-08-15T18:07:42.556Z\",\"variantCount\":0,\"creativeCount\":6,\"generatedCreativeCount\":6,\"hasGeneratedCreatives\":true},{\"id\":\"40a78158-009e-4be2-ba8d-2ef357f1fd04\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"SNIQUE Anti Acne Foaming Facewash\",\"slug\":\"untitled-product-2\",\"sourceUrl\":\"https://snique.in/products/anti-acne-foaming-facewash\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0d410lvl8ehm81tis3k8f01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0d46e3d2j2bj3qemdum1o01\",\"visualDescriptionImageFingerprint\":\"1x6799z\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"SNIQUE\",\"images\":[\"https://localads.t3.storage.dev/product-images/40a78158-009e-4be2-ba8d-2ef357f1fd04/1786816535495-cf3f9bf0-19ca-4cf6-90f7-f88ce9cdf577.png\",\"https://localads.t3.storage.dev/product-images/40a78158-009e-4be2-ba8d-2ef357f1fd04/1786816535537-5b7b72b0-f72e-4fd4-8dc7-55e167fe9ce1.png\",\"https://localads.t3.storage.dev/product-images/40a78158-009e-4be2-ba8d-2ef357f1fd04/1786816535471-6193e147-13dc-41cf-b09d-e1f79cb77943.png\",\"https://localads.t3.storage.dev/product-images/40a78158-009e-4be2-ba8d-2ef357f1fd04/1786816535650-1801c00f-aab6-4107-a16c-a53252d8577b.png\"],\"rating\":4.7,\"caution\":[\"For external use only.\",\"Avoid eye contact; rinse immediately if it occurs.\",\"Do a patch test before first use.\",\"Discontinue if irritation persists.\",\"Keep out of reach of children.\"],\"storage\":\"Store in a cool and dry place. Protect from direct sunlight and heat.\",\"howToUse\":[\"Pump 1–2 times to dispense soft foam.\",\"Massage gently over the damp face in circular motions.\",\"Rinse thoroughly.\",\"Use twice daily.\"],\"salePrice\":\"Rs. 299.00\",\"hasNSFWRisk\":false,\"ingredients\":\"Aqua (Water), Coco Amido Propyl Betaine, Sodium Cocoyl Methyl Taurate, Caprylyl/Capryl Glucoside, Salicylic Acid, Succinic Acid, VeryBerry™ ACNEcare (Water (and) Propanediol (and) Salicylic Acid (and) Sodium Hydroxide (and) Dipotassium Glycyrrhizate (and) Citrus Junos Seed Extract (and) Citrus Unshiu Peel Extract (and) Actinidia Chinensis (Kiwi) Seed Extract (and) Fragaria Chiloensis (Strawberry) Fruit Extract (and) Vitis Vinifera (Grape) Leaf Extract (and) Vitis Vinifera (Grape) Skin Extract (and) Garcinia Mangostana Peel Extract), Phenoxyethanol, Ethylhexylglycerin.\",\"keyBenefits\":[\"Ultra-gentle microfoam cleanses deeply\",\"Removes excess oil & unclogs pores\",\"Helps reduce acne, blackheads & breakouts\",\"Calms redness with soothing botanicals\",\"Suitable for oily, acne-prone & sensitive skin\",\"Non-stripping, pH-balanced formula\"],\"taxonomyTag\":\"product:skincare:facewash\",\"regularPrice\":\"Rs. 599.00\",\"reviewsCount\":3,\"activeComplex\":[\"Salicylic Acid (BHA) - Removes dead skin & clears pores\",\"Succinic Acid - Targets acne-causing bacteria & sebum\",\"VeryBerry™ ACNEcare - Multi-fruit anti-acne complex (Kiwi, Strawberry, Grape, Mangosteen, Yuzu)\",\"Allantoin - Soothes & reduces irritation\"],\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Problem Solver\",\"reason\":\"The product is formulated specifically to target active skin issues, including acne breakouts, excess oil production, and redness, resolving a clear physiological frustration.\"},\"secondaryArchetypes\":[{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily foaming face wash meant to be used twice a day, this is a recurring consumable that integrates directly into a customer's morning and evening hygiene routine.\"},{\"name\":\"Upgrade / Optimization\",\"reason\":\"Formulated with specialized active ingredients like Succinic Acid and VeryBerry™ ACNEcare, it appeals to consumers looking to upgrade from basic cleansers to a more advanced, non-stripping skincare solution.\"}]},\"visual_description\":\"This skincare product set consists of a 150 mL cylindrical foaming face wash bottle and its matching tall, rectangular cardboard outer box, both featuring a clean, minimalist white-and-light-green color palette. The bottle is made of smooth white plastic, capped with a large white foaming pump dispenser nozzle and covered by a clear, translucent cylindrical plastic cap. The bottle's main body is wrapped in a matte white label with a solid light green band at the base, matching the graphics on the rectangular box. On the front of both the bottle and the box, the upper left side displays bold, black sans-serif text reading \\\"Anti-Acne\\\", \\\"Foam Face\\\", and \\\"Wash\\\", followed by the description \\\"Foam That Fights Acne – Gently & Effectively\\\" and a list of benefits (\\\"Clear Skin\\\", \\\"Zero Oil\\\", \\\"Gentle Foam Purity\\\") separated by a thin, horizontal green line. The brand name \\\"sniQue\\\" is printed vertically on the right in a large, stylized, rounded light green lowercase font. At the very bottom, set inside the light green band, a rounded-corner rectangular block contains the text \\\"Salicylic Acid (BHA) + Succinic Acid + Multi-fruit anti-acne complex + Allantoin\\\" in small black sans-serif font. The side panels of the box and back of the bottle display detailed product information, featuring light green section headers such as \\\"Ingredients\\\", \\\"Directions For Use\\\", and \\\"Warnings\\\" followed by dense black text detailing chemical and botanical components, application steps, and safety precautions.\"},\"normalizedSummary\":{\"summary\":\"An ultra-gentle microfoam cleanser formulated with Salicylic Acid and Succinic Acid to fight acne, remove excess oil, and soothe redness without stripping the skin.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T17:55:03.104Z\",\"updatedAt\":\"2026-08-15T17:56:14.292Z\",\"variantCount\":0,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true},{\"id\":\"87972c9f-a792-4e87-ad2f-fb2f744ba4bb\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"SNIQUE Glitter Spray Sunscreen SPF 30+++\",\"slug\":\"untitled-product\",\"sourceUrl\":\"https://snique.in/products/glitter-spray-sunscreen-spf-30\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0d316egrbijqdve3kt6tp01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0d36v1bb27merjauag5j501\",\"visualDescriptionImageFingerprint\":\"u0h028\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"spf\":\"30+++\",\"brand\":\"SNIQUE\",\"claims\":[\"Broad Spectrum Protection\",\"Cosmetic-Grade Glitter\",\"Cruelty-Free\",\"Reef-Safe Formula\",\"Hydrating & Non-Greasy\",\"Dermatologist Tested\"],\"finish\":\"Lightweight, Hydrating, Shimmer Finish\",\"images\":[\"https://localads.t3.storage.dev/product-images/87972c9f-a792-4e87-ad2f-fb2f744ba4bb/1786816273628-82242918-02fb-40e5-9c8c-4dbbd57f8581.png\",\"https://localads.t3.storage.dev/product-images/87972c9f-a792-4e87-ad2f-fb2f744ba4bb/1786816273748-d5a6d055-125e-49ef-8735-bc623d393d21.png\",\"https://localads.t3.storage.dev/product-images/87972c9f-a792-4e87-ad2f-fb2f744ba4bb/1786816273516-8c97ad3e-5b40-45eb-9f42-480a7eb79d21.png\",\"https://localads.t3.storage.dev/product-images/87972c9f-a792-4e87-ad2f-fb2f744ba4bb/1786816273707-097794c3-ed21-42ee-bc02-b5a2ac53ff37.png\"],\"cautions\":[\"For external use only. Avoid contact with the eyes.\",\"Patch test recommended. If irritation occurs, discontinue use.\",\"Keep out of reach of children. Flammable – do not use near heat or open flame.\"],\"howToUse\":\"Shake well before use. Spray generously and evenly 15 minutes before sun exposure. Reapply every 2 hours, after sweating or swimming. Avoid eyes and lips.\",\"subBrand\":\"COANC GlowGuard™\",\"basePrice\":\"Rs. 449.00\",\"netWeight\":\"100 mL / 3.38 fl oz\",\"hasNSFWRisk\":false,\"ingredients\":[\"Aqua (Water)\",\"Ethylhexyl Methoxycinnamate\",\"Homosalate\",\"Octocrylene\",\"Butyl Methoxydibenzoylmethane\",\"Glycerin\",\"Alcohol Denat.\",\"Hyaluronic Acid\",\"Aloe Barbadensis Leaf Extract\",\"Tocopheryl Acetate\",\"Panthenol\",\"Polysorbate 20\",\"Phenoxyethanol\",\"Ethylhexylglycerin\",\"Parfum (Fragrance)\",\"Mica\",\"Titanium Dioxide (for glitter effect)\",\"CI 77891\",\"CI 77491\"],\"keyBenefits\":[\"Broad Spectrum SPF 30+++ | Protects against UVA + UVB rays\",\"Hydrating Formula | With hyaluronic acid & glycerin for lasting moisture\",\"Micro-Shimmer Finish | Cosmetic-grade glitter adds a radiant glow\",\"Ultra-Light Mist | No stickiness, no residue, no white cast\",\"Water & Sweat Resistant | Up to 80 minutes of protection\"],\"taxonomyTag\":\"product:skincare:sunscreen\",\"sunscreenType\":\"Broad-Spectrum UVA/UVB Protection\",\"variantSummary\":{\"count\":1,\"attributes\":{\"spf\":[\"30+++\"],\"brand\":[\"SNIQUE\"],\"finish\":[\"Lightweight, Hydrating, Shimmer Finish\"],\"howToUse\":[\"Shake well before use. Spray generously and evenly 15 minutes before sun exposure. Reapply every 2 hours, after sweating or swimming. Avoid eyes and lips.\"],\"subBrand\":[\"COANC GlowGuard™\"],\"basePrice\":[\"Rs. 449.00\"],\"netWeight\":[\"100 mL / 3.38 fl oz\"],\"variantKey\":[\"100 mL / 3.38 fl oz\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:skincare:sunscreen\"],\"variantLabel\":[\"100 mL / 3.38 fl oz\"],\"sunscreenType\":[\"Broad-Spectrum UVA/UVB Protection\"],\"waterResistance\":[\"80 minutes\"]}},\"waterResistance\":\"80 minutes\",\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Desire / Identity\",\"reason\":\"The inclusion of cosmetic-grade glitter for a micro-shimmer, radiant finish appeals heavily to consumers wanting to enhance their aesthetic appearance, signal style, and feel glowing and attractive.\"},\"secondaryArchetypes\":[{\"name\":\"Risk / Prevention\",\"reason\":\"Despite its cosmetic sparkle, the product serves as an SPF 30+++ broad-spectrum sunscreen protecting the user from harmful UV rays and sunburn.\"},{\"name\":\"Occasion / Event\",\"reason\":\"A glitter sunscreen is highly seasonal and occasion-driven, making it especially appealing for pool parties, beach trips, music festivals, and summer vacations.\"}]},\"visual_description\":\"This product consists of a 100 mL liquid sunscreen housed in a clear cylindrical plastic spray bottle, accompanied by a tall, rectangular cardboard carton. The bottle reveals a vibrant, iridescent coral-pink liquid suspended with fine, light-reflective micro-shimmer glitter, and is fitted with a white spray nozzle assembly under a clear, flush-fitting cylindrical plastic cap. White text is printed directly on the front of the bottle, displaying the product name \\\"Glitter Spray Sunscreen SPF 30+++\\\" above descriptive details (\\\"Hydrating Mist with Sparkle Protection\\\", \\\"Lightweight\\\", \\\"Hydrating\\\", \\\"Shimmer Finish\\\"), with \\\"NET QTY.: 100 ML\\\" positioned at the bottom right. The accompanying carton features a clean, two-toned color block design where the top three-quarters is matte white and the bottom quarter is a solid coral-pink block. A large, stylized, lowercase coral-pink brand logo spelling \\\"snique\\\" wraps around the corner, split vertically down the seam between the front and side panels. The front panel of the carton mirrors the bottle's layout in dark grey text on the white section, and includes a rounded-rectangle badge at the bottom containing \\\"Hyaluronic Acid + Aloe Vera + Vitamin E\\\". The carton's side and back panels display product details, ingredients, directions, and warnings in dark grey text under coral-pink headers on the white portion, with the bottom coral-pink block of one side featuring five white line-art symbols representing recycling, GMP, cruelty-free, 24M, and vegan certifications.\"},\"normalizedSummary\":{\"summary\":\"A multi-functional SPF 30+++ sunscreen mist that protects against UVA/UVB rays, hydrates with hyaluronic acid, and leaves a radiant shimmer finish.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T17:50:42.412Z\",\"updatedAt\":\"2026-08-15T17:52:14.540Z\",\"variantCount\":1,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true}]}},{\"result\":{\"data\":[{\"id\":\"6442dc69-08c3-4b2d-ba24-2d75074cfe05\",\"name\":\"OLIPOP Classic Grape (9g Fiber)\",\"status\":\"draft\",\"thumbnail\":\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044959-75d02dc6-ee4a-4327-9a07-2a07af4ac4f7.webp\",\"createdAt\":\"2026-08-17T07:50:17.983Z\"}]}},{\"result\":{\"data\":{\"designGuide\":\"# Olipop Brand Design Guide for Ad Creatives\\n\\nThis document serves as the primary visual and stylistic reference for all ad creative production for Olipop. Olipop is a \\\"New Kind of Soda\\\" that blends a nostalgic, retro aesthetic with modern, health-conscious clean design.\\n\\n---\\n\\n## 1. Brand Personality\\n*   **Nostalgic yet Modern:** Evokes the feeling of a vintage soda shop but with a clean, premium, and functional upgrade.\\n*   **Vibrant & Playful:** High-energy colors and organic shapes.\\n*   **Approachable & Healthy:** Focuses on digestive health (prebiotics/fiber) without looking \\\"medical.\\\"\\n\\n---\\n\\n## 2. Typography\\nThe brand uses a specific hierarchy of serif and sans-serif fonts to balance its retro-modern identity. Since these fonts may not be installed on your system, please use the descriptions below to find appropriate alternatives or match the style.\\n\\n### **Primary Display Font: WindsorEF**\\n*   **Description:** A heavy, \\\"chunky\\\" retro serif with high personality. It has rounded terminals and a distinct 1960s/70s vibe.\\n*   **Usage:** Used for Hero headlines (H1), major section titles, and emphasis.\\n*   **Weights:** Ultra Heavy (900) and Bold.\\n*   **Visual Equivalent:** Windsor, Cooper Black, or a very heavy, soft-edged serif.\\n\\n### **Secondary/Body Font: Ano**\\n*   **Description:** A clean, geometric, and modern sans-serif. It is highly legible and provides a \\\"functional\\\" contrast to the decorative Windsor font.\\n*   **Usage:** Subheaders, body copy, button text, and navigation.\\n*   **Weights:** Regular, Bold, Black (900).\\n*   **Visual Equivalent:** Helvetica, Arial, or a geometric sans like Montserrat.\\n\\n### **Typography Rules:**\\n*   **Headlines:** Large, bold, and often centered.\\n*   **Letter Spacing:** Standard; avoid excessive tracking in display fonts.\\n*   **Hierarchy:** Use Windsor for the \\\"hook\\\" and Ano for the \\\"details.\\\"\\n\\n---\\n\\n## 3. Color Palette\\nThe Olipop palette is rooted in a deep \\\"Hunter Green\\\" and a \\\"Citron Yellow,\\\" supported by vibrant, fruit-inspired \\\"flavor colors.\\\"\\n\\n### **Primary Brand Colors**\\n*   **Hunter Green (`#14433D`):** The core brand color. Deep, sophisticated, and earthy. Used for primary text, backgrounds, and buttons.\\n*   **Citron Yellow (`#FFFF7D`):** A bright, \\\"highlighter\\\" yellow. Used for high-attention call-outs and primary buttons.\\n*   **Electric Citron (`#E2EB28`):** The hover-state/accent yellow. Even more vibrant than the base Citron.\\n*   **Off-White/Body Background (`#FFFFFF`):** Clean, crisp white for readability.\\n*   **Charcoal/Body Text (`#333232`):** Used for standard body text to keep contrast softer than pure black.\\n\\n### **Functional Colors**\\n*   **Sale Red (`#FA4545`):** Used strictly for \\\"Sale\\\" labels or urgent price call-outs.\\n*   **Success Green (`#1F873D`):** Used for positive reinforcement or health claims.\\n\\n---\\n\\n## 4. Visual Elements & Layout\\n\\n### **The \\\"Wave\\\" Separator**\\nOlipop frequently uses organic, \\\"wavy\\\" lines to separate sections rather than straight horizontal lines. \\n*   **Style:** Thick, smooth curves.\\n*   **Context:** Use these to transition between an image and a solid color block to give the ad a liquid, soda-like flow.\\n\\n### **Buttons & CTAs**\\n*   **Shape:** \\\"Pill-shaped\\\" (High border-radius: `3.125rem`).\\n*   **Style:** Bold background color (usually Citron Yellow or Hunter Green) with centered, bold Ano text.\\n*   **Padding:** Generous horizontal padding to give the button a \\\"fat,\\\" premium feel.\\n\\n### **Graphic Details**\\n*   **Shadows:** Use light, soft shadows for UI elements (like cards or badges).\\n*   **Badges:** Olipop uses circular or starburst badges for \\\"9g Fiber\\\" or \\\"Prebiotic\\\" claims.\\n*   **Borders:** Subtle, light-colored borders (`#EBEBEB` or `#F3E4CD`) are used to define product tiles or variety packs.\\n\\n---\\n\\n## 5. Imagery & Photography\\n*   **Product Heroes:** The 12oz can is the star. Use high-resolution \\\"hero\\\" shots where the can is front and center.\\n*   **Ambient Retail:** Olipop is a physical product; imagery often includes the can in \\\"real world\\\" settings (grocery shelves, picnic tables, hands holding the can).\\n*   **Vibe:** Bright, natural lighting. Avoid dark or moody \\\"premium liquor\\\" style lighting. It should feel like a sunny afternoon.\\n\\n---\\n\\n## 6. Messaging Hierarchy\\n1.  **The Hook:** Big, bold Windsor headline (e.g., \\\"SODA IS BACK\\\").\\n2.  **The Benefit:** Clean Ano subheader (e.g., \\\"9g of Fiber. Low Sugar. Prebiotics.\\\").\\n3.  **The Action:** High-contrast pill-shaped button (e.g., \\\"SHOP VARIETY PACK\\\").\\n\\n---\\n\\n### **Note for Designers**\\nThis guide is intended to ensure brand consistency, not to restrict creativity.\\n*   **Context is Key:** You do not need to use every pointer in every ad. For example, if an ad is meant to be a minimal product shot for Instagram Stories, you might skip the \\\"Wave\\\" separator to maintain focus on the can.\\n*   **Mascots/Icons:** If specific icons or mascots are mentioned (like the check-symbol or specific fruit illustrations), only use them if the contextual direction of the ad requires it.\\n*   **Adaptability:** If a specific font or hex code makes a mobile ad unreadable, prioritize legibility and the \\\"feeling\\\" of the brand over strict adherence to the CSS values.\",\"sourceJobId\":\"5f725089-652c-4412-a655-f18bf7a6272e\",\"referenceAdDesignImages\":[]}}},{\"result\":{\"data\":{\"id\":\"6442dc69-08c3-4b2d-ba24-2d75074cfe05\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"55336a61-ed44-47da-8a4b-bb3de1ed770c\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"OLIPOP Classic Grape (9g Fiber)\",\"slug\":\"untitled-product-12\",\"sourceUrl\":\"https://drinkolipop.com/products/classic-grape\",\"status\":\"draft\",\"ingestionTriggerRunId\":\"run_06g0tcpe7bcg89jvvmq8pj4701\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"generating\",\"visualDescriptionTriggerRunId\":\"run_06g0td3c699j3385vq23fe6m01\",\"visualDescriptionImageFingerprint\":\"75grr6\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"OLIPOP\",\"fiber\":\"9g\",\"flavor\":\"Classic Grape\",\"images\":[\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044959-75d02dc6-ee4a-4327-9a07-2a07af4ac4f7.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044988-c90d0c25-e013-4033-b7c5-c3edffdaa39e.png\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044871-a5a86616-92ae-4852-bad3-177faba13db5.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044884-4c2f0ce1-057a-4724-915f-95d54302022d.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044976-bb2130ff-2b33-41e7-b49f-b09615e45f61.png\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953045062-bbfc62a4-c529-4fd2-b8ad-f2c0fe483477.jpg\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953045003-56a3e828-5361-4af0-8f80-68bc471a5168.png\"],\"sugars\":\"5g\",\"calories\":50,\"fiberLine\":\"9g Fiber Line\",\"description\":\"Sweet-tart concord grape juice, kissed with lime. Our original refrigerated formula, with higher fiber per can to get more out of every sip.\",\"hasNSFWRisk\":false,\"ingredients\":[\"Carbonated Water\",\"OLISMART (Cassava Root Fiber, Chicory Root Inulin, Jerusalem Artichoke Inulin, Nopal Cactus, Marshmallow Root, Calendula Flower, Kudzu Root)\",\"Concord Grape Juice Concentrate\",\"Cassava Root Syrup\",\"Apple Juice Concentrate\",\"Tartaric Acid (From Grapes)\",\"Quince Juice Concentrate\",\"Lime Juice Concentrate\",\"Stevia Leaf\",\"Himalayan Pink Salt\",\"Natural Flavors\"],\"taxonomyTag\":\"product:beverage:soda\",\"juiceContent\":\"10% Juice\",\"dietaryClaims\":[\"Less Sugar\",\"Digestive Health Support\",\"Vegan\",\"Gluten Free\",\"Non-GMO\"],\"variantSummary\":{\"count\":2,\"attributes\":{\"packSize\":[\"12 Pack\"],\"purchaseType\":[\"One-Time\",\"Subscription\"]}},\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Upgrade / Optimization\",\"reason\":\"OLIPOP acts as a functional, better-for-you upgrade to traditional high-sugar soda, letting consumers enjoy a nostalgic grape flavor with significantly optimized health benefits like 9g of prebiotic fiber and only 5g of sugar.\"},\"secondaryArchetypes\":[{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily beverage choice, this product is designed to easily slot into a consumer's recurring grocery routine or subscription model to replace unhealthy daily soda habits.\"},{\"name\":\"Problem Solver\",\"reason\":\"It addresses the specific issue of low dietary fiber and digestive discomfort while also solving the consumer craving for a sweet, fizzy drink without a subsequent sugar crash.\"},{\"name\":\"Values / Belief\",\"reason\":\"The product appeals to health-conscious buyers who actively prioritize gut health, clean ingredients, and dietary choices such as vegan, gluten-free, and non-GMO lifestyles.\"}]},\"storageInstructions\":\"Keep refrigerated\",\"nutritionalHighlights\":10},\"normalizedSummary\":{\"summary\":\"A nostalgic grape soda made with real concord grape juice and a hint of lime, featuring 9g of prebiotic fiber to support digestive health.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-17T07:50:17.983Z\",\"updatedAt\":\"2026-08-17T07:51:40.459Z\",\"parentOffering\":null,\"variants\":[{\"id\":\"3569cd7f-5d77-49c0-8d9f-5c7f140132e7\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"55336a61-ed44-47da-8a4b-bb3de1ed770c\",\"parentOfferingId\":\"6442dc69-08c3-4b2d-ba24-2d75074cfe05\",\"offeringType\":\"variant\",\"kind\":\"physical\",\"name\":\"OLIPOP Classic Grape (9g Fiber) - 12 Pack (One Time)\",\"slug\":\"untitled-product-12-packsize-12-pack-purchasetype-one-time\",\"sourceUrl\":\"https://drinkolipop.com/products/classic-grape\",\"status\":\"draft\",\"ingestionTriggerRunId\":null,\"imageIngestionStatus\":null,\"visualDescriptionStatus\":null,\"visualDescr