          "content": {
            "size": 2844,
            "mimeType": "application/json",
            "text": "[{\"result\":{\"data\":{\"id\":\"1f2b2ee9-7d96-4abe-8752-81e410b877c6\",\"title\":\"Marcus, The Microbiome Optimizer\",\"payload\":{\"cohort_id\":\"AUD_02_GUT_HEALTH_OPTIMIZER\",\"cohort_name\":\"The Gut Health Optimizer\",\"persona_tagged_name\":\"Marcus, The Microbiome Optimizer\",\"demographic_anchor\":\"25-45, active lifestyle, into functional medicine, biohacking, or gut health trends\",\"core_motivation\":\"I struggle to hit my daily fiber target and hate drinking chalky fiber powders, so I want an easy, delicious way to support my digestive health and keep bloating at bay.\",\"use_case\":\"Drinking a daily can of refrigerated prebiotics as a functional supplement alongside lunch or post-workout.\",\"triggering_event\":\"Experiencing uncomfortable afternoon bloating and realizing their low-fiber diet is catching up with them.\",\"jobs_to_be_done\":{\"functional\":\"Deliver 9g of prebiotic fiber to support healthy digestion in a fast, ready-to-drink beverage.\",\"emotional\":\"Feel proactive and in control of gut health without feeling like they are taking a medical treatment.\",\"social_identity\":\"A highly informed, wellness-forward individual who values functional nutrition and high-quality ingredients.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Problem Aware\",\"awareness_description\":\"They know they have digestive issues and need more fiber/prebiotics, but don't know they can get a massive 9g dose through a refreshing soda.\",\"market_sophistication\":\"Level 4\",\"sophistication_description\":\"They have tried fiber supplements, kombuchas, and probiotic pills, but hate the taste, prep work, or sugar content in retail kombucha.\",\"required_unique_mechanism\":\"The proprietary OLISMART prebiotic blend including cassava root, chicory, and Jerusalem artichoke delivering an unprecedented 9g of gut-supporting fiber in a refrigerated canned format.\"},\"resistance_and_friction\":{\"internal_objection\":\"Will 9g of fiber in one soda give me instant gas, cramps, or stomach distress?\",\"external_objection\":\"Does this actually do anything for my gut health, or is the prebiotic marketing just a gimmick?\",\"partner_objection\":\"You don't need fancy prebiotic sodas, just eat more broccoli and take a cheap probiotic pill.\",\"switching_cost\":\"Replacing daily kombucha runs or fiber supplement powders with an OLIPOP subscription.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"prebiotics\",\"9g fiber\",\"digestive support\",\"microbiome\",\"bloat-free\",\"OLISMART\",\"refrigerated\"],\"taboo_words\":[\"sugary pop\",\"junk food\",\"laxative\",\"synthetic vitamins\",\"diet drink\"]},\"audience_size\":{\"reach_tier\":\"focused\",\"audience_share\":30,\"sizing_rationale\":\"Wellness consumers hyper-focused on gut health and prebiotic fiber are a fast-growing, highly motivated, high-LTV segment.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-17T07:51:20.778Z\",\"updatedAt\":\"2026-08-17T07:51:47.568Z\"}}}]"
          },
