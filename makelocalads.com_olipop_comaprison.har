          "cookies": [],
          "content": {
            "size": 8862,
            "mimeType": "application/json",
            "text": "[{\"result\":{\"data\":{\"active\":[{\"id\":\"7e4a4f76-d77c-4363-b545-fc9c6e2c7b06\",\"title\":\"Sarah, The Nostalgia Seeker\",\"payload\":{\"cohort_id\":\"AUD_01_NOSTALGIC_SODA_LOVER\",\"cohort_name\":\"The Nostalgic Soda Lover\",\"persona_tagged_name\":\"Sarah, The Nostalgia Seeker\",\"demographic_anchor\":\"Late 20s to Early 40s, working professional or parent, loves retro comfort food but prioritizes wellness\",\"core_motivation\":\"I miss the sweet, bubbly taste of grape soda from my childhood, but I refuse to drink 40 grams of toxic sugar that makes me crash.\",\"use_case\":\"Replacing traditional afternoon soda breaks with a cold, guilt-free grape can from the office or home fridge.\",\"triggering_event\":\"Having an intense craving for childhood grape soda during a stressful workday afternoon, looking at a regular soda label, and feeling disgusted by the sugar count.\",\"jobs_to_be_done\":{\"functional\":\"Satisfy a sweet-tart grape soda craving with 95% less sugar and added fiber benefit.\",\"emotional\":\"Feel the comfort and joy of childhood nostalgia without the post-sugar guilt or physical crash.\",\"social_identity\":\"A conscious consumer who enjoys fun treats without sacrificing health standards.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Solution Aware\",\"awareness_description\":\"They know healthy soda alternatives exist but haven't found a grape flavor that actually mimics the authentic childhood taste they crave.\",\"market_sophistication\":\"Level 3\",\"sophistication_description\":\"They have tried various zero-sugar sodas or sparkling waters but found them chemically sweet, tasteless, or flat.\",\"required_unique_mechanism\":\"Real concord grape juice concentrate and natural sweetness from stevia blended with the OLISMART prebiotic mix, delivering 9g of fiber in a crisp, refrigerated formula.\"},\"resistance_and_friction\":{\"internal_objection\":\"I bet this will taste artificial, watery, or leave a weird stevia aftertaste in my mouth.\",\"external_objection\":\"This brand is quite expensive for a single can of soda compared to a regular 12-pack of Welch's or Sprite.\",\"partner_objection\":\"Why are you spending so much money on fancy gut-health soda when we have regular sparkling water in the pantry?\",\"switching_cost\":\"Letting go of cheap store-bought sodas and making room in the fridge for a premium refrigerated beverage.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"nostalgia\",\"classic grape\",\"guilt-free\",\"sweet-tart\",\"refrigerated\",\"childhood favorite\"],\"taboo_words\":[\"diet soda\",\"chemical sweetener\",\"aspartame\",\"boring water\",\"restriction\"]},\"audience_size\":{\"reach_tier\":\"broad\",\"audience_share\":45,\"sizing_rationale\":\"A massive segment of millennials and gen-Z consumers actively look to replace sugary sodas of their youth with healthier modern equivalents.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-17T07:51:20.778Z\",\"updatedAt\":\"2026-08-17T07:51:45.460Z\"},{\"id\":\"1f2b2ee9-7d96-4abe-8752-81e410b877c6\",\"title\":\"Marcus, The Microbiome Optimizer\",\"payload\":{\"cohort_id\":\"AUD_02_GUT_HEALTH_OPTIMIZER\",\"cohort_name\":\"The Gut Health Optimizer\",\"persona_tagged_name\":\"Marcus, The Microbiome Optimizer\",\"demographic_anchor\":\"25-45, active lifestyle, into functional medicine, biohacking, or gut health trends\",\"core_motivation\":\"I struggle to hit my daily fiber target and hate drinking chalky fiber powders, so I want an easy, delicious way to support my digestive health and keep bloating at bay.\",\"use_case\":\"Drinking a daily can of refrigerated prebiotics as a functional supplement alongside lunch or post-workout.\",\"triggering_event\":\"Experiencing uncomfortable afternoon bloating and realizing their low-fiber diet is catching up with them.\",\"jobs_to_be_done\":{\"functional\":\"Deliver 9g of prebiotic fiber to support healthy digestion in a fast, ready-to-drink beverage.\",\"emotional\":\"Feel proactive and in control of gut health without feeling like they are taking a medical treatment.\",\"social_identity\":\"A highly informed, wellness-forward individual who values functional nutrition and high-quality ingredients.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Problem Aware\",\"awareness_description\":\"They know they have digestive issues and need more fiber/prebiotics, but don't know they can get a massive 9g dose through a refreshing soda.\",\"market_sophistication\":\"Level 4\",\"sophistication_description\":\"They have tried fiber supplements, kombuchas, and probiotic pills, but hate the taste, prep work, or sugar content in retail kombucha.\",\"required_unique_mechanism\":\"The proprietary OLISMART prebiotic blend including cassava root, chicory, and Jerusalem artichoke delivering an unprecedented 9g of gut-supporting fiber in a refrigerated canned format.\"},\"resistance_and_friction\":{\"internal_objection\":\"Will 9g of fiber in one soda give me instant gas, cramps, or stomach distress?\",\"external_objection\":\"Does this actually do anything for my gut health, or is the prebiotic marketing just a gimmick?\",\"partner_objection\":\"You don't need fancy prebiotic sodas, just eat more broccoli and take a cheap probiotic pill.\",\"switching_cost\":\"Replacing daily kombucha runs or fiber supplement powders with an OLIPOP subscription.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"prebiotics\",\"9g fiber\",\"digestive support\",\"microbiome\",\"bloat-free\",\"OLISMART\",\"refrigerated\"],\"taboo_words\":[\"sugary pop\",\"junk food\",\"laxative\",\"synthetic vitamins\",\"diet drink\"]},\"audience_size\":{\"reach_tier\":\"focused\",\"audience_share\":30,\"sizing_rationale\":\"Wellness consumers hyper-focused on gut health and prebiotic fiber are a fast-growing, highly motivated, high-LTV segment.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-17T07:51:20.778Z\",\"updatedAt\":\"2026-08-17T07:51:47.568Z\"},{\"id\":\"2792c764-a258-4356-b9f3-e314fad07819\",\"title\":\"Elena, The Mindful Host\",\"payload\":{\"cohort_id\":\"AUD_03_SOBER_CURIOUS_SOCIALITE\",\"cohort_name\":\"The Clean-Label Social Drinker\",\"persona_tagged_name\":\"Elena, The Mindful Host\",\"demographic_anchor\":\"22-38, city dweller, values socializing, fitness, clean ingredients, often sober-curious or limiting alcohol\",\"core_motivation\":\"I want a sophisticated, delicious, fizzy drink to hold and sip at parties or while winding down at night that isn't loaded with alcohol or simple syrup.\",\"use_case\":\"Pouring a chilled grape prebiotic soda into a wine glass with a splash of lime as an evening wind-down ritual or party mocktail.\",\"triggering_event\":\"Attending a social gathering or hosting friends and realizing the only non-alcoholic options are boring flat tap water or ultra-sugary kid juices.\",\"jobs_to_be_done\":{\"functional\":\"Provide a complex, sweet-tart sparkling drink that acts as a premium, low-sugar alternative to alcohol or heavy mocktails.\",\"emotional\":\"Feel relaxed, included, and celebratory during social hours without compromising physical health or morning clarity.\",\"social_identity\":\"A trendy, health-conscious tastemaker who curates clean, beautiful experiences for themselves and their friends.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Product Aware\",\"awareness_description\":\"They know OLIPOP but haven't thought of the Classic Grape flavor as a premium, tart, sophisticated mocktail base.\",\"market_sophistication\":\"Level 3\",\"sophistication_description\":\"They've bought sparkling waters and standard mocktail cans but find them either completely unsweetened or ridiculously high in calories.\",\"required_unique_mechanism\":\"A rich, complex profile from real concord grape, quince, and lime juice concentrates combined with functional gut benefits, elevating it beyond empty-calorie mixers.\"},\"resistance_and_friction\":{\"internal_objection\":\"Grape flavor feels a bit childish; is this actually going to feel elegant or just taste like a kid's juice box?\",\"external_objection\":\"Can a gut-health soda really replace the complex botanical experience of a high-end non-alcoholic spirit?\",\"partner_objection\":\"Why are we stocking the bar with prebiotic sodas instead of standard mixers everyone knows?\",\"switching_cost\":\"Ditching standard alcoholic or high-sugar sodas/mixers for a healthier, functional alternative at social gatherings.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"concord grape\",\"mocktail\",\"kissed with lime\",\"sophisticated fizz\",\"evening ritual\",\"clean swap\"],\"taboo_words\":[\"health supplement\",\"medicinal\",\"kids drink\",\"diet pop\",\"detox\"]},\"audience_size\":{\"reach_tier\":\"focused\",\"audience_share\":25,\"sizing_rationale\":\"The sober-curious and mindful drinking movement is massive among young urban professionals seeking stylish, low-sugar alternatives.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-17T07:51:20.778Z\",\"updatedAt\":\"2026-08-17T07:51:49.713Z\"}],\"recommended\":[],\"recommendationGeneration\":{\"status\":\"ready\",\"triggerRunId\":\"run_06g0tcto6uk3hhb4q6jrhknm01\",\"startedAt\":\"2026-08-17T07:50:54.683Z\",\"completedAt\":\"2026-08-17T07:51:22.755Z\",\"error\":null}}}}]"
