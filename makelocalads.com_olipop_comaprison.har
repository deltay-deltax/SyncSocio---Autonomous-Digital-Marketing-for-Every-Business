            "text": "[{\"result\":{\"data\":{\"offeringId\":\"6442dc69-08c3-4b2d-ba24-2d75074cfe05\",\"variantCount\":2,\"draft\":{\"name\":\"OLIPOP Classic Grape (9g Fiber)\",\"kind\":\"physical\",\"summary\":\"A nostalgic grape soda made with real concord grape juice and a hint of lime, featuring 9g of prebiotic fiber to support digestive health.\",\"productTruth\":{\"brand\":\"OLIPOP\",\"fiber\":\"9g\",\"flavor\":\"Classic Grape\",\"images\":[\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044959-75d02dc6-ee4a-4327-9a07-2a07af4ac4f7.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044988-c90d0c25-e013-4033-b7c5-c3edffdaa39e.png\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044871-a5a86616-92ae-4852-bad3-177faba13db5.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044884-4c2f0ce1-057a-4724-915f-95d54302022d.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044976-bb2130ff-2b33-41e7-b49f-b09615e45f61.png\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953045062-bbfc62a4-c529-4fd2-b8ad-f2c0fe483477.jpg\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953045003-56a3e828-5361-4af0-8f80-68bc471a5168.png\"],\"sugars\":\"5g\",\"calories\":50,\"fiberLine\":\"9g Fiber Line\",\"description\":\"Sweet-tart concord grape juice, kissed with lime. Our original refrigerated formula, with higher fiber per can to get more out of every sip.\",\"hasNSFWRisk\":false,\"ingredients\":[\"Carbonated Water\",\"OLISMART (Cassava Root Fiber, Chicory Root Inulin, Jerusalem Artichoke Inulin, Nopal Cactus, Marshmallow Root, Calendula Flower, Kudzu Root)\",\"Concord Grape Juice Concentrate\",\"Cassava Root Syrup\",\"Apple Juice Concentrate\",\"Tartaric Acid (From Grapes)\",\"Quince Juice Concentrate\",\"Lime Juice Concentrate\",\"Stevia Leaf\",\"Himalayan Pink Salt\",\"Natural Flavors\"],\"taxonomyTag\":\"product:beverage:soda\",\"juiceContent\":\"10% Juice\",\"dietaryClaims\":[\"Less Sugar\",\"Digestive Health Support\",\"Vegan\",\"Gluten Free\",\"Non-GMO\"],\"variantSummary\":{\"count\":2,\"attributes\":{\"packSize\":[\"12 Pack\"],\"purchaseType\":[\"One-Time\",\"Subscription\"]}},\"storageInstructions\":\"Keep refrigerated\",\"nutritionalHighlights\":10,\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Upgrade / Optimization\",\"reason\":\"OLIPOP acts as a functional, better-for-you upgrade to traditional high-sugar soda, letting consumers enjoy a nostalgic grape flavor with significantly optimized health benefits like 9g of prebiotic fiber and only 5g of sugar.\"},\"secondaryArchetypes\":[{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily beverage choice, this product is designed to easily slot into a consumer's recurring grocery routine or subscription model to replace unhealthy daily soda habits.\"},{\"name\":\"Problem Solver\",\"reason\":\"It addresses the specific issue of low dietary fiber and digestive discomfort while also solving the consumer craving for a sweet, fizzy drink without a subsequent sugar crash.\"},{\"name\":\"Values / Belief\",\"reason\":\"The product appeals to health-conscious buyers who actively prioritize gut health, clean ingredients, and dietary choices such as vegan, gluten-free, and non-GMO lifestyles.\"}]}},\"variants\":[{\"brand\":\"OLIPOP\",\"fiber\":\"9g\",\"flavor\":\"Classic Grape\",\"images\":[\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044959-75d02dc6-ee4a-4327-9a07-2a07af4ac4f7.webp\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/1786953044988-c90d0c25-e013-4033-b7c5-c3edffdaa39e.png\",\"https://localads.t3.storage.dev/product-images/6442dc69-08c3-4b2d-ba24-2d75074cfe05/178695304487