            "text": "[{\"result\":{\"data\":[{\"id\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"name\":\"Snique\",\"slug\":\"snique\",\"websiteUrl\":\"https://snique.in/\",\"brandProfile\":{\"logoUrl\":\"https://localads.t3.storage.dev/brand-logos/78371df6-ec93-4a25-abd7-c7eaeff1f406/76f7727e-de2d-47fb-bc9c-c4417db4975c.png\",\"logoStatus\":\"ready\",\"logoSourceUrl\":\"https://snique.in/cdn/shop/files/snique-header-logo.svg?v=1767779351&width=600\",\"sellingCountries\":[\"IN\"]},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T17:49:53.829Z\",\"updatedAt\":\"2026-08-15T17:50:26.875Z\"}]}},{\"result\":{\"data\":{\"active\":true,\"state\":\"starter\",\"hadPriorSubscription\":true,\"isOrgOwner\":true,\"limits\":{\"maxBrands\":3,\"maxOfferings\":10,\"canGenerate\":\"credits\",\"creativesPerAngle\":null,\"locked\":[],\"credits\":150},\"plan\":{\"slug\":\"starter\",\"label\":\"Starter\",\"creditsPerCycle\":150,\"currentPeriodEnd\":\"2026-08-22T16:50:08.915Z\",\"status\":\"active\",\"trialEndsAt\":\"2026-08-22T16:50:08.915Z\",\"isTrialing\":true,\"cancelAtPeriodEnd\":false,\"isManual\":false},\"plans\":{\"starter\":{\"slug\":\"starter\",\"label\":\"Starter\",\"credits\":150,\"usd\":49,\"maxBrands\":3,\"maxOfferings\":10},\"pro\":{\"slug\":\"pro\",\"label\":\"Pro\",\"credits\":400,\"usd\":99,\"maxBrands\":10,\"maxOfferings\":50}}}}},{\"result\":{\"data\":{\"summary\":{\"availableCredits\":118,\"allottedCredits\":150,\"usedCredits\":32,\"manualAllotted\":0,\"subscriptionAllotted\":150,\"cycleUsedCredits\":32},\"allotments\":[{\"id\":\"66d8a1e3-21e8-4d0e-af3e-1d1a60db572b\",\"creditDelta\":150,\"description\":\"Starter plan: 150 credits\",\"createdAt\":\"2026-08-15T16:50:15.279Z\"}],\"dailyUsage\":[{\"date\":\"2026-08-15\",\"credits\":32}]}}},{\"result\":{\"data\":{\"unlocked\":true,\"linkToken\":\"e5d84efcb5321ded4850b2519f4a09c069def32729beeb26\",\"rewards\":[],\"linkUrl\":\"https://makelocalads.com/r/e5d84efcb5321ded4850b2519f4a09c069def32729beeb26\"}}},{\"result\":{\"data\":{\"unreadCount\":0,\"preferences\":{\"emailEnabled\":true},\"items\":[{\"id\":\"7eaa2110-48da-4295-a09c-b9511d679e8e\",\"type\":\"design_guide_ready\",\"title\":\"Snique is ready\",\"body\":\"Your brand is created and its design guide is set up. Review it, append your own suggestions, or remove anything that doesn't fit.\",\"href\":\"/app/guide?brandId=78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"severity\":\"success\",\"metadata\":{\"brandId\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"jobStatus\":\"completed\",\"urlSnapshotJobId\":\"585a0bd1-989a-4fac-b835-97c4b66b67a5\"},\"readAt\":\"2026-08-15T17:55:06.764Z\",\"emailedAt\":null,\"createdAt\":\"2026-08-15T17:50:43.451Z\"},{\"id\":\"d58cf93b-4958-4126-8ac4-7a1d36dbd0c9\",\"type\":\"design_guide_ready\",\"title\":\"EssenRoots is ready\",\"body\":\"Your brand is created and its design guide is set up. Review it, append your own suggestions, or remove anything that doesn't fit.\",\"href\":\"/app/guide?brandId=32fa1d3d-9b2a-43e0-a393-7a3e95511f54\",\"severity\":\"success\",\"metadata\":{\"brandId\":\"32fa1d3d-9b2a-43e0-a393-7a3e95511f54\",\"jobStatus\":\"completed\",\"urlSnapshotJobId\":\"2663a276-57cb-4818-a78c-a406efc0f353\"},\"readAt\":\"2026-08-15T17:04:15.339Z\",\"emailedAt\":null,\"createdAt\":\"2026-08-15T16:49:01.706Z\"}]}}},{\"result\":{\"data\":[{\"id\":\"6ff58a5f-f626-4006-94f2-50ef9146b4c1\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"SNIQUE Bakuchi Matte Hydrator Moisturizer\",\"slug\":\"untitled-product-3\",\"sourceUrl\":\"https://snique.in/products/bakuchi-matte-hydrator-moisturizer\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0d66c6le15s0aecim2p4h01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0d6mdaqnd2jc8vsu319am01\",\"visualDescriptionImageFingerprint\":\"1mih5ml\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"SNIQUE\",\"price\":\"Rs. 299.00\",\"images\":[\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107038-d935f726-a8cf-41f6-a859-ab4a7cb93726.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817106979-65b221af-02a0-44a3-9c5d-20a042a8be8b.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107028-79453fe4-9e1b-4fb0-9f73-badb5f69ca8d.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107296-786ccf2e-53bb-4db0-8678-42041a57ce9e.png\"],\"caution\":\"For external use only. Avoid contact with the eyes. Patch test recommended. Discontinue if irritation occurs. Keep out of children’s reach.\",\"storage\":\"Store in a cool & dry place. Keep away from direct sunlight.\",\"howToUse\":\"Apply evenly on cleansed face & neck. Use morning and night. For daytime, follow with sunscreen.\",\"description\":\"Snique Matt Moisturizer is a lightweight, oil-free hydrating gel-cream designed for oily, combination, and acne-prone skin. Powered by Ceramide Complex + Hyaluronic Acid, it restores the skin barrier and locks in moisture without shine. The botanical blend of Cica, Ginseng, Ice Apple, Butterfly Pea Extract & Berry Complex soothes, repairs, and brightens the skin. Bakuchiol, a gentle retinol alternative, helps refine texture and improve clarity, while SEPIMAT™ H10 FW provides a soft-focus matte effect for all-day freshness.\",\"hasNSFWRisk\":false,\"ingredients\":[\"Aqua (Water)\",\"Ceramide Complex (Ceramide NP, Ceramide AP, Ceramide EOP)\",\"Xylitol\",\"Betaine\",\"Sodium Hyaluronate\",\"Caprylic/Capric Triglyceride\",\"Aloe Barbadensis Leaf Extract\",\"Centella Asiatica Extract\",\"Panax Ginseng Root Extract\",\"Ammonium Acryloyldimethyltaurate/Beheneth-25 Methacrylate Crosspolymer (Aristoflex® Silk)\",\"Methyl Methacrylate Crosspolymer (SEPIMAT™ H10 FW)\",\"Phenoxyethanol\",\"Ethylhexylglycerin\",\"Menthyl Lactate\",\"Ice Apple Extract (Borassus Flabellifer)\",\"Inositol\",\"Bakuchiol\",\"Clitoria Ternatea (Butterfly Pea) Flower Extract\",\"Vaccinium spp. Berry Extract Complex\",\"Rosa Canina (Rosehip) Oil\"],\"keyBenefits\":[\"Long-lasting matte finish\",\"Controls excess oil & shine\",\"Deep hydration without greasiness\",\"Strengthens skin barrier with ceramides\",\"Soothes redness and irritation\",\"Refines texture & supports anti-aging\",\"Non-comedogenic gel-cream formula\"],\"taxonomyTag\":\"product:skincare:moisturizer\",\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Problem Solver\",\"reason\":\"This moisturizer specifically targets frustrating skin concerns like excess oil, greasy shine, and acne-prone breakouts with a lightweight, non-comedogenic formula that provides a long-lasting matte finish.\"},\"secondaryArchetypes\":[{\"name\":\"Routine / Replenishment\",\"reason\":\"Designed for essential daily use both morning and night, this product fits naturally into a consumer's recurring skincare habit.\"},{\"name\":\"Upgrade / Optimization\",\"reason\":\"The inclusion of advanced ingredients like a Ceramide Complex and a gentle retinol alternative (Bakuchiol) appeals to users looking to optimize their basic moisturizer for better barrier repair and texture refinement.\"}]},\"visual_description\":\"This skin care product set consists of a 50-gram moisturizer in a cylindrical jar and its corresponding square paperboard carton. The jar features a thick-walled, frosted, semi-translucent pale-blue body—likely made of glass or heavy plastic—topped with a flush-fitting, opaque, matte white cylindrical screw cap. A white adhesive label on the front of the jar displays the text \\\"Bakuchi Matte\\\" over \\\"Hydrator Moisturizer\\\" in a bold, dark gray sans-serif font, underlined by a thin light-blue line, with a left-aligned list of six product benefits and \\\"NET QTY.: 50 gm\\\" at the bottom right. The brand name \\\"sniQue\\\" is printed vertically along the label's right edge in a light-blue stylized typeface. The matching matte-finish outer carton is primarily white with a contrasting solid light-blue band wrapping around the bottom fifth of the box. The front of the carton replicates the jar's typography and vertical brand logo, but adds a horizontal, rounded light-blue capsule printed with \\\"Ceramides + Hyaluronic Acid + Bakuchiol\\\" positioned within the bottom band. The carton's side panels present lists of ingredients, directions, and warnings in dark gray text under light-blue headers, maintaining the clean, two-tone layout.\"},\"normalizedSummary\":{\"summary\":\"A lightweight, oil-free hydrating gel-cream designed for oily, combination, and acne-prone skin, providing a long-lasting matte finish and restoring the skin barrier.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T18:04:31.192Z\",\"updatedAt\":\"2026-08-15T18:07:42.556Z\",\"variantCount\":0,\"creativeCount\":6,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true},{\"id\":\"40a78158-009e-4be2-ba8d-2ef357f1fd04\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"SNIQUE Anti Acne Foaming Facewash\",\"slug\":\"untitled-product-2\",\"sourceUrl\":\"https://snique.in/products/anti-acne-foaming-facewash\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0d410lvl8ehm81tis3k8f01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0d46e3d2j2bj3qemdum1o01\",\"visualDescriptionImageFingerprint\":\"1x6799z\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"SNIQUE\",\"images\":[\"https://localads.t3.storage.dev/product-images/40a78158-009e-4be2-ba8d-2ef357f1fd04/1786816535495-cf3f9bf0-19ca-4cf6-90f7-f88ce9cdf577.png\",\"https://localads.t3.storage.dev/product-images/40a78158-009e-4be2-ba8d-2ef357f1fd04/1786816535537-5b7b72b0-f72e-4fd4-8dc7-55e167fe9ce1.png\",\"https://localads.t3.storage.dev/product-images/40a78158-009e-4be2-ba8d-2ef357f1fd04/1786816535471-6193e147-13dc-41cf-b09d-e1f79cb77943.png\",\"https://localads.t3.storage.dev/product-images/40a78158-009e-4be2-ba8d-2ef357f1fd04/1786816535650-1801c00f-aab6-4107-a16c-a53252d8577b.png\"],\"rating\":4.7,\"caution\":[\"For external use only.\",\"Avoid eye contact; rinse immediately if it occurs.\",\"Do a patch test before first use.\",\"Discontinue if irritation persists.\",\"Keep out of reach of children.\"],\"storage\":\"Store in a cool and dry place. Protect from direct sunlight and heat.\",\"howToUse\":[\"Pump 1–2 times to dispense soft foam.\",\"Massage gently over the damp face in circular motions.\",\"Rinse thoroughly.\",\"Use twice daily.\"],\"salePrice\":\"Rs. 299.00\",\"hasNSFWRisk\":false,\"ingredients\":\"Aqua (Water), Coco Amido Propyl Betaine, Sodium Cocoyl Methyl Taurate, Caprylyl/Capryl Glucoside, Salicylic Acid, Succinic Acid, VeryBerry™ ACNEcare (Water (and) Propanediol (and) Salicylic Acid (and) Sodium Hydroxide (and) Dipotassium Glycyrrhizate (and) Citrus Junos Seed Extract (and) Citrus Unshiu Peel Extract (and) Actinidia Chinensis (Kiwi) Seed Extract (and) Fragaria Chiloensis (Strawberry) Fruit Extract (and) Vitis Vinifera (Grape) Leaf Extract (and) Vitis Vinifera (Grape) Skin Extract (and) Garcinia Mangostana Peel Extract), Phenoxyethanol, Ethylhexylglycerin.\",\"keyBenefits\":[\"Ultra-gentle microfoam cleanses deeply\",\"Removes excess oil & unclogs pores\",\"Helps reduce acne, blackheads & breakouts\",\"Calms redness with soothing botanicals\",\"Suitable for oily, acne-prone & sensitive skin\",\"Non-stripping, pH-balanced formula\"],\"taxonomyTag\":\"product:skincare:facewash\",\"regularPrice\":\"Rs. 599.00\",\"reviewsCount\":3,\"activeComplex\":[\"Salicylic Acid (BHA) - Removes dead skin & clears pores\",\"Succinic Acid - Targets acne-causing bacteria & sebum\",\"VeryBerry™ ACNEcare - Multi-fruit anti-acne complex (Kiwi, Strawberry, Grape, Mangosteen, Yuzu)\",\"Allantoin - Soothes & reduces irritation\"],\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Problem Solver\",\"reason\":\"The product is formulated specifically to target active skin issues, including acne breakouts, excess oil production, and redness, resolving a clear physiological frustration.\"},\"secondaryArchetypes\":[{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily foaming face wash meant to be used twice a day, this is a recurring consumable that integrates directly into a customer's morning and evening hygiene routine.\"},{\"name\":\"Upgrade / Optimization\",\"reason\":\"Formulated with specialized active ingredients like Succinic Acid and VeryBerry™ ACNEcare, it appeals to consumers looking to upgrade from basic cleansers to a more advanced, non-stripping skincare solution.\"}]},\"visual_description\":\"This skincare product set consists of a 150 mL cylindrical foaming face wash bottle and its matching tall, rectangular cardboard outer box, both featuring a clean, minimalist white-and-light-green color palette. The bottle is made of smooth white plastic, capped with a large white foaming pump dispenser nozzle and covered by a clear, translucent cylindrical plastic cap. The bottle's main body is wrapped in a matte white label with a solid light green band at the base, matching the graphics on the rectangular box. On the front of both the bottle and the box, the upper left side displays bold, black sans-serif text reading \\\"Anti-Acne\\\", \\\"Foam Face\\\", and \\\"Wash\\\", followed by the description \\\"Foam That Fights Acne – Gently & Effectively\\\" and a list of benefits (\\\"Clear Skin\\\", \\\"Zero Oil\\\", \\\"Gentle Foam Purity\\\") separated by a thin, horizontal green line. The brand name \\\"sniQue\\\" is printed vertically on the right in a large, stylized, rounded light green lowercase font. At the very bottom, set inside the light green band, a rounded-corner rectangular block contains the text \\\"Salicylic Acid (BHA) + Succinic Acid + Multi-fruit anti-acne complex + Allantoin\\\" in small black sans-serif font. The side panels of the box and back of the bottle display detailed product information, featuring light green section headers such as \\\"Ingredients\\\", \\\"Directions For Use\\\", and \\\"Warnings\\\" followed by dense black text detailing chemical and botanical components, application steps, and safety precautions.\"},\"normalizedSummary\":{\"summary\":\"An ultra-gentle microfoam cleanser formulated with Salicylic Acid and Succinic Acid to fight acne, remove excess oil, and soothe redness without stripping the skin.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T17:55:03.104Z\",\"updatedAt\":\"2026-08-15T17:56:14.292Z\",\"variantCount\":0,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true},{\"id\":\"87972c9f-a792-4e87-ad2f-fb2f744ba4bb\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"SNIQUE Glitter Spray Sunscreen SPF 30+++\",\"slug\":\"untitled-product\",\"sourceUrl\":\"https://snique.in/products/glitter-spray-sunscreen-spf-30\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0d316egrbijqdve3kt6tp01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0d36v1bb27merjauag5j501\",\"visualDescriptionImageFingerprint\":\"u0h028\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"spf\":\"30+++\",\"brand\":\"SNIQUE\",\"claims\":[\"Broad Spectrum Protection\",\"Cosmetic-Grade Glitter\",\"Cruelty-Free\",\"Reef-Safe Formula\",\"Hydrating & Non-Greasy\",\"Dermatologist Tested\"],\"finish\":\"Lightweight, Hydrating, Shimmer Finish\",\"images\":[\"https://localads.t3.storage.dev/product-images/87972c9f-a792-4e87-ad2f-fb2f744ba4bb/1786816273628-82242918-02fb-40e5-9c8c-4dbbd57f8581.png\",\"https://localads.t3.storage.dev/product-images/87972c9f-a792-4e87-ad2f-fb2f744ba4bb/1786816273748-d5a6d055-125e-49ef-8735-bc623d393d21.png\",\"https://localads.t3.storage.dev/product-images/87972c9f-a792-4e87-ad2f-fb2f744ba4bb/1786816273516-8c97ad3e-5b40-45eb-9f42-480a7eb79d21.png\",\"https://localads.t3.storage.dev/product-images/87972c9f-a792-4e87-ad2f-fb2f744ba4bb/1786816273707-097794c3-ed21-42ee-bc02-b5a2ac53ff37.png\"],\"cautions\":[\"For external use only. Avoid contact with the eyes.\",\"Patch test recommended. If irritation occurs, discontinue use.\",\"Keep out of reach of children. Flammable – do not use near heat or open flame.\"],\"howToUse\":\"Shake well before use. Spray generously and evenly 15 minutes before sun exposure. Reapply every 2 hours, after sweating or swimming. Avoid eyes and lips.\",\"subBrand\":\"COANC GlowGuard™\",\"basePrice\":\"Rs. 449.00\",\"netWeight\":\"100 mL / 3.38 fl oz\",\"hasNSFWRisk\":false,\"ingredients\":[\"Aqua (Water)\",\"Ethylhexyl Methoxycinnamate\",\"Homosalate\",\"Octocrylene\",\"Butyl Methoxydibenzoylmethane\",\"Glycerin\",\"Alcohol Denat.\",\"Hyaluronic Acid\",\"Aloe Barbadensis Leaf Extract\",\"Tocopheryl Acetate\",\"Panthenol\",\"Polysorbate 20\",\"Phenoxyethanol\",\"Ethylhexylglycerin\",\"Parfum (Fragrance)\",\"Mica\",\"Titanium Dioxide (for glitter effect)\",\"CI 77891\",\"CI 77491\"],\"keyBenefits\":[\"Broad Spectrum SPF 30+++ | Protects against UVA + UVB rays\",\"Hydrating Formula | With hyaluronic acid & glycerin for lasting moisture\",\"Micro-Shimmer Finish | Cosmetic-grade glitter adds a radiant glow\",\"Ultra-Light Mist | No stickiness, no residue, no white cast\",\"Water & Sweat Resistant | Up to 80 minutes of protection\"],\"taxonomyTag\":\"product:skincare:sunscreen\",\"sunscreenType\":\"Broad-Spectrum UVA/UVB Protection\",\"variantSummary\":{\"count\":1,\"attributes\":{\"spf\":[\"30+++\"],\"brand\":[\"SNIQUE\"],\"finish\":[\"Lightweight, Hydrating, Shimmer Finish\"],\"howToUse\":[\"Shake well before use. Spray generously and evenly 15 minutes before sun exposure. Reapply every 2 hours, after sweating or swimming. Avoid eyes and lips.\"],\"subBrand\":[\"COANC GlowGuard™\"],\"basePrice\":[\"Rs. 449.00\"],\"netWeight\":[\"100 mL / 3.38 fl oz\"],\"variantKey\":[\"100 mL / 3.38 fl oz\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:skincare:sunscreen\"],\"variantLabel\":[\"100 mL / 3.38 fl oz\"],\"sunscreenType\":[\"Broad-Spectrum UVA/UVB Protection\"],\"waterResistance\":[\"80 minutes\"]}},\"waterResistance\":\"80 minutes\",\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Desire / Identity\",\"reason\":\"The inclusion of cosmetic-grade glitter for a micro-shimmer, radiant finish appeals heavily to consumers wanting to enhance their aesthetic appearance, signal style, and feel glowing and attractive.\"},\"secondaryArchetypes\":[{\"name\":\"Risk / Prevention\",\"reason\":\"Despite its cosmetic sparkle, the product serves as an SPF 30+++ broad-spectrum sunscreen protecting the user from harmful UV rays and sunburn.\"},{\"name\":\"Occasion / Event\",\"reason\":\"A glitter sunscreen is highly seasonal and occasion-driven, making it especially appealing for pool parties, beach trips, music festivals, and summer vacations.\"}]},\"visual_description\":\"This product consists of a 100 mL liquid sunscreen housed in a clear cylindrical plastic spray bottle, accompanied by a tall, rectangular cardboard carton. The bottle reveals a vibrant, iridescent coral-pink liquid suspended with fine, light-reflective micro-shimmer glitter, and is fitted with a white spray nozzle assembly under a clear, flush-fitting cylindrical plastic cap. White text is printed directly on the front of the bottle, displaying the product name \\\"Glitter Spray Sunscreen SPF 30+++\\\" above descriptive details (\\\"Hydrating Mist with Sparkle Protection\\\", \\\"Lightweight\\\", \\\"Hydrating\\\", \\\"Shimmer Finish\\\"), with \\\"NET QTY.: 100 ML\\\" positioned at the bottom right. The accompanying carton features a clean, two-toned color block design where the top three-quarters is matte white and the bottom quarter is a solid coral-pink block. A large, stylized, lowercase coral-pink brand logo spelling \\\"snique\\\" wraps around the corner, split vertically down the seam between the front and side panels. The front panel of the carton mirrors the bottle's layout in dark grey text on the white section, and includes a rounded-rectangle badge at the bottom containing \\\"Hyaluronic Acid + Aloe Vera + Vitamin E\\\". The carton's side and back panels display product details, ingredients, directions, and warnings in dark grey text under coral-pink headers on the white portion, with the bottom coral-pink block of one side featuring five white line-art symbols representing recycling, GMP, cruelty-free, 24M, and vegan certifications.\"},\"normalizedSummary\":{\"summary\":\"A multi-functional SPF 30+++ sunscreen mist that protects against UVA/UVB rays, hydrates with hyaluronic acid, and leaves a radiant shimmer finish.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T17:50:42.412Z\",\"updatedAt\":\"2026-08-15T17:52:14.540Z\",\"variantCount\":1,\"creativeCount\":3,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true}]}},{\"result\":{\"data\":[{\"id\":\"6ff58a5f-f626-4006-94f2-50ef9146b4c1\",\"name\":\"SNIQUE Bakuchi Matte Hydrator Moisturizer\",\"status\":\"active\",\"thumbnail\":\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107038-d935f726-a8cf-41f6-a859-ab4a7cb93726.png\",\"createdAt\":\"2026-08-15T18:04:31.192Z\"},{\"id\":\"40a78158-009e-4be2-ba8d-2ef357f1fd04\",\"name\":\"SNIQUE Anti Acne Foaming Facewash\",\"status\":\"active\",\"thumbnail\":\"https://localads.t3.storage.dev/product-images/40a78158-009e-4be2-ba8d-2ef357f1fd04/1786816535495-cf3f9bf0-19ca-4cf6-90f7-f88ce9cdf577.png\",\"createdAt\":\"2026-08-15T17:55:03.104Z\"},{\"id\":\"87972c9f-a792-4e87-ad2f-fb2f744ba4bb\",\"name\":\"SNIQUE Glitter Spray Sunscreen SPF 30+++\",\"status\":\"active\",\"thumbnail\":\"https://localads.t3.storage.dev/product-images/87972c9f-a792-4e87-ad2f-fb2f744ba4bb/1786816273628-82242918-02fb-40e5-9c8c-4dbbd57f8581.png\",\"createdAt\":\"2026-08-15T17:50:42.412Z\"}]}},{\"result\":{\"data\":{\"designGuide\":\"# Brand Design Guide: SNIQUE\\n\\nThis document provides the visual and stylistic standards for SNIQUE. Ad creative designers should refer to these guidelines to ensure all marketing materials maintain a cohesive, premium, and urban aesthetic.\\n\\n---\\n\\n## 1. Brand Essence\\n**SNIQUE** is a modern footwear brand that blends minimalist sophistication with urban energy. The visual style is high-contrast, clean, and structured. It avoids unnecessary clutter, focusing on the product as the hero.\\n\\n---\\n\\n## 2. Color Palette\\nThe SNIQUE color palette is designed for versatility, ranging from stark monochromes to vibrant pops of color for specific campaigns.\\n\\n### Primary Colors (The Core)\\n*   **Midnight Black (#121212):** Used for primary text, backgrounds, and buttons. It is a deep, near-black that feels premium and grounded.\\n*   **Pure White (#FFFFFF):** Used for clean backgrounds and high-contrast text. It provides the \\\"breathable\\\" space essential to the brand’s minimalist look.\\n*   **Cool Gray (#F3F3F3):** A soft, neutral light gray used for secondary sections or background depth without the harshness of pure white.\\n\\n### Accent & Campaign Colors\\n*   **Electric Blue (#334FB4):** A vibrant, high-energy blue. Use this for \\\"hero\\\" ads or when a \\\"tech\\\" or \\\"sporty\\\" vibe is required.\\n*   **Dusty Rose (#CD5E77):** A sophisticated, muted pink/red. This is typically used for lifestyle-oriented creatives or specific product collections.\\n*   **Slate Navy (#242833):** A dark, professional blue-gray used as an alternative to Midnight Black when more depth is needed.\\n\\n### Trust & UI Elements\\n*   **Review Teal (#108474):** This specific teal is reserved for \\\"social proof\\\" elements, such as star ratings, verified buyer badges, and trust indicators.\\n\\n---\\n\\n## 3. Typography\\nThe brand relies exclusively on a clean, geometric sans-serif aesthetic.\\n\\n*   **Primary Font: Jost**\\n    *   **Appearance:** Jost is a modern, functional sans-serif inspired by 1920s German geometry (similar to Futura). It is clean, legible, and feels both timeless and futuristic.\\n    *   **Usage:**\\n        *   **Headings:** Use **Jost Bold (Weight: 700)**. Often looks best in All-Caps for a high-impact, editorial sneaker look.\\n        *   **Body Text:** Use **Jost Regular (Weight: 400)**. Keep line height generous (approx. 1.8) for a premium feel.\\n    *   *Note for Designers:* If Jost is unavailable, use a clean geometric sans-serif like Montserrat, Futura, or Spartan.\\n\\n---\\n\\n## 4. Layout & Shape Language\\nThe \\\"SNIQUE\\\" look is defined by sharp lines and specific corner treatments.\\n\\n*   **Sharp Edges (0px Radius):** Most primary elements—including **buttons, product cards, and image containers**—must have 100% sharp corners. Avoid rounded corners on primary product shots or main CTA buttons.\\n*   **Pill Shapes (Rounded):** Use fully rounded \\\"pill\\\" shapes (40px+ radius) *only* for small UI badges, such as size selection indicators or \\\"New Arrival\\\" tags.\\n*   **Spacing:** Use a tight grid (multiples of 4px or 8px). The brand aesthetic is \\\"compressed and clean\\\"—negative space should be intentional but not sprawling.\\n*   **Contrast:** High contrast is key. Place Midnight Black text on Pure White backgrounds, or vice-versa. Avoid low-contrast overlays.\\n\\n---\\n\\n## 5. Imagery & Product Presentation\\n*   **Product as Hero:** Sneaker photography should be crisp and high-resolution. \\n*   **Backgrounds:** Use solid color blocks (Midnight Black, Pure White, or Cool Gray) to make the product colors pop. \\n*   **Shadows:** Avoid heavy, fuzzy drop shadows. If shadows are used, they should be extremely subtle or \\\"hard\\\" professional studio shadows that ground the shoe on the surface.\\n\\n---\\n\\n## 6. Iconography & Badges\\n*   **Star Ratings:** Use the **Review Teal (#108474)** for star icons.\\n*   **Buttons:** Standard buttons are solid Midnight Black with Pure White text, with a 1px border. They are rectangular (no rounded corners).\\n\\n---\\n\\n## Note to Designers\\nThis document is a foundational guide to the SNIQUE brand identity. It is intended to steer your creative direction, not to act as a rigid checklist for every single asset. \\n\\n**Application of Pointers:**\\n*   **Context over Rules:** If this guide mentions a specific color (like Dusty Rose) or a shape, use it only if it fits the specific ad's direction. For example, a high-performance \\\"tech\\\" sneaker ad should lean into Midnight Black and Electric Blue, likely ignoring the Dusty Rose entirely.\\n*   **Brand Voice:** Always aim for an \\\"Editorial/Streetwear\\\" look. If the design feels too \\\"bubbly\\\" or \\\"soft,\\\" you have likely deviated from the sharp-edged, high-contrast SNIQUE aesthetic.\\n*   **Flexibility:** You are encouraged to use these hex codes and font descriptions to maintain brand recognition while exercising your professional judgment on layout and composition.\",\"sourceJobId\":\"585a0bd1-989a-4fac-b835-97c4b66b67a5\",\"referenceAdDesignImages\":[]}}},{\"result\":{\"data\":{\"id\":\"6ff58a5f-f626-4006-94f2-50ef9146b4c1\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"SNIQUE Bakuchi Matte Hydrator Moisturizer\",\"slug\":\"untitled-product-3\",\"sourceUrl\":\"https://snique.in/products/bakuchi-matte-hydrator-moisturizer\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0d66c6le15s0aecim2p4h01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0d6mdaqnd2jc8vsu319am01\",\"visualDescriptionImageFingerprint\":\"1mih5ml\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"SNIQUE\",\"price\":\"Rs. 299.00\",\"images\":[\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107038-d935f726-a8cf-41f6-a859-ab4a7cb93726.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817106979-65b221af-02a0-44a3-9c5d-20a042a8be8b.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107028-79453fe4-9e1b-4fb0-9f73-badb5f69ca8d.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107296-786ccf2e-53bb-4db0-8678-42041a57ce9e.png\"],\"caution\":\"For external use only. Avoid contact with the eyes. Patch test recommended. Discontinue if irritation occurs. Keep out of children’s reach.\",\"storage\":\"Store in a cool & dry place. Keep away from direct sunlight.\",\"howToUse\":\"Apply evenly on cleansed face & neck. Use morning and night. For daytime, follow with sunscreen.\",\"description\":\"Snique Matt Moisturizer is a lightweight, oil-free hydrating gel-cream designed for oily, combination, and acne-prone skin. Powered by Ceramide Complex + Hyaluronic Acid, it restores the skin barrier and locks in moisture without shine. The botanical blend of Cica, Ginseng, Ice Apple, Butterfly Pea Extract & Berry Complex soothes, repairs, and brightens the skin. Bakuchiol, a gentle retinol alternative, helps refine texture and improve clarity, while SEPIMAT™ H10 FW provides a soft-focus matte effect for all-day freshness.\",\"hasNSFWRisk\":false,\"ingredients\":[\"Aqua (Water)\",\"Ceramide Complex (Ceramide NP, Ceramide AP, Ceramide EOP)\",\"Xylitol\",\"Betaine\",\"Sodium Hyaluronate\",\"Caprylic/Capric Triglyceride\",\"Aloe Barbadensis Leaf Extract\",\"Centella Asiatica Extract\",\"Panax Ginseng Root Extract\",\"Ammonium Acryloyldimethyltaurate/Beheneth-25 Methacrylate Crosspolymer (Aristoflex® Silk)\",\"Methyl Methacrylate Crosspolymer (SEPIMAT™ H10 FW)\",\"Phenoxyethanol\",\"Ethylhexylglycerin\",\"Menthyl Lactate\",\"Ice Apple Extract (Borassus Flabellifer)\",\"Inositol\",\"Bakuchiol\",\"Clitoria Ternatea (Butterfly Pea) Flower Extract\",\"Vaccinium spp. Berry Extract Complex\",\"Rosa Canina (Rosehip) Oil\"],\"keyBenefits\":[\"Long-lasting matte finish\",\"Controls excess oil & shine\",\"Deep hydration without greasiness\",\"Strengthens skin barrier with ceramides\",\"Soothes redness and irritation\",\"Refines texture & supports anti-aging\",\"Non-comedogenic gel-cream formula\"],\"taxonomyTag\":\"product:skincare:moisturizer\",\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Problem Solver\",\"reason\":\"This moisturizer specifically targets frustrating skin concerns like excess oil, greasy shine, and acne-prone breakouts with a lightweight, non-comedogenic formula that provides a long-lasting matte finish.\"},\"secondaryArchetypes\":[{\"name\":\"Routine / Replenishment\",\"reason\":\"Designed for essential daily use both morning and night, this product fits naturally into a consumer's recurring skincare habit.\"},{\"name\":\"Upgrade / Optimization\",\"reason\":\"The inclusion of advanced ingredients like a Ceramide Complex and a gentle retinol alternative (Bakuchiol) appeals to users looking to optimize their basic moisturizer for better barrier repair and texture refinement.\"}]},\"visual_description\":\"This skin care product set consists of a 50-gram moisturizer in a cylindrical jar and its corresponding square paperboard carton. The jar features a thick-walled, frosted, semi-translucent pale-blue body—likely made of glass or heavy plastic—topped with a flush-fitting, opaque, matte white cylindrical screw cap. A white adhesive label on the front of the jar displays the text \\\"Bakuchi Matte\\\" over \\\"Hydrator Moisturizer\\\" in a bold, dark gray sans-serif font, underlined by a thin light-blue line, with a left-aligned list of six product benefits and \\\"NET QTY.: 50 gm\\\" at the bottom right. The brand name \\\"sniQue\\\" is printed vertically along the label's right edge in a light-blue stylized typeface. The matching matte-finish outer carton is primarily white with a contrasting solid light-blue band wrapping around the bottom fifth of the box. The front of the carton replicates the jar's typography and vertical brand logo, but adds a horizontal, rounded light-blue capsule printed with \\\"Ceramides + Hyaluronic Acid + Bakuchiol\\\" positioned within the bottom band. The carton's side panels present lists of ingredients, directions, and warnings in dark gray text under light-blue headers, maintaining the clean, two-tone layout.\"},\"normalizedSummary\":{\"summary\":\"A lightweight, oil-free hydrating gel-cream designed for oily, combination, and acne-prone skin, providing a long-lasting matte finish and restoring the skin barrier.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T18:04:31.192Z\",\"updatedAt\":\"2026-08-15T18:07:42.556Z\",\"parentOffering\":null,\"variants\":[],\"isVariant\":false,\"variantCount\":0,\"generatedCreativeCount\":3,\"hasGeneratedCreatives\":true}}},{\"result\":{\"data\":{\"campaigns\":[{\"id\":\"c8a489f7-db01-44a9-a226-79b7f6cd99e5\",\"name\":\"Get discovered campaign\",\"description\":\"\",\"updatedAt\":\"2026-08-15T18:10:30.762Z\",\"requestedCount\":3,\"creativeCount\":0,\"generationStatus\":\"generating\",\"previews\":[]},{\"id\":\"0e275821-c8b4-4e55-ab79-91c8ad238a55\",\"name\":\"Get discovered campaign\",\"description\":\"\",\"updatedAt\":\"2026-08-15T18:09:55.548Z\",\"requestedCount\":3,\"creativeCount\":3,\"generationStatus\":\"completed\",\"previews\":[{\"id\":\"a24fa848-870a-4c5e-8b30-d5f7fc8beea7\",\"imageUrl\":\"/api/creative-assets/a24fa848-870a-4c5e-8b30-d5f7fc8beea7?versionId=c9f8bf2c-4b5f-43f1-87eb-896c8a92a24e\",\"alt\":\"Get discovered campaign\"},{\"id\":\"587c2cb4-df89-4e17-a340-9cd64a837034\",\"imageUrl\":\"/api/creative-assets/587c2cb4-df89-4e17-a340-9cd64a837034?versionId=02ec2a29-7a83-41a9-85fd-10435dbe957f\",\"alt\":\"Get discovered campaign\"},{\"id\":\"af7b76e4-1c54-49d5-b89e-06c3f30b807f\",\"imageUrl\":\"/api/creative-assets/af7b76e4-1c54-49d5-b89e-06c3f30b807f?versionId=3ac66c56-a669-4401-9ede-788a1c2955d8\",\"alt\":\"Get discovered campaign\"}]}]}}},{\"result\":{\"data\":{\"id\":\"c8a489f7-db01-44a9-a226-79b7f6cd99e5\",\"offeringId\":\"6ff58a5f-f626-4006-94f2-50ef9146b4c1\",\"name\":\"Get discovered campaign\",\"description\":\"\",\"generationStatus\":\"generating\",\"requestedCount\":3,\"activeGenerationJobIds\":[\"dd4a06af-7d96-4bc1-92bf-dec9e866b2d3\"],\"creatives\":[{\"id\":\"c0bbb35f-3f32-47a1-a1ba-3045f9a6e7e0\",\"status\":\"generating\",\"imageUrl\":null},{\"id\":\"a8685ee4-29b9-430e-9c29-bd6cc2173bf9\",\"status\":\"generating\",\"imageUrl\":null},{\"id\":\"e21f3195-1dec-494d-bcc0-a2bc7a75f61e\",\"status\":\"generating\",\"imageUrl\":null}]}}},{\"result\":{\"data\":{\"items\":[{\"id\":\"e21f3195-1dec-494d-bcc0-a2bc7a75f61e\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"offeringId\":\"6ff58a5f-f626-4006-94f2-50ef9146b4c1\",\"strategyRunId\":null,\"generationJobId\":\"dd4a06af-7d96-4bc1-92bf-dec9e866b2d3\",\"triggerRunId\":null,\"audienceNodeId\":null,\"angleNodeId\":null,\"campaignId\":\"c8a489f7-db01-44a9-a226-79b7f6cd99e5\",\"adAudienceId\":null,\"campaignAngleId\":null,\"promptRecipeId\":null,\"currentVersionId\":\"5400d545-a93e-42a4-b3da-6ee164d564c8\",\"storageKey\":null,\"assetUrl\":null,\"thumbnailUrl\":null,\"mimeType\":null,\"width\":null,\"height\":null,\"finalImagePrompt\":null,\"status\":\"generating\",\"downloadCount\":0,\"metadata\":{\"brief\":\"Using the PAS (Problem-Agitate-Solve) framework, this top-of-funnel discovery ad targets the daily frustration of midday facial shine for oily skin types. The visual hero is the problem itself, dramatized by a split-screen high-contrast photographic studio shot: the left half shows a close-up of a person's forehead and nose reflecting heavy, slick oil under harsh urban lighting, while the right half is perfectly matte, clean, and soft-focus. Positioned subtly in the bottom-right corner is the SNIQUE Bakuchi Matte Hydrator Moisturizer jar on a solid, sharp-edged cool gray surface with a hard, realistic cast shadow. The minimal on-image headline in bold, all-caps Jost reads \\\"STOP FEEDING THE MIDDAY GREASE\\\" in Midnight Black, taking up less than 15% of the overall layout. The single call to action is a soft \\\"Learn more\\\" button presented as a solid, sharp-edged Midnight Black rectangle with white text. To keep the ad on-brand, maintain a premium street-editorial vibe using a strict palette of Cool Gray, Midnight Black, and Electric Blue accents, with no rounded corners on any elements and a clean, high-contrast, uncluttered layout.\",\"prompt\":\"Instructions by the director: Using the PAS (Problem-Agitate-Solve) framework, this top-of-funnel discovery ad targets the daily frustration of midday facial shine for oily skin types. The visual hero is the problem itself, dramatized by a split-screen high-contrast photographic studio shot: the left half shows a close-up of a person's forehead and nose reflecting heavy, slick oil under harsh urban lighting, while the right half is perfectly matte, clean, and soft-focus. Positioned subtly in the bottom-right corner is the SNIQUE Bakuchi Matte Hydrator Moisturizer jar on a solid, sharp-edged cool gray surface with a hard, realistic cast shadow. The minimal on-image headline in bold, all-caps Jost reads \\\"STOP FEEDING THE MIDDAY GREASE\\\" in Midnight Black, taking up less than 15% of the overall layout. The single call to action is a soft \\\"Learn more\\\" button presented as a solid, sharp-edged Midnight Black rectangle with white text. To keep the ad on-brand, maintain a premium street-editorial vibe using a strict palette of Cool Gray, Midnight Black, and Electric Blue accents, with no rounded corners on any elements and a clean, high-contrast, uncluttered layout.\\n\\nProduct appearance: This skin care product set consists of a 50-gram moisturizer in a cylindrical jar and its corresponding square paperboard carton. The jar features a thick-walled, frosted, semi-translucent pale-blue body—likely made of glass or heavy plastic—topped with a flush-fitting, opaque, matte white cylindrical screw cap. A white adhesive label on the front of the jar displays the text \\\"Bakuchi Matte\\\" over \\\"Hydrator Moisturizer\\\" in a bold, dark gray sans-serif font, underlined by a thin light-blue line, with a left-aligned list of six product benefits and \\\"NET QTY.: 50 gm\\\" at the bottom right. The brand name \\\"sniQue\\\" is printed vertically along the label's right edge in a light-blue stylized typeface. The matching matte-finish outer carton is primarily white with a contrasting solid light-blue band wrapping around the bottom fifth of the box. The front of the carton replicates the jar's typography and vertical brand logo, but adds a horizontal, rounded light-blue capsule printed with \\\"Ceramides + Hyaluronic Acid + Bakuchiol\\\" positioned within the bottom band. The carton's side panels present lists of ingredients, directions, and warnings in dark gray text under light-blue headers, maintaining the clean, two-tone layout.\\n\\nUse the product appearance text only as a private visual reference for accurately drawing the product. Do not print, quote, paraphrase, label, or turn any of that description into ad copy. Treat orientation-specific details carefully: show front-only details only when the product front is visible; if the brief shows the back, side, top, or an angled view where those details would not be visible, omit them instead of moving them onto the wrong face.\\n\\nThe attached product photos show the real product — reproduce it faithfully.\\n\\nThe final attached image is the official brand logo. Add it once, subtly, in clean negative space; keep it exact, legible, and uncropped.\\n\\nDesign requirements (apply to this ad):\\n- Follow the instructions by the director.\\n- Make the ad design, layout, typography on-branded, but should look premium, editorial-like.\\n- Establish a clear visual hierarchy: one dominant focal point the eye lands on\\n  first, then the supporting message, then the CTA.\\n- Keep strong figure/ground contrast. If text sits over imagery, place a scrim or\\n  overlay behind it so it stays fully legible.\\n- Place the focal subject on a rule-of-thirds line; leave generous whitespace and\\n  avoid clutter.\\n- Use a limited palette anchored to the brand colors (~60-30-10), reserving one\\n  accent color for the call to action.\\n- Keep 20% space all around the creative for the ad to look cleaner\\n- Group and align elements cleanly (Gestalt); use at most two type styles.\",\"source\":\"campaign-creatives\",\"language\":\"English\",\"lastError\":null,\"hasNSFWRisk\":false,\"brandLogoUrl\":\"https://localads.t3.storage.dev/brand-logos/78371df6-ec93-4a25-abd7-c7eaeff1f406/76f7727e-de2d-47fb-bc9c-c4417db4975c.png\",\"imageProvider\":\"openai\",\"productImageUrls\":[\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107038-d935f726-a8cf-41f6-a859-ab4a7cb93726.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817106979-65b221af-02a0-44a3-9c5d-20a042a8be8b.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107028-79453fe4-9e1b-4fb0-9f73-badb5f69ca8d.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107296-786ccf2e-53bb-4db0-8678-42041a57ce9e.png\"],\"visualDescription\":\"This skin care product set consists of a 50-gram moisturizer in a cylindrical jar and its corresponding square paperboard carton. The jar features a thick-walled, frosted, semi-translucent pale-blue body—likely made of glass or heavy plastic—topped with a flush-fitting, opaque, matte white cylindrical screw cap. A white adhesive label on the front of the jar displays the text \\\"Bakuchi Matte\\\" over \\\"Hydrator Moisturizer\\\" in a bold, dark gray sans-serif font, underlined by a thin light-blue line, with a left-aligned list of six product benefits and \\\"NET QTY.: 50 gm\\\" at the bottom right. The brand name \\\"sniQue\\\" is printed vertically along the label's right edge in a light-blue stylized typeface. The matching matte-finish outer carton is primarily white with a contrasting solid light-blue band wrapping around the bottom fifth of the box. The front of the carton replicates the jar's typography and vertical brand logo, but adds a horizontal, rounded light-blue capsule printed with \\\"Ceramides + Hyaluronic Acid + Bakuchiol\\\" positioned within the bottom band. The carton's side panels present lists of ingredients, directions, and warnings in dark gray text under light-blue headers, maintaining the clean, two-tone layout.\",\"referenceImageUrls\":[\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107038-d935f726-a8cf-41f6-a859-ab4a7cb93726.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817106979-65b221af-02a0-44a3-9c5d-20a042a8be8b.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107028-79453fe4-9e1b-4fb0-9f73-badb5f69ca8d.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107296-786ccf2e-53bb-4db0-8678-42041a57ce9e.png\",\"https://localads.t3.storage.dev/brand-logos/78371df6-ec93-4a25-abd7-c7eaeff1f406/76f7727e-de2d-47fb-bc9c-c4417db4975c.png\"],\"referenceAdImageUrls\":[],\"originalReferenceImageUrls\":[\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107038-d935f726-a8cf-41f6-a859-ab4a7cb93726.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817106979-65b221af-02a0-44a3-9c5d-20a042a8be8b.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107028-79453fe4-9e1b-4fb0-9f73-badb5f69ca8d.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107296-786ccf2e-53bb-4db0-8678-42041a57ce9e.png\",\"https://localads.t3.storage.dev/brand-logos/78371df6-ec93-4a25-abd7-c7eaeff1f406/76f7727e-de2d-47fb-bc9c-c4417db4975c.png\"]},\"performanceLabels\":{},\"createdAt\":\"2026-08-15T18:10:30.821Z\",\"versions\":[{\"id\":\"5400d545-a93e-42a4-b3da-6ee164d564c8\",\"creativeId\":\"e21f3195-1dec-494d-bcc0-a2bc7a75f61e\",\"versionNumber\":1,\"parentVersionId\":null,\"generationJobId\":\"dd4a06af-7d96-4bc1-92bf-dec9e866b2d3\",\"triggerRunId\":null,\"changeType\":\"initial\",\"instructions\":null,\"finalImagePrompt\":\"Instructions by the director: Using the PAS (Problem-Agitate-Solve) framework, this top-of-funnel discovery ad targets the daily frustration of midday facial shine for oily skin types. The visual hero is the problem itself, dramatized by a split-screen high-contrast photographic studio shot: the left half shows a close-up of a person's forehead and nose reflecting heavy, slick oil under harsh urban lighting, while the right half is perfectly matte, clean, and soft-focus. Positioned subtly in the bottom-right corner is the SNIQUE Bakuchi Matte Hydrator Moisturizer jar on a solid, sharp-edged cool gray surface with a hard, realistic cast shadow. The minimal on-image headline in bold, all-caps Jost reads \\\"STOP FEEDING THE MIDDAY GREASE\\\" in Midnight Black, taking up less than 15% of the overall layout. The single call to action is a soft \\\"Learn more\\\" button presented as a solid, sharp-edged Midnight Black rectangle with white text. To keep the ad on-brand, maintain a premium street-editorial vibe using a strict palette of Cool Gray, Midnight Black, and Electric Blue accents, with no rounded corners on any elements and a clean, high-contrast, uncluttered layout.\\n\\nProduct appearance: This skin care product set consists of a 50-gram moisturizer in a cylindrical jar and its corresponding square paperboard carton. The jar features a thick-walled, frosted, semi-translucent pale-blue body—likely made of glass or heavy plastic—topped with a flush-fitting, opaque, matte white cylindrical screw cap. A white adhesive label on the front of the jar displays the text \\\"Bakuchi Matte\\\" over \\\"Hydrator Moisturizer\\\" in a bold, dark gray sans-serif font, underlined by a thin light-blue line, with a left-aligned list of six product benefits and \\\"NET QTY.: 50 gm\\\" at the bottom right. The brand name \\\"sniQue\\\" is printed vertically along the label's right edge in a light-blue stylized typeface. The matching matte-finish outer carton is primarily white with a contrasting solid light-blue band wrapping around the bottom fifth of the box. The front of the carton replicates the jar's typography and vertical brand logo, but adds a horizontal, rounded light-blue capsule printed with \\\"Ceramides + Hyaluronic Acid + Bakuchiol\\\" positioned within the bottom band. The carton's side panels present lists of ingredients, directions, and warnings in dark gray text under light-blue headers, maintaining the clean, two-tone layout.\\n\\nUse the product appearance text only as a private visual reference for accurately drawing the product. Do not print, quote, paraphrase, label, or turn any of that description into ad copy. Treat orientation-specific details carefully: show front-only details only when the product front is visible; if the brief shows the back, side, top, or an angled view where those details would not be visible, omit them instead of moving them onto the wrong face.\\n\\nThe attached product photos show the real product — reproduce it faithfully.\\n\\nThe final attached image is the official brand logo. Add it once, subtly, in clean negative space; keep it exact, legible, and uncropped.\\n\\nDesign requirements (apply to this ad):\\n- Follow the instructions by the director.\\n- Make the ad design, layout, typography on-branded, but should look premium, editorial-like.\\n- Establish a clear visual hierarchy: one dominant focal point the eye lands on\\n  first, then the supporting message, then the CTA.\\n- Keep strong figure/ground contrast. If text sits over imagery, place a scrim or\\n  overlay behind it so it stays fully legible.\\n- Place the focal subject on a rule-of-thirds line; leave generous whitespace and\\n  avoid clutter.\\n- Use a limited palette anchored to the brand colors (~60-30-10), reserving one\\n  accent color for the call to action.\\n- Keep 20% space all around the creative for the ad to look cleaner\\n- Group and align elements cleanly (Gestalt); use at most two type styles.\",\"status\":\"generating\",\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"metadata\":{\"brief\":\"Using the PAS (Problem-Agitate-Solve) framework, this top-of-funnel discovery ad targets the daily frustration of midday facial shine for oily skin types. The visual hero is the problem itself, dramatized by a split-screen high-contrast photographic studio shot: the left half shows a close-up of a person's forehead and nose reflecting heavy, slick oil under harsh urban lighting, while the right half is perfectly matte, clean, and soft-focus. Positioned subtly in the bottom-right corner is the SNIQUE Bakuchi Matte Hydrator Moisturizer jar on a solid, sharp-edged cool gray surface with a hard, realistic cast shadow. The minimal on-image headline in bold, all-caps Jost reads \\\"STOP FEEDING THE MIDDAY GREASE\\\" in Midnight Black, taking up less than 15% of the overall layout. The single call to action is a soft \\\"Learn more\\\" button presented as a solid, sharp-edged Midnight Black rectangle with white text. To keep the ad on-brand, maintain a premium street-editorial vibe using a strict palette of Cool Gray, Midnight Black, and Electric Blue accents, with no rounded corners on any elements and a clean, high-contrast, uncluttered layout.\",\"prompt\":\"Instructions by the director: Using the PAS (Problem-Agitate-Solve) framework, this top-of-funnel discovery ad targets the daily frustration of midday facial shine for oily skin types. The visual hero is the problem itself, dramatized by a split-screen high-contrast photographic studio shot: the left half shows a close-up of a person's forehead and nose reflecting heavy, slick oil under harsh urban lighting, while the right half is perfectly matte, clean, and soft-focus. Positioned subtly in the bottom-right corner is the SNIQUE Bakuchi Matte Hydrator Moisturizer jar on a solid, sharp-edged cool gray surface with a hard, realistic cast shadow. The minimal on-image headline in bold, all-caps Jost reads \\\"STOP FEEDING THE MIDDAY GREASE\\\" in Midnight Black, taking up less than 15% of the overall layout. The single call to action is a soft \\\"Learn more\\\" button presented as a solid, sharp-edged Midnight Black rectangle with white text. To keep the ad on-brand, maintain a premium street-editorial vibe using a strict palette of Cool Gray, Midnight Black, and Electric Blue accents, with no rounded corners on any elements and a clean, high-contrast, uncluttered layout.\\n\\nProduct appearance: This skin care product set consists of a 50-gram moisturizer in a cylindrical jar and its corresponding square paperboard carton. The jar features a thick-walled, frosted, semi-translucent pale-blue body—likely made of glass or heavy plastic—topped with a flush-fitting, opaque, matte white cylindrical screw cap. A white adhesive label on the front of the jar displays the text \\\"Bakuchi Matte\\\" over \\\"Hydrator Moisturizer\\\" in a bold, dark gray sans-serif font, underlined by a thin light-blue line, with a left-aligned list of six product benefits and \\\"NET QTY.: 50 gm\\\" at the bottom right. The brand name \\\"sniQue\\\" is printed vertically along the label's right edge in a light-blue stylized typeface. The matching matte-finish outer carton is primarily white with a contrasting solid light-blue band wrapping around the bottom fifth of the box. The front of the carton replicates the jar's typography and vertical brand logo, but adds a horizontal, rounded light-blue capsule printed with \\\"Ceramides + Hyaluronic Acid + Bakuchiol\\\" positioned within the bottom band. The carton's side panels present lists of ingredients, directions, and warnings in dark gray text under light-blue headers, maintaining the clean, two-tone layout.\\n\\nUse the product appearance text only as a private visual reference for accurately drawing the product. Do not print, quote, paraphrase, label, or turn any of that description into ad copy. Treat orientation-specific details carefully: show front-only details only when the product front is visible; if the brief shows the back, side, top, or an angled view where those details would not be visible, omit them instead of moving them onto the wrong face.\\n\\nThe attached product photos show the real product — reproduce it faithfully.\\n\\nThe final attached image is the official brand logo. Add it once, subtly, in clean negative space; keep it exact, legible, and uncropped.\\n\\nDesign requirements (apply to this ad):\\n- Follow the instructions by the director.\\n- Make the ad design, layout, typography on-branded, but should look premium, editorial-like.\\n- Establish a clear visual hierarchy: one dominant focal point the eye lands on\\n  first, then the supporting message, then the CTA.\\n- Keep strong figure/ground contrast. If text sits over imagery, place a scrim or\\n  overlay behind it so it stays fully legible.\\n- Place the focal subject on a rule-of-thirds line; leave generous whitespace and\\n  avoid clutter.\\n- Use a limited palette anchored to the brand colors (~60-30-10), reserving one\\n  accent color for the call to action.\\n- Keep 20% space all around the creative for the ad to look cleaner\\n- Group and align elements cleanly (Gestalt); use at most two type styles.\",\"source\":\"campaign-creatives\",\"language\":\"English\",\"lastError\":null,\"imageModel\":\"openai/gpt-image-2:100\",\"hasNSFWRisk\":false,\"imagePrompt\":\"Instructions by the director: Using the PAS (Problem-Agitate-Solve) framework, this top-of-funnel discovery ad targets the daily frustration of midday facial shine for oily skin types. The visual hero is the problem itself, dramatized by a split-screen high-contrast photographic studio shot: the left half shows a close-up of a person's forehead and nose reflecting heavy, slick oil under harsh urban lighting, while the right half is perfectly matte, clean, and soft-focus. Positioned subtly in the bottom-right corner is the SNIQUE Bakuchi Matte Hydrator Moisturizer jar on a solid, sharp-edged cool gray surface with a hard, realistic cast shadow. The minimal on-image headline in bold, all-caps Jost reads \\\"STOP FEEDING THE MIDDAY GREASE\\\" in Midnight Black, taking up less than 15% of the overall layout. The single call to action is a soft \\\"Learn more\\\" button presented as a solid, sharp-edged Midnight Black rectangle with white text. To keep the ad on-brand, maintain a premium street-editorial vibe using a strict palette of Cool Gray, Midnight Black, and Electric Blue accents, with no rounded corners on any elements and a clean, high-contrast, uncluttered layout.\\n\\nProduct appearance: This skin care product set consists of a 50-gram moisturizer in a cylindrical jar and its corresponding square paperboard carton. The jar features a thick-walled, frosted, semi-translucent pale-blue body—likely made of glass or heavy plastic—topped with a flush-fitting, opaque, matte white cylindrical screw cap. A white adhesive label on the front of the jar displays the text \\\"Bakuchi Matte\\\" over \\\"Hydrator Moisturizer\\\" in a bold, dark gray sans-serif font, underlined by a thin light-blue line, with a left-aligned list of six product benefits and \\\"NET QTY.: 50 gm\\\" at the bottom right. The brand name \\\"sniQue\\\" is printed vertically along the label's right edge in a light-blue stylized typeface. The matching matte-finish outer carton is primarily white with a contrasting solid light-blue band wrapping around the bottom fifth of the box. The front of the carton replicates the jar's typography and vertical brand logo, but adds a horizontal, rounded light-blue capsule printed with \\\"Ceramides + Hyaluronic Acid + Bakuchiol\\\" positioned within the bottom band. The carton's side panels present lists of ingredients, directions, and warnings in dark gray text under light-blue headers, maintaining the clean, two-tone layout.\\n\\nUse the product appearance text only as a private visual reference for accurately drawing the product. Do not print, quote, paraphrase, label, or turn any of that description into ad copy. Treat orientation-specific details carefully: show front-only details only when the product front is visible; if the brief shows the back, side, top, or an angled view where those details would not be visible, omit them instead of moving them onto the wrong face.\\n\\nThe attached product photos show the real product — reproduce it faithfully.\\n\\nThe final attached image is the official brand logo. Add it once, subtly, in clean negative space; keep it exact, legible, and uncropped.\\n\\nDesign requirements (apply to this ad):\\n- Follow the instructions by the director.\\n- Make the ad design, layout, typography on-branded, but should look premium, editorial-like.\\n- Establish a clear visual hierarchy: one dominant focal point the eye lands on\\n  first, then the supporting message, then the CTA.\\n- Keep strong figure/ground contrast. If text sits over imagery, place a scrim or\\n  overlay behind it so it stays fully legible.\\n- Place the focal subject on a rule-of-thirds line; leave generous whitespace and\\n  avoid clutter.\\n- Use a limited palette anchored to the brand colors (~60-30-10), reserving one\\n  accent color for the call to action.\\n- Keep 20% space all around the creative for the ad to look cleaner\\n- Group and align elements cleanly (Gestalt); use at most two type styles.\",\"brandLogoUrl\":\"https://localads.t3.storage.dev/brand-logos/78371df6-ec93-4a25-abd7-c7eaeff1f406/76f7727e-de2d-47fb-bc9c-c4417db4975c.png\",\"imageProvider\":\"openai\",\"productImageUrls\":[\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107038-d935f726-a8cf-41f6-a859-ab4a7cb93726.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817106979-65b221af-02a0-44a3-9c5d-20a042a8be8b.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107028-79453fe4-9e1b-4fb0-9f73-badb5f69ca8d.png\",\"https://localads.t3.storage.dev/product-images/6ff58a5f-f626-4006-94f2-50ef9146b4c1/1786817107296-786ccf2e-53bb-4db0-8678-42041a57ce9e.png\"],\"visualDescription\":\"This skin care product set consists of a 50-gram moisturizer in a cylindrical jar and its corresponding square paperboard carton. The jar features a thick-walled, frosted, semi-translucent pale-blue body—likely made of glass or heavy plastic—topped with a flush-fitting, opaque, matte white cylindrical screw cap. A white adhesive label on the front of the jar displays the text \\\"Bakuchi Matte\\\" over \\\"Hydrator Moisturizer\\\" in a bold, dark gray sans-serif font, underl