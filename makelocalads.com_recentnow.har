          "content": {
            "size": 9166,
            "mimeType": "application/json",
            "text": "[{\"result\":{\"data\":{\"campaigns\":[]}}},{\"result\":{\"data\":{\"active\":[{\"id\":\"1eb7239a-c0bf-47c9-af21-1096d59b1dcb\",\"title\":\"Meera, The Graceful Ager\",\"payload\":{\"cohort_id\":\"AUD_01_FINE_LINES_TRANSITION\",\"cohort_name\":\"The Wrinkle Fighter\",\"persona_tagged_name\":\"Meera, The Graceful Ager\",\"demographic_anchor\":\"Late 30s to mid-40s corporate professional or busy mother noticing early structural skin changes.\",\"core_motivation\":\"I want to soften these fine lines and get my skin's bounce back without spending thousands on painful cosmetic injections.\",\"use_case\":\"Stirring a scoop into her morning lukewarm water or daily green smoothie right before starting her work-from-home routine.\",\"triggering_event\":\"Seeing a high-definition selfie or Zoom recording where her forehead lines and hollow under-eyes looked drastically deeper than she realized.\",\"jobs_to_be_done\":{\"functional\":\"Stimulate natural collagen synthesis to plump up skin and physically diminish deep-set fine lines over a 12-week span.\",\"emotional\":\"Feel confident, youthfully vibrant, and in control of her aging process rather than helpless.\",\"social_identity\":\"To be admired by peers and friends for aging backwards and having a naturally flawless, effortless look.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Solution Aware\",\"awareness_description\":\"She knows collagen supplements exist but hasn't found one she trusts to actually work rather than just passing through her system.\",\"market_sophistication\":\"Level 3\",\"sophistication_description\":\"She has tried cheap collagen pills and generic bovine creams but saw zero improvement in structural wrinkles because they weren't clinically validated or easily absorbed.\",\"required_unique_mechanism\":\"Dermatologist-recommended Hydrolyzed Marine Collagen from deep-sea Korean fish combined with DigeZyme enzymes ensures maximum absorption and targeted skin repair.\"},\"resistance_and_friction\":{\"internal_objection\":\"My metabolism is slower now; is my body even going to absorb this powder, or will it just be an expensive waste?\",\"external_objection\":\"Most marine collagen brands smell horribly fishy and taste metallic despite claiming to be flavored.\",\"partner_objection\":\"Her partner thinks these wellness powders are a marketing gimmick and that she should just use regular moisturizer.\",\"switching_cost\":\"Giving up her current morning collagen gummy routine which is convenient but biologically ineffective.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"elasticity\",\"plump skin\",\"clinically validated\",\"dermatologist-recommended\",\"bouncy skin\",\"marine peptides\"],\"taboo_words\":[\"cheap fix\",\"miracle cure\",\"botox alternative\",\"bovine collagen\",\"synthetic fillers\"]},\"audience_size\":{\"reach_tier\":\"broad\",\"audience_share\":45,\"sizing_rationale\":\"Mainstream working women in their late 30s and 40s actively seeking non-invasive, premium skincare and anti-aging solutions.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-16T11:20:05.185Z\",\"updatedAt\":\"2026-08-16T11:20:14.631Z\"},{\"id\":\"cc53085f-fd3a-42b1-b2a8-e67a01c4f7a3\",\"title\":\"Kriti, The Spotless Glow Seeker\",\"payload\":{\"cohort_id\":\"AUD_02_GLOW_GLUTATHIONE\",\"cohort_name\":\"The Radiance Seeker\",\"persona_tagged_name\":\"Kriti, The Spotless Glow Seeker\",\"demographic_anchor\":\"Mid 20s to early 30s skincare enthusiast dealing with post-acne marks, sun spots, or stubborn hyperpigmentation.\",\"core_motivation\":\"I want to fade these dark spots and even out my patchy skin tone so I don't have to wear heavy concealer every single day.\",\"use_case\":\"Drinking a cold, refreshing glass of Valencia Orange collagen water every morning as an internal booster alongside her topical vitamin C serum.\",\"triggering_event\":\"Waking up, looking in the vanity mirror, and realizing that even with expensive color-correcting primers, her dark spots are still visible through her makeup.\",\"jobs_to_be_done\":{\"functional\":\"Inhibit melanin production and repair the damaged skin barrier to fade hyperpigmentation and brighten skin tone.\",\"emotional\":\"Feel free, clean, and relieved of the constant self-consciousness of having uneven skin patches.\",\"social_identity\":\"To be recognized as someone with effortless, radiant, glass skin who doesn't need heavy makeup to look polished.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Product Aware\",\"awareness_description\":\"She is looking specifically for glutathione and collagen but is skeptical about which brands actually deliver active, bioavailable ingredients.\",\"market_sophistication\":\"Level 4\",\"sophistication_description\":\"She's used countless topical vitamin C serums, niacinamide, and chemical peels, but they only provide temporary surface-level brightness without repairing the root internal barrier.\",\"required_unique_mechanism\":\"The powerful combination of Liposomal L-Glutathione and Resveratrol targets hyperpigmentation internally, while Marine Peptides repair the skin barrier to lock in the glow.\"},\"resistance_and_friction\":{\"internal_objection\":\"My skin is so stubborn; I've tried everything topically and nothing has permanently faded these dark spots.\",\"external_objection\":\"Most glutathione supplements are fake, poorly formulated, or cause stomach irritation.\",\"partner_objection\":\"Her roommate says oral supplements can't target specific spots on the face and are a waste of money.\",\"switching_cost\":\"Stopping her routine of buying multiple expensive spot-treatment serums to commit to a 12-week internal supplement.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"hyperpigmentation\",\"L-Glutathione\",\"even skin tone\",\"dark spots\",\"skin barrier repair\",\"radiance\"],\"taboo_words\":[\"bleaching\",\"whitening\",\"instant clear skin\",\"miracle pill\"]},\"audience_size\":{\"reach_tier\":\"focused\",\"audience_share\":35,\"sizing_rationale\":\"A highly focused, highly motivated demographic of young women and skincare advocates dealing with inflammatory pigmentation and acne scarring.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-16T11:20:05.185Z\",\"updatedAt\":\"2026-08-16T11:20:16.629Z\"},{\"id\":\"99499082-cb02-4da9-819e-fdb95cd1088a\",\"title\":\"Ananya, The Gut-Skin Believer\",\"payload\":{\"cohort_id\":\"AUD_03_GUT_SKIN_PURIST\",\"cohort_name\":\"The Holistic Health Advocate\",\"persona_tagged_name\":\"Ananya, The Gut-Skin Believer\",\"demographic_anchor\":\"Late 20s to late 40s clean-eating enthusiast, yogi, or health-conscious consumer.\",\"core_motivation\":\"I want to heal my dull, reactive skin from the inside out by supporting both my gut microbiome and skin health together.\",\"use_case\":\"Blending the orange-flavored collagen powder into her post-workout wellness bowl or breakfast chia pudding.\",\"triggering_event\":\"Experiencing another flare-up of dull skin and bloating right after a stressful week, realizing her skin health is directly tied to her sluggish digestion.\",\"jobs_to_be_done\":{\"functional\":\"Synthesize high-quality marine collagen while using digestive enzymes (DigeZyme) to optimize nutrient absorption and prevent gut-induced breakouts.\",\"emotional\":\"Feel harmonious, healthy, and deeply nourished, knowing she is putting clean, clinically tested ingredients into her body.\",\"social_identity\":\"To be seen as an intentional, educated wellness advocate who understands holistic, internal-first beauty.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Problem Aware\",\"awareness_description\":\"She realizes her skin issues are tied to internal health and digestion, but isn't sure how to fix both simultaneously with one clean product.\",\"market_sophistication\":\"Level 3\",\"sophistication_description\":\"She has tried drinking bone broth or standard collagen powders but hates how heavy they feel on her stomach, often causing bloating or digestive discomfort.\",\"required_unique_mechanism\":\"DigeZyme digestive enzymes specifically break down the premium Marine Collagen peptides, preventing heavy stomach bloating and ensuring maximum gut-skin absorption.\"},\"resistance_and_friction\":{\"internal_objection\":\"Will this break me out or bloat my stomach like other heavy protein or collagen powders do?\",\"external_objection\":\"Is this clean? I don't want artificial colors, heavy metals, or synthetic additives in my daily wellness routine.\",\"partner_objection\":\"Her partner or family members roll their eyes at yet another superfood powder cluttering the kitchen pantry.\",\"switching_cost\":\"Paying a premium for high-quality marine collagen instead of cheaper, heavy bovine options.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"inside-out glow\",\"DigeZyme\",\"heavy metal tested\",\"digestive enzymes\",\"non-GMO\",\"clean nutrition\"],\"taboo_words\":[\"synthetic\",\"artificial flavors\",\"weight loss drink\",\"chemical peeling\"]},\"audience_size\":{\"reach_tier\":\"focused\",\"audience_share\":20,\"sizing_rationale\":\"A growing, highly dedicated segment of holistic health and wellness consumers who connect gut health directly with outer beauty.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-16T11:20:05.185Z\",\"updatedAt\":\"2026-08-16T11:20:18.554Z\"}],\"recommended\":[],\"recommendationGeneration\":{\"status\":\"ready\",\"triggerRunId\":\"run_06g0kj3a4k2vkesee56p9o6901\",\"startedAt\":\"2026-08-16T11:19:37.147Z\",\"completedAt\":\"2026-08-16T11:20:07.224Z\",\"error\":null}}}}]"
