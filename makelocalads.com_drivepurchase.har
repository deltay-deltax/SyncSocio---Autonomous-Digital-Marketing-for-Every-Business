            "text": "[{\"result\":{\"data\":{\"items\":[{\"id\":\"ad958d4e-649a-471f-b3f6-b3e1c8329fe5\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"offeringId\":\"1f01ff08-2a8e-4682-b1ec-0e6f86abae97\",\"strategyRunId\":null,\"generationJobId\":\"cfd7da6b-432e-4c8a-bbc1-f9e79aa4d159\",\"triggerRunId\":null,\"audienceNodeId\":null,\"angleNodeId\":null,\"campaignId\":\"1fc2c9d7-55ee-4f77-9440-4676c4b627e3\",\"adAudienceId\":null,\"campaignAngleId\":null,\"promptRecipeId\":null,\"currentVersionId\":\"e08dc3f0-b2d2-48c4-b43a-93c2b9c5c42b\",\"storageKey\":null,\"assetUrl\":null,\"thumbnailUrl\":null,\"mimeType\":null,\"width\":null,\"height\":null,\"finalImagePrompt\":null,\"status\":\"pending\",\"downloadCount\":0,\"metadata\":{\"sourceNodeId\":\"campaign-1fc2c9d7-55ee-4f77-9440-4676c4b627e3-0\",\"sourceNodeTitle\":\"Campaign creative 1\"},\"performanceLabels\":{},\"createdAt\":\"2026-08-16T09:27:09.599Z\",\"versions\":[{\"id\":\"e08dc3f0-b2d2-48c4-b43a-93c2b9c5c42b\",\"creativeId\":\"ad958d4e-649a-471f-b3f6-b3e1c8329fe5\",\"versionNumber\":1,\"parentVersionId\":null,\"generationJobId\":\"cfd7da6b-432e-4c8a-bbc1-f9e79aa4d159\",\"triggerRunId\":null,\"changeType\":\"initial\",\"instructions\":null,\"finalImagePrompt\":null,\"status\":\"pending\",\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"metadata\":{\"sourceNodeId\":\"campaign-1fc2c9d7-55ee-4f77-9440-4676c4b627e3-0\",\"sourceNodeTitle\":\"Campaign creative 1\"},\"createdAt\":\"2026-08-16T09:27:09.599Z\",\"variations\":[{\"id\":\"05791c32-2d72-4a6c-9638-faa92335d8dd\",\"creativeVersionId\":\"e08dc3f0-b2d2-48c4-b43a-93c2b9c5c42b\",\"variationType\":\"size\",\"variationKey\":\"original\",\"width\":null,\"height\":null,\"aspectRatio\":null,\"platform\":null,\"isPrimary\":true,\"storageKey\":null,\"assetUrl\":null,\"thumbnailUrl\":null,\"mimeType\":null,\"downloadCount\":0,\"status\":\"pending\",\"metadata\":{},\"createdAt\":\"2026-08-16T09:27:09.599Z\"}]}],\"offeringKind\":\"physical\",\"offeringProdu