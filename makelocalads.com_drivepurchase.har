generationJobId\":\"cfd7da6b-432e-4c8a-bbc1-f9e79aa4d159\",\"triggerRunId\":null,\"changeType\":\"initial\",\"instructions\":null,\"finalImagePrompt\":null,\"status\":\"pending\",\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"metadata\":{\"sourceNodeId\":\"campaign-1fc2c9d7-55ee-4f77-9440-4676c4b627e3-2\",\"sourceNodeTitle\":\"Campaign creative 3\"},\"createdAt\":\"2026-08-16T09:27:09.599Z\",\"variations\":[{\"id\":\"99928dbf-296d-4494-94b6-e56719b347cd\",\"creativeVersionId\":\"ab495d6f-14dc-4ae5-9046-51a079ab8486\",\"variationType\":\"size\",\"variationKey\":\"original\",\"width\":null,\"height\":null,\"aspectRatio\":null,\"platform\":null,\"isPrimary\":true,\"storageKey\":null,\"assetUrl\":null,\"thumbnailUrl\":null,\"mimeType\":null,\"downloadCount\":0,\"status\":\"pending\",\"metadata\":{},\"createdAt\":\"2026-08-16T09:27:09.599Z\"}]}],\"offeringKind\":\"physical\",\"offeringProductImageUrls\":[\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376888-e87e6e1e-6c79-4061-b93d-c265425372ce.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376966-252b01fb-1499-4326-a728-9daa4490b000.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377080-e02244da-7c85-4dc2-915b-83161fd67597.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376988-9e4dee17-9b97-40b1-8e6f-10e6023f69aa.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377051-a19c3471-af94-480a-8284-ea7a43969e60.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377062-22c9b7bf-a210-4965-ba45-c4bee588a7be.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377068-5e979424-e2f5-4909-9306-1290ac13c030.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377073-4bf2a4e0-3791-4c9c-a327-53d05c1eea5a.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376997-2645b52a-e4cf-43d8-96e3-399739e2e9cf.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377057-1f840576-f687-43ee-93f1-21effdaea046.jpg\"],\"currentVersion\":{\"id\":\"ab495d6f-14dc-4ae5-9046-51a079ab8486\",\"creativeId\":\"3571f692-ddb0-4d7b-9f62-656662c74b75\",\"versionNumber\":1,\"parentVersionId\":null,\"generationJobId\":\"cfd7da6b-432e-4c8a-bbc1-f9e79aa4d159\",\"triggerRunId\":null,\"changeType\":\"initial\",\"instructions\":null,\"finalImagePrompt\":null,\"status\":\"pending\",\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"metadata\":{\"sourceNodeId\":\"campaign-1fc2c9d7-55ee-4f77-9440-4676c4b627e3-2\",\"sourceNodeTitle\":\"Campaign creative 3\"},\"createdAt\":\"2026-08-16T09:27:09.599Z\",\"variations\":[{\"id\":\"99928dbf-296d-4494-94b6-e56719b347cd\",\"creativeVersionId\":\"ab495d6f-14dc-4ae5-9046-51a079ab8486\",\"variationType\":\"size\",\"variationKey\":\"original\",\"width\":null,\"height\":null,\"aspectRatio\":null,\"platform\":null,\"isPrimary\":true,\"storageKey\":null,\"assetUrl\":null,\"thumbnailUrl\":null,\"mimeType\":null,\"downloadCount\":0,\"status\":\"pending\",\"metadata\":{},\"createdAt\":\"2026-08-16T09:27:09.599Z\"}]},\"displayVariation\":{\"id\":\"99928dbf-296d-4494-94b6-e56719b347cd\",\"creativeVersionId\":\"ab495d6f-14dc-4ae5-9046-51a079ab8486\",\"variationType\":\"size\",\"variationKey\":\"original\",\"width\":null,\"height\":null,\"aspectRatio\":null,\"platform\":null,\"isPrimary\":true,\"storageKey\":null,\"assetUrl\":null,\"thumbnailUrl\":null,\"mimeType\":null,\"downloadCount\":0,\"status\":\"pending\",\"metadata\":{},\"createdAt\":\"2026-08-16T09:27:09.599Z\"},\"viewerFeedback\":null},{\"id\":\"34a7770c-6d21-4cec-ac15-16bc4200fb1a\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"offeringId\":\"1f01ff08-2a8e-4682-b1ec-0e6f86abae97\",\"strategyRunId\":null,\"generationJobId\":\"cfd7da6b-432e-4c8a-bbc1-f9e79aa4d159\",\"triggerRunId\":null,\"audienceNodeId\":null,\"angleNodeId\":null,\"campaignId\":\"1fc2c9d7-55ee-4f77-9440-4676c4b627e3\",\"adAudienceId\":null,\"campaignAngleId\":null,\"promptRecipeId\":null,\"currentVersionId\":\"226b80d0-39af-4597-a42a-eb59752c66ee\",\"storageKey\":null,\"assetUrl\":null,\"thumbnailUrl\":null,\"mimeType\":null,\"width\":null,\"height\":null,\"finalImagePrompt\":null,\"status\":\"generating\",\"downloadCount\":0,\"metadata\":{\"sourceNodeId\":\"campaign-1fc2c9d7-55ee-4f77-9440-4676c4b627e3-1\",\"sourceNodeTitle\":\"Campaign creative 2\",\"brief\":\"Using the Side-by-Side Comparison framework, this ad targets consumers tired of swallowing bulky sleep pills or chewing sugary gummies by highlighting the superior delivery system. The visual hero is the innovative oral thin strip format itself. Set against a warm Sand Beige (#F4EBE1) background, the ad features a clean, high-fashion comparison grid: on the left, a crossed-out, clinical-looking pile of chalky white pills labeled \\\"Bulky & Slow,\\\" and on the right, a vibrant shot of the pocket-sized blue-and-white Melts container with a semi-translucent caramel-brown strip labeled \\\"Fast-Acting & Zero Sugar.\\\" The short on-image headline is \\\"Ditch the Pills. Melt Into Sleep.\\\" To drive immediate purchase action, the ad prominently displays a \\\"Save 20% Today\\\" first-purchase discount to remove price friction. The single call to action is a high-contrast, linear gradient button (#ff9000 to #ff5000) with a zero-border-radius reading \\\"Claim 20% Off\\\". Maintain brand integrity by rendering the headline in Circular Std, utilizing a subtle grid overlay with 0.1 opacity for a premium feel, and keeping the visual style airy, clean, and highly sophisticated.\",\"prompt\":\"Instructions by the director: Using the Side-by-Side Comparison framework, this ad targets consumers tired of swallowing bulky sleep pills or chewing sugary gummies by highlighting the superior delivery system. The visual hero is the innovative oral thin strip format itself. Set against a warm Sand Beige (#F4EBE1) background, the ad features a clean, high-fashion comparison grid: on the left, a crossed-out, clinical-looking pile of chalky white pills labeled \\\"Bulky & Slow,\\\" and on the right, a vibrant shot of the pocket-sized blue-and-white Melts container with a semi-translucent caramel-brown strip labeled \\\"Fast-Acting & Zero Sugar.\\\" The short on-image headline is \\\"Ditch the Pills. Melt Into Sleep.\\\" To drive immediate purchase action, the ad prominently displays a \\\"Save 20% Today\\\" first-purchase discount to remove price friction. The single call to action is a high-contrast, linear gradient button (#ff9000 to #ff5000) with a zero-border-radius reading \\\"Claim 20% Off\\\". Maintain brand integrity by rendering the headline in Circular Std, utilizing a subtle grid overlay with 0.1 opacity for a premium feel, and keeping the visual style airy, clean, and highly sophisticated.\\n\\nProduct appearance: This product consists of a pocket-sized, vertically oriented rectangular container with highly rounded corners containing individual, ultra-thin oral dissolving strips. The flat-fronted container features a dual-toned color scheme where the upper half is a solid medium blue and the lower half is solid white, divided by a soft, wavy light-blue gradient band. In the upper-left corner of the container's front is a white circular logo featuring the text \\\"WELLBEING NUTRITION\\\" wrapped around a stylized central \\\"W,\\\" while the top right displays the text \\\"30 Oral Thin Strips\\\" next to a small, white peeled-strip icon. Centered in the blue upper section is a graphic of a white crescent moon partially behind a dark blue cloud, accented by small white stars. Below this, the product name \\\"melts® into a restful sleep\\\" is printed in white, with the words \\\"restful\\\" and \\\"sleep\\\" encased in two separate, dark-blue rectangular blocks. The lower white section displays the blue text \\\"Melatonin - 10mg\\\" above a short black-text product description, followed by \\\"Lemon Honey Flavour\\\" next to a small yellow and blue lemon icon, \\\"NUTRACEUTICAL FOR ADULTS\\\" in small black capitals at the bottom left, and a small green square vegetarian symbol at the bottom right. A circular silver \\\"Advanced Molecular Science\\\" seal with a stylized atom graphic sits along the right edge of the container, bridging the blue-and-white color transition. The corresponding oral thin strip is a flexible, semi-translucent, rectangular film with a uniform caramel-brown hue, slightly rounded corners, and a matte texture.\\n\\nUse the product appearance text only as a private visual reference for accurately drawing the product. Do not print, quote, paraphrase, label, or turn any of that description into ad copy. Treat orientation-specific details carefully: show front-only details only when the product front is visible; if the brief shows the back, side, top, or an angled view where those details would not be visible, omit them instead of moving them onto the wrong face.\\n\\nThe attached product photos show the real product — reproduce it faithfully.\\n\\nDesign requirements (apply to this ad):\\n- Follow the instructions by the director.\\n- Make the ad design, layout, typography on-branded, but should look premium, editorial-like.\\n- Establish a clear visual hierarchy: one dominant focal point the eye lands on\\n  first, then the supporting message, then the CTA.\\n- Keep strong figure/ground contrast. If text sits over imagery, place a scrim or\\n  overlay behind it so it stays fully legible.\\n- Place the focal subject on a rule-of-thirds line; leave generous whitespace and\\n  avoid clutter.\\n- Use a limited palette anchored to the brand colors (~60-30-10), reserving one\\n  accent color for the call to action.\\n- Keep 20% space all around the creative for the ad to look cleaner\\n- Group and align elements cleanly (Gestalt); use at most two type styles.\",\"source\":\"campaign-creatives\",\"language\":\"English\",\"lastError\":null,\"hasNSFWRisk\":false,\"brandLogoUrl\":null,\"imageProvider\":\"openai\",\"productImageUrls\":[\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376888-e87e6e1e-6c79-4061-b93d-c265425372ce.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376966-252b01fb-1499-4326-a728-9daa4490b000.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377080-e02244da-7c85-4dc2-915b-83161fd67597.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376988-9e4dee17-9b97-40b1-8e6f-10e6023f69aa.jpg\"],\"visualDescription\":\"This product consists of a pocket-sized, vertically oriented rectangular container with highly rounded corners containing individual, ultra-thin oral dissolving strips. The flat-fronted container features a dual-toned color scheme where the upper half is a solid medium blue and the lower half is solid white, divided by a soft, wavy light-blue gradient band. In the upper-left corner of the container's front is a white circular logo featuring the text \\\"WELLBEING NUTRITION\\\" wrapped around a stylized central \\\"W,\\\" while the top right displays the text \\\"30 Oral Thin Strips\\\" next to a small, white peeled-strip icon. Centered in the blue upper section is a graphic of a white crescent moon partially behind a dark blue cloud, accented by small white stars. Below this, the product name \\\"melts® into a restful sleep\\\" is printed in white, with the words \\\"restful\\\" and \\\"sleep\\\" encased in two separate, dark-blue rectangular blocks. The lower white section displays the blue text \\\"Melatonin - 10mg\\\" above a short black-text product description, followed by \\\"Lemon Honey Flavour\\\" next to a small yellow and blue lemon icon, \\\"NUTRACEUTICAL FOR ADULTS\\\" in small black capitals at the bottom left, and a small green square vegetarian symbol at the bottom right. A circular silver \\\"Advanced Molecular Science\\\" seal with a stylized atom graphic sits along the right edge of the container, bridging the blue-and-white color transition. The corresponding oral thin strip is a flexible, semi-translucent, rectangular film with a uniform caramel-brown hue, slightly rounded corners, and a matte texture.\",\"referenceImageUrls\":[\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376888-e87e6e1e-6c79-4061-b93d-c265425372ce.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376966-252b01fb-1499-4326-a728-9daa4490b000.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377080-e02244da-7c85-4dc2-915b-83161fd67597.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376988-9e4dee17-9b97-40b1-8e6f-10e6023f69aa.jpg\"],\"referenceAdImageUrls\":[],\"originalReferenceImageUrls\":[\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376888-e87e6e1e-6c79-4061-b93d-c265425372ce.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376966-252b01fb-1499-4326-a728-9daa4490b000.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872377080-e02244da-7c85-4dc2-915b-83161fd67597.jpg\",\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376988-9e4dee17-9b97-40b1-8e6f-10e6023f69aa.jpg\"]},\"performanceLabels\":{},\"createdAt\":\"2026-08-16T09:27:09.599Z\",\"versions\":[{\"id\":\"226b80d0-39af-4597-a42a-eb59752c66ee\",\"creativeId\":\"34a7770c-6d21-4cec-ac15-16bc4200fb1a\",\"ve