          "content": {
            "size": 307381,
            "mimeType": "application/json",
            "text": "[{\"result\":{\"data\":[{\"id\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"name\":\"WellBeing\",\"slug\":\"wellbeing\",\"websiteUrl\":\"https://wellbeingnutrition.com/\",\"brandProfile\":{\"logoStatus\":\"missing\",\"sellingCountries\":[]},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T18:18:13.918Z\",\"updatedAt\":\"2026-08-15T18:18:56.317Z\"},{\"id\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"name\":\"Snique\",\"slug\":\"snique\",\"websiteUrl\":\"https://snique.in/\",\"brandProfile\":{\"logoUrl\":\"https://localads.t3.storage.dev/brand-logos/78371df6-ec93-4a25-abd7-c7eaeff1f406/76f7727e-de2d-47fb-bc9c-c4417db4975c.png\",\"logoStatus\":\"ready\",\"logoSourceUrl\":\"https://snique.in/cdn/shop/files/snique-header-logo.svg?v=1767779351&width=600\",\"sellingCountries\":[\"IN\"]},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-15T17:49:53.829Z\",\"updatedAt\":\"2026-08-15T17:50:26.875Z\"}]}},{\"result\":{\"data\":{\"active\":true,\"state\":\"starter\",\"hadPriorSubscription\":true,\"isOrgOwner\":true,\"limits\":{\"maxBrands\":3,\"maxOfferings\":10,\"canGenerate\":\"credits\",\"creativesPerAngle\":null,\"locked\":[],\"credits\":150},\"plan\":{\"slug\":\"starter\",\"label\":\"Starter\",\"creditsPerCycle\":150,\"currentPeriodEnd\":\"2026-08-22T16:50:08.915Z\",\"status\":\"active\",\"trialEndsAt\":\"2026-08-22T16:50:08.915Z\",\"isTrialing\":true,\"cancelAtPeriodEnd\":false,\"isManual\":false},\"plans\":{\"starter\":{\"slug\":\"starter\",\"label\":\"Starter\",\"credits\":150,\"usd\":49,\"maxBrands\":3,\"maxOfferings\":10},\"pro\":{\"slug\":\"pro\",\"label\":\"Pro\",\"credits\":400,\"usd\":99,\"maxBrands\":10,\"maxOfferings\":50}}}}},{\"result\":{\"data\":[{\"id\":\"fa4f28c5-dd6a-4c25-be14-c3a0589d3718\",\"name\":\"Wellbeing Nutrition Liposomal Iron Complex\",\"status\":\"active\",\"thumbnail\":\"https://localads.t3.storage.dev/product-images/fa4f28c5-dd6a-4c25-be14-c3a0589d3718/1786878248627-a50155d2-9f64-4ee2-bd51-a0d8ce4ac638.jpg\",\"createdAt\":\"2026-08-16T11:03:23.895Z\"},{\"id\":\"e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b\",\"name\":\"Himalayan Sea Buckthorn Juice with Curcumin Extract\",\"status\":\"draft\",\"thumbnail\":\"https://localads.t3.storage.dev/product-images/e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b/1786878125375-a3128625-4d10-4029-ac8c-fba01db35e4c.jpg\",\"createdAt\":\"2026-08-16T11:01:01.020Z\"},{\"id\":\"627c6737-700d-4a82-9631-44ba1269f85b\",\"name\":\"Wellbeing Nutrition 4x Strength Omega 3 Fish Oil\",\"status\":\"active\",\"thumbnail\":\"https://localads.t3.storage.dev/product-images/627c6737-700d-4a82-9631-44ba1269f85b/1786875513424-05e46a2b-396c-457f-b015-3659043b1d39.jpg\",\"createdAt\":\"2026-08-16T10:17:48.258Z\"},{\"id\":\"1f01ff08-2a8e-4682-b1ec-0e6f86abae97\",\"name\":\"Wellbeing Nutrition Restful Sleep Melts (10mg)\",\"status\":\"active\",\"thumbnail\":\"https://localads.t3.storage.dev/product-images/1f01ff08-2a8e-4682-b1ec-0e6f86abae97/1786872376888-e87e6e1e-6c79-4061-b93d-c265425372ce.jpg\",\"createdAt\":\"2026-08-16T09:25:39.433Z\"},{\"id\":\"a283cc61-8138-4e74-8189-32554920ab0b\",\"name\":\"Wellbeing Nutrition Raw Whey Protein Isolate (Unflavoured)\",\"status\":\"active\",\"thumbnail\":\"https://localads.t3.storage.dev/product-images/a283cc61-8138-4e74-8189-32554920ab0b/1786870549944-a985ed83-af31-4505-9597-2040e34b2d43.jpg\",\"createdAt\":\"2026-08-16T08:55:11.678Z\"}]}},{\"result\":{\"data\":{\"unlocked\":true,\"linkToken\":\"e5d84efcb5321ded4850b2519f4a09c069def32729beeb26\",\"rewards\":[],\"linkUrl\":\"https://makelocalads.com/r/e5d84efcb5321ded4850b2519f4a09c069def32729beeb26\"}}},{\"result\":{\"data\":{\"summary\":{\"availableCredits\":87,\"allottedCredits\":150,\"usedCredits\":63,\"manualAllotted\":0,\"subscriptionAllotted\":150,\"cycleUsedCredits\":63},\"allotments\":[{\"id\":\"66d8a1e3-21e8-4d0e-af3e-1d1a60db572b\",\"creditDelta\":150,\"description\":\"Starter plan: 150 credits\",\"createdAt\":\"2026-08-15T16:50:15.279Z\"}],\"dailyUsage\":[{\"date\":\"2026-08-15\",\"credits\":33},{\"date\":\"2026-08-16\",\"credits\":30}]}}},{\"result\":{\"data\":{\"designGuide\":\"# Brand Design Guide: Wellbeing Nutrition\\n\\nThis document serves as the primary visual reference for ad creative designers working on Wellbeing Nutrition. Our brand balances scientific precision with organic wellness, utilizing a sophisticated palette of soft pastels and high-energy accents.\\n\\n---\\n\\n## 1. Typography\\n\\nSince you may not have these fonts installed, please use the descriptions below to find appropriate substitutes or to replicate the \\\"vibe.\\\"\\n\\n### **Primary Headings: Circular Std**\\n*   **Description:** A modern, geometric sans-serif that feels both premium and friendly. It is clean, legible, and has a slightly \\\"circular\\\" feel to the characters.\\n*   **Usage:** Main headlines, product names, and primary call-outs.\\n*   **Weight:** Medium (500).\\n\\n### **Editorial/Elegant Accents: Tenor Sans**\\n*   **Description:** A humanist sans-serif with a strong \\\"serif-like\\\" elegance. It has varied stroke widths that give it a high-end, editorial, or \\\"Vogue\\\" look.\\n*   **Usage:** Subheadings or \\\"lifestyle\\\" quotes to add a touch of luxury.\\n\\n### **Secondary Sans/Body: Outfit**\\n*   **Description:** A clean, modern sans-serif with a wide range of weights. It is highly legible and feels \\\"tech-forward\\\" and clinical.\\n*   **Usage:** Supporting copy, bullet points, and nutritional facts.\\n*   **Weights:** Light (300) for body; Bold (600) for emphasis.\\n\\n---\\n\\n## 2. Color Palette\\n\\nOur color strategy uses \\\"Wellness Neutrals\\\" for backgrounds and \\\"Action Oranges\\\" for movement and conversion.\\n\\n### **Core Action Colors**\\n*   **Primary Brand Orange:** `#ff5000` (A vibrant, high-energy reddish-orange).\\n*   **Secondary Warm Orange:** `#ff9000` (A sunny, citrus orange).\\n*   **The Action Gradient:** A linear gradient from `#ff9000` to `#ff5000` (at 90 degrees). Use this for high-impact CTAs.\\n\\n### **Background & Section Neutrals**\\n*   **Wellness Cream:** `#fff9eb` (Soft, off-white background that feels more natural than pure white).\\n*   **Sand Beige:** `#F4EBE1` (A warm, earthy neutral).\\n*   **Soft Lavender/Pink:** `#FBE7F2` (Used for \\\"Glow\\\" or skin-related messaging).\\n*   **Mist Gray:** `#f2f4f7` (Clean, clinical background for scientific sections).\\n\\n### **Functional Accents**\\n*   **Organic Green:** `#62d957` (Vibrant green used to signal \\\"Natural,\\\" \\\"Vegan,\\\" or \\\"Health\\\").\\n*   **Premium Black:** `#000000` (Used for sharp, high-contrast text and \\\"Shop Now\\\" buttons).\\n*   **Pure White:** `#ffffff` (Used for card overlays and high-readability areas).\\n\\n---\\n\\n## 3. Visual Language & UI Elements\\n\\n### **Buttons & Shapes**\\n*   **Sharp & Modern:** The brand often uses a `buttonRadius: 0` for a sharp, high-fashion look on primary site elements. \\n*   **Pill-Shaped Accents:** For \\\"Suggested\\\" items or tag-like UI elements, use a fully rounded \\\"pill\\\" radius (999px).\\n*   **Iconography:** Use a \\\"Miter\\\" linecap for icons with a stroke weight of `2px`. This keeps icons looking sharp and precise.\\n\\n### **Layout Style**\\n*   **Overlay Opacity:** When placing text over images, use a light grid overlay with an opacity of approximately `0.1`.\\n*   **Gradients:** Use soft, diagonal linear gradients (e.g., `#ffffff` to `#f7f7f7`) to create depth in \\\"placeholder\\\" or background areas without making them look busy.\\n\\n---\\n\\n## 4. Imagery Direction\\n*   **Lifestyle:** Images should feel bright, airy, and grounded in daily life (morning routines, desks, gym bags).\\n*   **Product:** High-resolution renders or photography focusing on the transparency of the product (e.g., the \\\"Melts\\\" strips or effervescent tablets in water).\\n*   **Texture:** Incorporate the ingredients (greens, citrus, botanical elements) to emphasize the \\\"Wellbeing\\\" aspect.\\n\\n---\\n\\n## Note to Designers\\n\\nThis `design.md` file is a guide to ensure brand consistency; it is **not** a rigid checklist of every element that must be present in every ad. \\n\\n*   **Context over Rules:** If this guide mentions a specific color (like the Soft Lavender) or a font weight, only use it if it fits the specific ad direction (e.g., use the Lavender/Pink palette for \\\"Skin/Glow\\\" products, but perhaps stick to the Oranges and Greens for \\\"Energy\\\" or \\\"Daily Greens\\\" products).\\n*   **Creativity:** Use the color hex codes and font descriptions to build a creative \\\"world\\\" that feels like Wellbeing Nutrition, even if you are experimenting with new layouts or motions.\\n*   **Hierarchy:** Always prioritize the \\\"Core Action Colors\\\" for your Call to Action (CTA) to ensure they stand out against the softer background neutrals.\",\"sourceJobId\":\"77b55d8e-f509-4cc9-bb31-3b71678b594f\",\"referenceAdDesignImages\":[]}}},{\"result\":{\"data\":{\"unreadCount\":0,\"preferences\":{\"emailEnabled\":true},\"items\":[{\"id\":\"ece332a2-36d8-47b6-be1e-a3a34ffe060c\",\"type\":\"design_guide_ready\",\"title\":\"WellBeing is ready\",\"body\":\"Your brand is created and its design guide is set up. Review it, append your own suggestions, or remove anything that doesn't fit.\",\"href\":\"/app/guide?brandId=4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"severity\":\"success\",\"metadata\":{\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"jobStatus\":\"completed\",\"urlSnapshotJobId\":\"77b55d8e-f509-4cc9-bb31-3b71678b594f\"},\"readAt\":\"2026-08-15T18:24:17.566Z\",\"emailedAt\":null,\"createdAt\":\"2026-08-15T18:19:12.117Z\"},{\"id\":\"7eaa2110-48da-4295-a09c-b9511d679e8e\",\"type\":\"design_guide_ready\",\"title\":\"Snique is ready\",\"body\":\"Your brand is created and its design guide is set up. Review it, append your own suggestions, or remove anything that doesn't fit.\",\"href\":\"/app/guide?brandId=78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"severity\":\"success\",\"metadata\":{\"brandId\":\"78371df6-ec93-4a25-abd7-c7eaeff1f406\",\"jobStatus\":\"completed\",\"urlSnapshotJobId\":\"585a0bd1-989a-4fac-b835-97c4b66b67a5\"},\"readAt\":\"2026-08-15T17:55:06.764Z\",\"emailedAt\":null,\"createdAt\":\"2026-08-15T17:50:43.451Z\"},{\"id\":\"d58cf93b-4958-4126-8ac4-7a1d36dbd0c9\",\"type\":\"design_guide_ready\",\"title\":\"EssenRoots is ready\",\"body\":\"Your brand is created and its design guide is set up. Review it, append your own suggestions, or remove anything that doesn't fit.\",\"href\":\"/app/guide?brandId=32fa1d3d-9b2a-43e0-a393-7a3e95511f54\",\"severity\":\"success\",\"metadata\":{\"brandId\":\"32fa1d3d-9b2a-43e0-a393-7a3e95511f54\",\"jobStatus\":\"completed\",\"urlSnapshotJobId\":\"2663a276-57cb-4818-a78c-a406efc0f353\"},\"readAt\":\"2026-08-15T17:04:15.339Z\",\"emailedAt\":null,\"createdAt\":\"2026-08-15T16:49:01.706Z\"}]}}},{\"result\":{\"data\":{\"entries\":[],\"latestSeq\":0}}},{\"result\":{\"data\":[{\"id\":\"fa4f28c5-dd6a-4c25-be14-c3a0589d3718\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Wellbeing Nutrition Liposomal Iron Complex\",\"slug\":\"untitled-product-10\",\"sourceUrl\":\"https://wellbeingnutrition.com/products/liposomal-iron-complex-pack-of-60-capsules?variant=42680855920720\",\"status\":\"active\",\"ingestionTriggerRunId\":\"run_06g0kfcq89e6ujgnl1t8j2kg01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":\"ready\",\"visualDescriptionTriggerRunId\":\"run_06g0kfpa8vq1vb6o7p329jrn01\",\"visualDescriptionImageFingerprint\":\"zjhlf7\",\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"Wellbeing Nutrition\",\"images\":[\"https://localads.t3.storage.dev/product-images/fa4f28c5-dd6a-4c25-be14-c3a0589d3718/1786878248627-a50155d2-9f64-4ee2-bd51-a0d8ce4ac638.jpg\"],\"benefits\":[\"Supports formation of red blood cells\",\"Helps enhance energy levels and reduces fatigue\",\"Helps replenish iron reserves\",\"Supports immune function\",\"Aids better focus and mental clarity\",\"Helps improve hair, skin, and nail health\"],\"cofactors\":[\"Vitamin C (as Sodium Ascorbate)\",\"Bioactive Folate (as Quatrefolic®)\",\"Activated Vitamin B6 (as Pyridoxal-5-Phosphate)\",\"Vitamin B5 (as Calcium D Pantothenate)\",\"Methylated Vitamin B12 (as Methylcobalamin)\",\"Zinc (as Zinc Bisglycinate)\"],\"shelfLife\":\"18 Months\",\"hasNSFWRisk\":false,\"ironSources\":[\"Ferrous Bisglycinate\",\"Ferrous Fumarate\"],\"taxonomyTag\":\"product:supplements:iron\",\"elementalIron\":\"29 mg (100% RDA)\",\"variantSummary\":{\"count\":2,\"attributes\":{\"brand\":[\"Wellbeing Nutrition\"],\"shelfLife\":[\"18 Months\"],\"variantKey\":[\"Pack of 1\",\"Pack of 2\"],\"hasNSFWRisk\":[\"false\"],\"taxonomyTag\":[\"product:supplements:iron\"],\"variantLabel\":[\"Pack of 1\",\"Pack of 2\"],\"elementalIron\":[\"29 mg (100% RDA)\"],\"capsulesPerPack\":[\"60\"],\"usageInstructions\":[\"Consume 1 capsule daily before any meal, preferably in the morning. Separate from calcium and magnesium supplements by 2-3 hours.\"],\"formulationQuality\":[\"Non-GMO, oxide-free, filler-free, and free from added sugar, preservatives, and artificial colors or flavors\"],\"absorptionTechnology\":[\"Advanced Liposomal Technology (1.6x higher bioavailability)\"]}},\"capsulesPerPack\":60,\"buying_archetypes\":{\"primaryArchetype\":{\"name\":\"Problem Solver\",\"reason\":\"Customers primarily buy this product to resolve clear physical symptoms associated with iron deficiency, such as constant fatigue, low energy levels, and poor concentration.\"},\"secondaryArchetypes\":[{\"name\":\"Upgrade / Optimization\",\"reason\":\"The product features advanced liposomal technology for 1.6x higher absorption, appealing to existing iron supplement users who want a higher-quality formulation that avoids typical digestive discomfort.\"},{\"name\":\"Routine / Replenishment\",\"reason\":\"As a daily supplement packaged in 60-capsule quantities, it is designed to become a consistent part of the customer's morning routine requiring recurring replenishment.\"}]},\"usageInstructions\":\"Consume 1 capsule daily before any meal, preferably in the morning. Separate from calcium and magnesium supplements by 2-3 hours.\",\"formulationQuality\":\"Non-GMO, oxide-free, filler-free, and free from added sugar, preservatives, and artificial colors or flavors\",\"visual_description\":\"The product consists of a tall, matte-finished cylindrical canister and an accompanying dietary supplement capsule. The canister features a two-tone color-blocked design, with the top third in a vibrant coral-red and the bottom two-thirds in a deep burgundy-maroon. At the top of the coral-red section is a white circular logo reading \\\"WELLBEING NUTRITION\\\" wrapped around a stylized central \\\"W\\\", with a small green-and-white vegetarian symbol to its right. Spanning the color transition is the word \\\"slow\\\" in a large, lowercase, white sans-serif typeface, situated above the stacked white capital text \\\"LIPOSOMAL\\\" and \\\"IRON COMPLEX\\\". Below the text, the maroon section displays an angled graphic of a clear capsule filled with pink micro-pellets, decorated with a small circular \\\"2 SALTS\\\" badge, followed by explanatory white text detailing the ingredients and health benefits. Near the bottom, a physical horizontal seam defines the canister's base, which features two white icons for \\\"SUSTAINED RELEASE\\\" and \\\"2in1 NUTRI-SCIENCE\\\", the quantity \\\"60 N CAPSULES\\\" inside a pill-shaped border, and \\\"HEALTH SUPPLEMENT FOR ADULTS\\\" at the bottom edge. Beside the canister stands a physical, three-dimensional capsule with a completely transparent, glossy outer shell, revealing an interior packed tightly with hundreds of uniform, tiny, spherical micro-pellets in a soft, dusty-pink hue.\",\"absorptionTechnology\":\"Advanced Liposomal Technology (1.6x higher bioavailability)\"},\"normalizedSummary\":{\"summary\":\"An advanced liposomal iron supplement containing 29 mg of Elemental Iron and five synergistic cofactors to support energy, immunity, and red blood cell formation.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-16T11:03:23.895Z\",\"updatedAt\":\"2026-08-16T11:05:23.187Z\",\"variantCount\":2,\"creativeCount\":3,\"generatedCreativeCount\":0,\"hasGeneratedCreatives\":false},{\"id\":\"e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"4e9f804a-3dcc-4a36-b983-35e3f062d84e\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"Himalayan Sea Buckthorn Juice with Curcumin Extract\",\"slug\":\"untitled-product-9\",\"sourceUrl\":\"https://wellbeingnutrition.com/products/himalayan-sea-buckthorn-juice\",\"status\":\"draft\",\"ingestionTriggerRunId\":\"run_06g0kerdqpgicjbt3hv4t7gl01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":null,\"visualDescriptionTriggerRunId\":null,\"visualDescriptionImageFingerprint\":null,\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"Wellbeing Nutrition\",\"usage\":\"Mix 10 ml (2 tsp) in 200 ml of water. Take it twice daily, before meals. Shake well before use.\",\"images\":[\"https://localads.t3.storage.dev/product-images/e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b/1786878125375-a3128625-4d10-4029-ac8c-fba01db35e4c.jpg\",\"https://localads.t3.storage.dev/product-images/e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b/1786878125436-72a0c59e-0182-44eb-b3aa-29ec72373251.jpg\",\"https://localads.t3.storage.dev/product-images/e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b/1786878125376-c19f8ecc-3c6c-4108-b83d-95366020501c.jpg\",\"https://localads.t3.storage.dev/product-images/e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b/1786878125320-f37ac034-b725-4b38-9a9d-0c3911190fd4.jpg\",\"https://localads.t3.storage.dev/product-images/e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b/1786878125379-32ad34ce-1a26-415f-875f-7cad6f727130.jpg\",\"https://localads.t3.storage.dev/product-images/e8dd42f6-778f-4cd2-a8b6-a9cb5e48455b/1786878125443-48c31ff7-e548-4af5-9568-d8a167961501.jpg\"],\"origin\":\"Ladakh, Indian Himalayas (~12,000 ft)\",\"volume\":\"500ml\",\"benefits\":[\"Helps Support Energy & Vitality\",\"Helps Strengthen Immunity\",\"Helps Promote Skin Health\",\"Helps Aid Gut & Digestive Health\",\"Helps Support Liver Function\",\"Help Reduce Oxidative Stress\"],\"features\":[\"Cold Pressed\",\"Unfiltered\",\"Zero Added Sugar\",\"Liquid Pulp Concentrate\",\"Heavy Metal Free\",\"Contaminant Free\",\"Non-GMO\"],\"nutrients\":[\"Vitamin C\",\"Vitamin E\",\"Omega 3\",\"Omega 6\",\"Omega 7\",\"Omega 9\",\"Carotenoids\",\"Polyphenols\",\"Plant sterols\",\"Amino acids\"],\"shelfLife\":\"12 Months\",\"hasNSFWRisk\":false,\"taxonomyTag\":\"product:supplement:juice\",\"keyIngredients\":[\"Sea Buckthorn (Hippophae rhamnoides) Pulp\",\"Curcumin Extract (Curcuma longa)\"],\"variantSummary\":{\"count\":1,\"attributes\":{}},\"fullIngredients\":[\"Sea Buckthorn Pulp\",\"Curcumin Extract\",\"Potassium Sorbate\",\"Sodium Benzoate\",\"Demineralized water\"],\"storageInstructions\":\"Store in a cool, dry, and dark place. Once opened, refrigerate and consume within 60 days.\"},\"normalizedSummary\":{\"summary\":\"A 99% pure cold-pressed, unfiltered liquid pulp concentrate wild-harvested from the Himalayas to support daily energy, immunity, skin health, and digestive wellness.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-16T11:01:01.020Z\",\"updatedAt\":\"2026-08-16T11:02:05.807Z\",\"variantCount\":1,\"creativeCount\":0,\"generatedCreativeCount\":0,\"hasGeneratedCreatives\":false},{\"id\":\"627c6737-700d-4a82-9631-44ba1269f85b\",\"orgId\":\"