fc41c4f9-5a20-4986-b183-3749652cfe38\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"offeringId\":\"9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16\",\"strategyRunId\":null,\"generationJobId\":\"d95862ff-088c-4fa7-994e-3f8b24306c7d\",\"triggerRunId\":\"run_06g0da0m5drb7mknha3du4sp01\",\"audienceNodeId\":null,\"angleNodeId\":null,\"campaignId\":null,\"adAudienceId\":null,\"campaignAngleId\":null,\"promptRecipeId\":null,\"currentVersionId\":\"c6047369-bf80-4083-9e33-dca72be780e1\",\"storageKey\":null,\"assetUrl\":null,\"thumbnailUrl\":null,\"mimeType\":null,\"width\":1024,\"height\":1024,\"finalImagePrompt\":null,\"status\":\"generating\",\"downloadCount\":0,\"metadata\":{\"imageSize\":\"1024x1024\",\"lastError\":null,\"outputSpec\":{\"id\":\"1024x1024-1\",\"label\":\"Square photo 1\",\"width\":1024,\"format\":\"jpg\",\"height\":1024,\"apiSize\":\"1024x1024\",\"promptSuffix\":\"Output size: 1024 x 1024 px, JPG. Compose the image to fit this exact size without stretching or cropping.\"},\"studioType\":\"photoshoot-quick-shoot\",\"attemptCount\":1,\"sourceNodeId\":\"1024x1024-1\",\"creativeCount\":1,\"outputSpecIds\":[\"1024x1024-1\"],\"userDirection\":null,\"sourceNodeTitle\":\"Square photo 1\",\"imageGeneratorId\":\"openai/gpt-image-2\",\"productFocusMode\":\"styled\",\"productImageUrls\":[\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949166-35373943-22c4-47c8-96fa-7ed78d6f2238.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949264-7c225ca7-927f-4ecb-8942-822ddb1a3ee8.png\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949365-64cd17f2-5072-4b7e-87d8-9f9dbe7ed6eb.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949358-27f358d8-f3b1-47fa-9f0d-b08c660466ad.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949374-ab9f5785-b8e0-4849-8fa2-ae07e279452d.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949453-ce143e12-4c16-4a29-b20f-541f81ae035a.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949381-c227ae82-5fb6-427d-ab69-4c262b3854b5.jpg\"],\"moodboardImageUrl\":null,\"moodboardCellIndex\":null,\"moodboardDirection\":null,\"moodboardCellNumber\":null,\"moodboardCreativeId\":null,\"quickShootDirection\":{\"lens\":\"Schneider Kreuznach 80mm LS, shot at approximately 80mm for natural product proportions and premium still-life compression\",\"mood\":\"Fresh, clinical, elevated, aquatic, calm, and aspirational — a daily beauty ritual with premium Korean marine wellness cues.\",\"camera\":\"Phase One XF IQ4 150MP or equivalent high-resolution medium-format studio camera on tripod\",\"lighting\":\"Large diffused key light from upper left through a 4x6 silk for soft beauty highlights on the matte white lid and jar shoulders. Low-intensity cyan bounce from below to echo the label gradient and create gentle aquatic reflections. A narrow gridded rim light from back right catches the lid edge and glassware. Project very soft water-caustic patterns across the background and surface, keeping them subtle enough not to obscure the label.\",\"shotType\":\"Premium styled product still life with ritual props and environmental lighting effects\",\"sceneRole\":\"Communicates the product as a refined daily collagen ritual for hydration, firmness, and beauty optimization, while visually referencing marine purity and clean clinical testing.\",\"setDesign\":\"Minimal luxury wellness set using frosted sea-glass acrylic, translucent aqua resin, pale warm-white ceramic, and a shallow tray with a thin veil of water for subtle reflections. Add a small white ceramic scoop with fine collagen powder beside the jar, a clear tumbler filled with water, a few smooth white pebbles, and a folded ivory linen napkin at the edge of frame. No alternate products, no competing labels, no fish imagery, no text overlays.\",\"shotTitle\":\"Deep-Sea Beauty Ritual\",\"colorGrade\":\"Clean clinical-beauty grade with crisp whites, cyan-teal accents, soft warm skin-toned neutrals in the linen, restrained contrast, lifted shadows, and polished specular control. Retouching should preserve real material texture while removing dust, label warping, and distracting reflections.\",\"composition\":\"Horizontal 4:5 campaign frame with the product placed on the right third, turned nearly straight to camera with a very slight 5-degree angle so the front label remains fully readable. A tall glass of water and white scoop occupy the left foreground, partially cropped, while a translucent aqua glass platform creates a diagonal line from lower left to upper right. Background layers include soft blurred rippled glass and pale marine-toned acrylic panels, creating depth and a premium editorial still-life layout.\",\"cameraDistance\":\"Medium close still-life distance, about 90 cm from product, with the jar filling the right third and environmental details visible around it.\",\"cameraSettings\":\"ISO 50, f/8, 1/125 sec, tethered capture, manual focus stacked lightly if needed to keep the product label sharp while letting foreground glass edges fall slightly soft\",\"promptFragment\":\"Premium commercial product photoshoot of the exact Wellbeing Nutrition Pure Korean Marine Collagen Peptides jar, stout white cylindrical jar with matte white flat screw lid and accurate white-to-cyan teal label, front label fully readable, placed off-center on the right third on a translucent aqua glass slab, clear water tumbler and white ceramic scoop with fine collagen powder in left foreground, smooth white pebbles, ivory linen edge, shallow reflective water tray, frosted sea-glass acrylic background, soft water-caustic reflections, clinical Korean beauty aesthetic, large diffused softbox from upper left, cyan bounce, subtle rim light, medium-format 80mm lens, f/8, crisp premium retouching, clean whites and teal accents, no alternate products, no text overlay, not a catalog packshot\",\"productHandling\":\"Show the exact Pure Korean Marine Collagen Peptides jar from Wellbeing Nutrition only: stout wide-mouth cylindrical white plastic jar, matte white flat screw lid, full-wrap white-to-cyan teal gradient label, black Wellbeing Nutrition logo, teal-blue central panel, large white lowercase serif 'marine collagen' type, Korean text, Type I & III, Unflavored badge, geodesic sphere badge, clinically approved badge, 8g collagen callout, icon row, and 200 g details. Do not redesign, simplify, recolor, relabel, or replace the product. Front label must be clean, undamaged, proportionally accurate, and readable.\",\"twoLineShotIdea\":\"A premium morning beauty ritual frame: the Pure Korean Marine Collagen Peptides jar sits off-center on a translucent aqua glass slab, surrounded by a clear water glass, a white ceramic scoop, and subtle marine textures. Soft water-caustic reflections and clean Korean skincare minimalism make the scene feel clinical, fresh, and sensorial rather than like a catalog product shot.\",\"productFocusMode\":\"styled\",\"subjectPlacement\":\"Product on the right third, slightly forward of the background elements; glass and scoop on the left foreground; translucent slab running diagonally to create movement and depth.\",\"productFrameShare\":\"Approximately 38% of the frame, large enough to read as the hero but balanced with glass, scoop, water texture, and surface design.\",\"whyThisIsNotACatalogPackshot\":\"The product is not centered on a blank background; it is integrated into a designed ritual scene with layered surfaces, foreground props, diagonal composition, water reflections, partial crops, and atmospheric lighting. The jar remains accurate and readable but shares attention with the premium marine-inspired set.\"},\"moodboardCellImageUrl\":null,\"moodboardCellDirection\":null,\"userReferenceImageUrls\":[],\"previousQuickShootIdeas\":[],\"styleReferenceImageUrls\":[],\"quickShootDirectionModel\":\"gpt-5.5\",\"referenceCompositionModel\":\"google/gemini-3.1-flash-lite\",\"quickShootBatchDirectionIndex\":0,\"quickShootBatchDirectionPlanned\":true,\"referenceCompositionDescriptions\":[]},\"performanceLabels\":{},\"createdAt\":\"2026-08-15T18:20:37.750Z\",\"versions\":[{\"id\":\"c6047369-bf80-4083-9e33-dca72be780e1\",\"creativeId\":\"fc41c4f9-5a20-4986-b183-3749652cfe38\",\"versionNumber\":1,\"parentVersionId\":null,\"generationJobId\":\"d95862ff-088c-4fa7-994e-3f8b24306c7d\",\"triggerRunId\":\"run_06g0da0m5drb7mknha3du4sp01\",\"changeType\":\"initial\",\"instructions\":null,\"finalImagePrompt\":null,\"status\":\"generating\",\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"metadata\":{\"imageSize\":\"1024x1024\",\"lastError\":null,\"outputSpec\":{\"id\":\"1024x1024-1\",\"label\":\"Square photo 1\",\"width\":1024,\"format\":\"jpg\",\"height\":1024,\"apiSize\":\"1024x1024\",\"promptSuffix\":\"Output size: 1024 x 1024 px, JPG. Compose the image to fit this exact size without stretching or cropping.\"},\"studioType\":\"photoshoot-quick-shoot\",\"attemptCount\":1,\"sourceNodeId\":\"1024x1024-1\",\"creativeCount\":1,\"outputSpecIds\":[\"1024x1024-1\"],\"userDirection\":null,\"sourceNodeTitle\":\"Square photo 1\",\"imageGeneratorId\":\"openai/gpt-image-2\",\"productFocusMode\":\"styled\",\"productImageUrls\":[\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949166-35373943-22c4-47c8-96fa-7ed78d6f2238.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949264-7c225ca7-927f-4ecb-8942-822ddb1a3ee8.png\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949365-64cd17f2-5072-4b7e-87d8-9f9dbe7ed6eb.jpg\",\"https://localads.t3.storage.dev/product-images/9a7cc4c6-1ff8-4e03-ad8b-6cad2a014b16/1786817949358-27f358d8-f3b1-47fa-9f0d