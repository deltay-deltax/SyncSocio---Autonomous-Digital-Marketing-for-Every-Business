          "content": {
            "size": 3153,
            "mimeType": "application/json",
            "text": "[{\"result\":{\"data\":{\"id\":\"7951625e-9714-42be-b6c6-699474bd7ae6\",\"title\":\"Marcus, the Reforming Soda Junkie\",\"payload\":{\"cohort_id\":\"AUD_01_NOSTALGIC_SODA_LOVER\",\"cohort_name\":\"The Nostalgic Soda Craver\",\"persona_tagged_name\":\"Marcus, the Reforming Soda Junkie\",\"demographic_anchor\":\"Age 28-42, millennial professional, loves snack culture but trying to stay fit\",\"core_motivation\":\"I want the exact fizzy, sweet comfort of the grape soda I drank as a kid, but without the 150 calories of high-fructose corn syrup and the inevitable sugar crash.\",\"use_case\":\"A guilt-free afternoon desk treat to get through the 3 PM workday slump without ruining his diet.\",\"triggering_event\":\"Staring at the office vending machine in the middle of a stressful afternoon, desperately wanting a sweet fizzy soda but walking away empty-handed because of the massive sugar guilt.\",\"jobs_to_be_done\":{\"functional\":\"Provide a sweet, heavily carbonated grape-flavored beverage with minimal sugar and calories.\",\"emotional\":\"Indulge in a comforting, retro treat that evokes childhood happiness without feeling guilty about health choices.\",\"social_identity\":\"Show colleagues that he can manage his fitness goals and stay healthy without boring himself with plain water.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Product Aware\",\"awareness_description\":\"He knows prebiotic sodas exist and has seen OLIPOP, but he hasn't committed to trying the Classic Grape flavor yet because he's skeptical of healthy grape flavor profiles.\",\"market_sophistication\":\"Level 3\",\"sophistication_description\":\"He has tried sugar-free diet sodas with chemical aftertastes (like aspartame) and unsweetened sparkling waters that taste like absolutely nothing, leaving him deeply unsatisfied.\",\"required_unique_mechanism\":\"Real Concord grape juice concentrate blended with a tiny splash of lime and natural stevia leaf to replicate a authentic retro grape soda sweetness with only 5g of total sugar.\"},\"resistance_and_friction\":{\"internal_objection\":\"This won't work for me because healthy alternatives to grape flavor always taste medicinal or watery.\",\"external_objection\":\"This is way too expensive for a soda when I can buy a 12-pack of generic brand soda for the price of two of these cans.\",\"partner_objection\":\"My spouse will tell me we don't need to spend our grocery budget on premium soda when we already have sparkling water at home.\",\"switching_cost\":\"Breaking the cheap, low-effort habit of grabbing regular sodas from the office pantry or local convenience store.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"retro flavor\",\"classic sweet-tart\",\"concord grape\",\"all grown up\",\"nostalgia\",\"guilt-free carbonation\"],\"taboo_words\":[\"diet food\",\"artificial sweetener\",\"aspartame\",\"watery\",\"sacrifice\",\"medicinal\"]},\"audience_size\":{\"reach_tier\":\"broad\",\"audience_share\":45,\"sizing_rationale\":\"Millennials and Gen Z consumers who want to cut back on conventional soft drinks but still seek comfort foods make up the largest target market for healthy soda alternatives.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-17T13:28:10.614Z\",\"updatedAt\":\"2026-08-17T13:28:18.015Z\"}}}]"
          },
