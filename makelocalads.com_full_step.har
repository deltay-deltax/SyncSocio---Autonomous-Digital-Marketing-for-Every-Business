          "cookies": [],
          "content": {
            "size": 3104,
            "mimeType": "application/json",
            "text": "[{\"result\":{\"data\":{\"id\":\"e63fcaf2-27e8-4b88-8a7c-56e63c19cbcc\",\"title\":\"Chloe, the IBS Warrior\",\"payload\":{\"cohort_id\":\"AUD_02_GUT_HEALTH_OPTIMIZER\",\"cohort_name\":\"The Bloat-Free Soda Fan\",\"persona_tagged_name\":\"Chloe, the IBS Warrior\",\"demographic_anchor\":\"Age 23-35, active wellness enthusiast, actively researches gut-health hacks, suffers from chronic bloating\",\"core_motivation\":\"I miss carbonated drinks so much, but standard carbonation and artificial sugars destroy my stomach. I need something bubbly that actually feels good on my digestive system.\",\"use_case\":\"A digestive-boosting accompaniment to her daily lunch or dinner to prevent post-meal bloating.\",\"triggering_event\":\"Experiencing sharp stomach pain and major bloating after drinking a conventional sugar-free soda during lunch, which ruined the rest of her afternoon.\",\"jobs_to_be_done\":{\"functional\":\"Deliver active dietary fiber and gut-supporting prebiotics in a delicious, easy-to-drink canned format.\",\"emotional\":\"Feel relieved, energized, and clean inside rather than weighed down and bloated after having a fizzy beverage.\",\"social_identity\":\"Be recognized by friends and wellness communities as someone who stays ahead of health trends with high-quality functional foods.\"},\"schwartz_psychology\":{\"awareness_stage\":\"Solution Aware\",\"awareness_description\":\"She knows she needs prebiotics and fiber to soothe her stomach, but she doesn't realize she can get them through an actual delicious grape soda instead of boring powders.\",\"market_sophistication\":\"Level 4\",\"sophistication_description\":\"She has tried expensive apple cider vinegar drinks, chalky fiber powders, probiotic supplements, and sour kombuchas, but hates the harsh tastes and wants a clean, simple treat.\",\"required_unique_mechanism\":\"The OLISMART blend of nine diverse plant fibers, including marshmallow root and chicory root inulin, which actively feeds gut microbiomes while maintaining a smooth soda texture.\"},\"resistance_and_friction\":{\"internal_objection\":\"This won't work for me because carbonated canned drinks usually irritate my stomach lining regardless of what's in them.\",\"external_objection\":\"This is probably just a marketing trend; they probably added a tiny speck of fiber and labeled it as a gut health product.\",\"partner_objection\":\"My roommate will drink them all without realizing they are my expensive gut-health remedies.\",\"switching_cost\":\"Replacing her routine of buying premium functional kombuchas or mixing messy fiber prebiotic powders into her morning water.\"},\"lexicon_and_vocabulary\":{\"words_to_use\":[\"prebiotics\",\"digestive health\",\"9g of plant fiber\",\"gut friendly\",\"no bloat\",\"clean ingredients\"],\"taboo_words\":[\"empty calories\",\"syrup\",\"chemical\",\"bloating\",\"sugar bomb\",\"artificial\"]},\"audience_size\":{\"reach_tier\":\"focused\",\"audience_share\":35,\"sizing_rationale\":\"A substantial and fast-growing segment of health-conscious buyers seeking digestive solutions but refusing to compromise on taste.\"}},\"source\":\"generated\",\"status\":\"active\",\"createdAt\":\"2026-08-17T13:28:10.614Z\",\"updatedAt\":\"2026-08-17T13:28:18.638Z\"}}}]"
          },
