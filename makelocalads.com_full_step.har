            "text": "[{\"result\":{\"data\":{\"id\":\"fdfcaad1-1542-44ff-a267-cc38b91f44b8\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"976010ab-a63a-42a0-9e74-a69350a241d3\",\"parentOfferingId\":null,\"offeringType\":\"product\",\"kind\":\"physical\",\"name\":\"OLIPOP Classic Grape\",\"slug\":\"untitled-product-4\",\"sourceUrl\":\"https://drinkolipop.com/products/classic-grape\",\"status\":\"draft\",\"ingestionTriggerRunId\":\"run_06g0vprb5g6p16mpfdq34qqu01\",\"imageIngestionStatus\":\"ready\",\"visualDescriptionStatus\":null,\"visualDescriptionTriggerRunId\":null,\"visualDescriptionImageFingerprint\":null,\"variantKey\":null,\"variantAttributes\":{},\"position\":0,\"productTruth\":{\"brand\":\"OLIPOP\",\"flavor\":\"Classic Grape\",\"images\":[\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261142-5e249136-b15e-4ab1-9afd-e35badfee29d.webp\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261170-1475e9c2-6eb6-4f93-8c91-af15cd43f6b7.png\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261125-fbea94b8-6dae-4bd1-bfdc-3cc997ac0087.webp\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261044-63854194-4bb4-4832-9d59-2885c610a445.webp\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261155-3a07674d-3e62-42a1-a762-e9e180988ed6.png\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261187-fc65f001-76ae-4632-b96e-5941a66fc459.jpg\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261195-22140ea6-c19f-4d0e-8747-e6efc0deca32.png\"],\"sodium\":\"30mg\",\"protein\":\"0g\",\"calories\":50,\"totalFat\":\"0g\",\"addedSugars\":\"1g\",\"description\":\"Sweet-tart concord grape juice, kissed with lime. Made from real concord grape juice with a hint of lime to create the perfect blend of sweet and tart, our Classic Grape is the nostalgic flavor you know and love—all grown up.\",\"hasNSFWRisk\":false,\"ingredients\":[\"Carbonated Water\",\"OLISMART (Cassava Root Fiber, Chicory Root Inulin, Jerusalem Artichoke Inulin, Nopal Cactus*, Marshmallow Root*, Calendula Flower*, Kudzu Root*)\",\"Concord Grape Juice Concentrate\",\"Cassava Root Syrup\",\"Apple Juice Concentrate\",\"Tartaric Acid (From Grapes)\",\"Quince Juice Concentrate\",\"Lime Juice Concentrate\",\"Stevia Leaf*\",\"Himalayan Pink Salt\",\"Natural Flavors\"],\"taxonomyTag\":\"product:beverage:soda\",\"totalSugars\":\"5g\",\"dietaryFiber\":\"9g\",\"dietaryClaims\":[\"Vegan\",\"Gluten Free\",\"Non-GMO\",\"Less Sugar\",\"Digestive Health Support\"],\"nutritionFacts\":\"1 Can (355mL)\",\"variantSummary\":{\"count\":2,\"attributes\":{\"purchaseType\":[\"One Time\",\"Subscription\"]}},\"totalCarbohydrate\":\"16g\",\"nutritionFacts heat\":null,\"storageInstructions\":\"Keep refrigerated\"},\"normalizedSummary\":{\"summary\":\"A prebiotic soda that gives classic grape flavor a modern upgrade, made with real concord grape juice, a hint of lime, and 9g of dietary fiber.\"},\"createdBy\":\"f5dfb377-dac7-46a6-aea3-a4e04cb45e54\",\"createdAt\":\"2026-08-17T13:26:59.440Z\",\"updatedAt\":\"2026-08-17T13:27:41.660Z\",\"parentOffering\":null,\"variants\":[{\"id\":\"70f0d648-c1d2-4410-a50a-c1086f8f53a7\",\"orgId\":\"62f84ee9-c45f-4e41-8868-bcf0bb1ec033\",\"brandId\":\"976010ab-a63a-42a0-9e74-a69350a241d3\",\"parentOfferingId\":\"fdfcaad1-1542-44ff-a267-cc38b91f44b8\",\"offeringType\":\"variant\",\"kind\":\"physical\",\"name\":\"OLIPOP Classic Grape - 12 Pack - One Time\",\"slug\":\"untitled-product-4-purchasetype-one-time\",\"sourceUrl\":\"https://drinkolipop.com/products/classic-grape\",\"status\":\"draft\",\"ingestionTriggerRunId\":null,\"imageIngestionStatus\":null,\"visualDescriptionStatus\":null,\"visualDescriptionTriggerRunId\":null,\"visualDescriptionImageFingerprint\":