          "postData": {
            "mimeType": "application/json",
            "text": "{\"0\":{\"offeringId\":\"fdfcaad1-1542-44ff-a267-cc38b91f44b8\",\"extraction\":{\"name\":\"OLIPOP Classic Grape\",\"kind\":\"physical\",\"summary\":\"A prebiotic soda that gives classic grape flavor a modern upgrade, made with real concord grape juice, a hint of lime, and 9g of dietary fiber.\",\"productTruth\":{\"brand\":\"OLIPOP\",\"flavor\":\"Classic Grape\",\"images\":[\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261142-5e249136-b15e-4ab1-9afd-e35badfee29d.webp\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261170-1475e9c2-6eb6-4f93-8c91-af15cd43f6b7.png\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261125-fbea94b8-6dae-4bd1-bfdc-3cc997ac0087.webp\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261044-63854194-4bb4-4832-9d59-2885c610a445.webp\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261155-3a07674d-3e62-42a1-a762-e9e180988ed6.png\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261187-fc65f001-76ae-4632-b96e-5941a66fc459.jpg\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261195-22140ea6-c19f-4d0e-8747-e6efc0deca32.png\"],\"sodium\":\"30mg\",\"protein\":\"0g\",\"calories\":50,\"totalFat\":\"0g\",\"addedSugars\":\"1g\",\"description\":\"Sweet-tart concord grape juice, kissed with lime. Made from real concord grape juice with a hint of lime to create the perfect blend of sweet and tart, our Classic Grape is the nostalgic flavor you know and love—all grown up.\",\"hasNSFWRisk\":false,\"ingredients\":[\"Carbonated Water\",\"OLISMART (Cassava Root Fiber, Chicory Root Inulin, Jerusalem Artichoke Inulin, Nopal Cactus*, Marshmallow Root*, Calendula Flower*, Kudzu Root*)\",\"Concord Grape Juice Concentrate\",\"Cassava Root Syrup\",\"Apple Juice Concentrate\",\"Tartaric Acid (From Grapes)\",\"Quince Juice Concentrate\",\"Lime Juice Concentrate\",\"Stevia Leaf*\",\"Himalayan Pink Salt\",\"Natural Flavors\"],\"taxonomyTag\":\"product:beverage:soda\",\"totalSugars\":\"5g\",\"dietaryFiber\":\"9g\",\"dietaryClaims\":[\"Vegan\",\"Gluten Free\",\"Non-GMO\",\"Less Sugar\",\"Digestive Health Support\"],\"nutritionFacts\":\"1 Can (355mL)\",\"variantSummary\":{\"count\":2,\"attributes\":{\"purchaseType\":[\"One Time\",\"Subscription\"]}},\"totalCarbohydrate\":\"16g\",\"nutritionFacts heat\":null,\"storageInstructions\":\"Keep refrigerated\"},\"images\":[\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261142-5e249136-b15e-4ab1-9afd-e35badfee29d.webp\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261170-1475e9c2-6eb6-4f93-8c91-af15cd43f6b7.png\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261125-fbea94b8-6dae-4bd1-bfdc-3cc997ac0087.webp\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261044-63854194-4bb4-4832-9d59-2885c610a445.webp\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261155-3a07674d-3e62-42a1-a762-e9e180988ed6.png\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261187-fc65f001-76ae-4632-b96e-5941a66fc459.jpg\",\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261195-22140ea6-c19f-4d0e-8747-e6efc0deca32.png\"],\"variants\":[{\"name\":\"OLIPOP Classic Grape - 12 Pack - One Time\",\"brand\":\"OLIPOP\",\"label\":\"12 Pack - One Time\",\"price\":\"$35.99\",\"flavor\":\"Classic Grape\",\"images\":[\"https://localads.t3.storage.dev/product-images/fdfcaad1-1542-44ff-a267-cc38b91f44b8/1786973261142-5e249136-b15e-4ab1-9afd-e35badfee29d.webp\",\"https://localads.t3.storag